def _safe_unlink(path: Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    except OSError:
        pass


def cleanup_stale_temp_payloads() -> None:
    """Remove payloads left by an interrupted older run.

    Called only after the final Python interpreter is selected and dependencies
    are imported, so it cannot interfere with bootstrap hand-off.
    """
    patterns = (
        "face-color-match-*.jpg",
        "face-color-match-*.png",
        "face-color-match-lut-*.cube",
        "face-color-match-lut-*.icc",
        # Legacy names from v0.7.x are also cleaned.
        "face-color-match-residual-*.cube",
        "face-color-match-residual-*.icc",
        "face-color-match-startup.json.tmp",
        "face-color-match-launch.json.tmp",
    )
    for pattern in patterns:
        try:
            for path in TEMP_DIR.glob(pattern):
                _safe_unlink(path)
        except OSError:
            pass


def cleanup_clean_shutdown_files() -> None:
    """Remove bridge bookkeeping/log files after a normal server shutdown."""
    for path in (
        STARTUP_STATUS_FILE,
        LAUNCH_CONFIG_FILE,
        LOG_FILE,
        STARTUP_STATUS_FILE.with_suffix(STARTUP_STATUS_FILE.suffix + ".tmp"),
        LAUNCH_CONFIG_FILE.with_suffix(LAUNCH_CONFIG_FILE.suffix + ".tmp"),
    ):
        _safe_unlink(path)


_LAST_ACTIVITY = time.monotonic()
_ACTIVITY_LOCK = threading.Lock()
_STOP = threading.Event()
_REPLY_LOCK = threading.Lock()


def _write_log(message: str) -> None:
    try:
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        with LOG_FILE.open("a", encoding="utf-8") as stream:
            stream.write(f"[{stamp}] {message}\n")
    except Exception:
        pass


def log_exception(prefix: str) -> None:
    _write_log(prefix + "\n" + traceback.format_exc())


def atomic_json_write(path: Path, data: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(str(tmp), str(path))


def write_startup_status(status: str, message: str = "", **extra: Any) -> None:
    payload: Dict[str, Any] = {
        "status": status,
        "message": message,
        "version": VERSION,
        "protocol": API_PROTOCOL,
        "python": f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}",
        "log_file": str(LOG_FILE),
        "time": time.time(),
    }
    payload.update(extra)
    try:
        atomic_json_write(STARTUP_STATUS_FILE, payload)
    except Exception:
        pass


def touch_activity() -> None:
    global _LAST_ACTIVITY
    with _ACTIVITY_LOCK:
        _LAST_ACTIVITY = time.monotonic()


def _load_launch_config() -> Dict[str, Any]:
    try:
        data = json.loads(LAUNCH_CONFIG_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _launcher_executable() -> Optional[str]:
    if os.name != "nt":
        return None
    candidates = [
        Path(os.environ.get("WINDIR", r"C:\Windows")) / "pyw.exe",
        Path(os.environ.get("WINDIR", r"C:\Windows")) / "py.exe",
    ]
    for candidate in candidates:
        if candidate.exists():
            return str(candidate)
    return "pyw.exe"


def _probe_requested_python(version: str, require_modules: bool = False) -> bool:
    if os.name != "nt":
        return False
    launcher = str(Path(os.environ.get("WINDIR", r"C:\Windows")) / "py.exe")
    code = "import sys; assert sys.version_info[:2] == tuple(map(int, '" + version + "'.split('.')))"
    if require_modules:
        code += "; import cv2,numpy"
    try:
        creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        result = subprocess.run(
            [launcher, f"-{version}", "-c", code],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=12,
            creationflags=creationflags,
        )
        return result.returncode == 0
    except Exception:
        return False


def _spawn_requested_python(version: str) -> bool:
    launcher = _launcher_executable()
    if not launcher:
        return False
    flag = f"-{version}"
    try:
        creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
        subprocess.Popen(
            [launcher, flag, str(SCRIPT_FILE)],
            cwd=str(SCRIPT_DIR),
            close_fds=True,
            creationflags=creationflags,
        )
        return True
    except Exception:
        log_exception(f"Could not re-launch with Python {version}")
        return False


def bootstrap_python_version() -> None:
    """Re-launch with the interpreter selected by JSX before importing cv2/numpy."""
    config = _load_launch_config()
    preferred = str(config.get("python_version") or "auto").strip().lower()
    current = f"{sys.version_info.major}.{sys.version_info.minor}"
    if preferred in set(SUPPORTED_PYTHON_NAMES) and preferred != current:
        write_startup_status("starting", f"Switching to Python {preferred}")
        if _probe_requested_python(preferred, False) and _spawn_requested_python(preferred):
            raise SystemExit(0)
        write_startup_status(
            "error",
            f"Could not start Python {preferred}. Run install.bat and verify the Python Launcher for Windows is installed.",
        )
        raise SystemExit(2)
    if preferred == "auto" and (sys.version_info.major, sys.version_info.minor) not in SUPPORTED_PYTHON:
        # Prefer an installed supported interpreter that already has the modules.
        for require_modules in (True, False):
            for candidate in SUPPORTED_PYTHON_NAMES:
                if _probe_requested_python(candidate, require_modules) and _spawn_requested_python(candidate):
                    write_startup_status("starting", f"Switching to supported Python {candidate}")
                    raise SystemExit(0)
        write_startup_status(
            "error",
            f"Python {current} is not supported. Install CPython 3.11–3.14 with the Python Launcher for Windows.",
        )
        raise SystemExit(2)


if os.environ.get("FCM_SKIP_BOOTSTRAP") != "1":
    bootstrap_python_version()

try:
    import numpy as np
    import cv2
except Exception as _import_error:
    # In Auto mode, try the other supported system Python if it already has dependencies.
    config = _load_launch_config()
    preferred = str(config.get("python_version") or "auto").strip().lower()
    current = (sys.version_info.major, sys.version_info.minor)
    if os.name == "nt" and preferred == "auto":
        launcher = _launcher_executable()
        if launcher:
            for candidate in SUPPORTED_PYTHON_NAMES:
                parts = tuple(int(x) for x in candidate.split("."))
                if parts == current:
                    continue
                if _probe_requested_python(candidate, True) and _spawn_requested_python(candidate):
                    raise SystemExit(0)
    write_startup_status(
        "error",
        "Required Python modules are missing. Run install.bat before the first launch.\n"
        + str(_import_error),
    )
    raise SystemExit(3)


class ApiError(Exception):
    def __init__(self, message: str, code: str = "", details: Optional[Dict[str, Any]] = None):
        super().__init__(message)
        self.code = code
        self.details = details or {}


def json_ascii(data: Any) -> bytes:
    return (json.dumps(data, ensure_ascii=True, separators=(",", ":")) + "\n").encode("ascii")


def send_reply(payload: Dict[str, Any], retries: int = 30) -> bool:
    data = json_ascii(payload)
    with _REPLY_LOCK:
        for attempt in range(retries):
            try:
                with socket.create_connection((API_HOST, API_REPLY_PORT), timeout=1.0) as sock:
                    sock.sendall(data)
                return True
            except OSError:
                if attempt + 1 < retries:
                    time.sleep(0.05)
    return False


def reply(request_id: str, message: Any) -> None:
    send_reply({
        "protocol": API_PROTOCOL,
        "request_id": request_id,
        "type": "answer",
        "message": message,
    })


def error_reply(request_id: str, exc: Exception) -> None:
    payload: Dict[str, Any] = {
        "protocol": API_PROTOCOL,
        "request_id": request_id,
        "type": "error",
        "message": str(exc) or exc.__class__.__name__,
    }
    if isinstance(exc, ApiError):
        if exc.code:
            payload["code"] = exc.code
        if exc.details:
            payload["details"] = exc.details
    send_reply(payload)


def _read_image_bytes(path: str) -> Tuple[Path, np.ndarray]:
    p = Path(path)
    if not p.is_file():
        raise ApiError(
            f"Image file does not exist: {path}",
            "IMAGE_NOT_FOUND",
        )
    try:
        raw = np.fromfile(str(p), dtype=np.uint8)
    except Exception as exc:
        raise ApiError(
            f"Could not read image: {path}\n{exc}",
            "IMAGE_READ_ERROR",
        )
    if raw.size == 0:
        raise ApiError(
            f"Image file is empty: {path}",
            "IMAGE_READ_ERROR",
        )
    return p, raw


def _jpeg_dimensions(raw: np.ndarray) -> Optional[Tuple[int, int]]:
    """Read JPEG SOF dimensions without decoding the full image."""
    data = memoryview(np.asarray(raw, dtype=np.uint8))
    size = len(data)
    if size < 4 or data[0] != 0xFF or data[1] != 0xD8:
        return None

    sof_markers = {
        0xC0, 0xC1, 0xC2, 0xC3,
        0xC5, 0xC6, 0xC7,
        0xC9, 0xCA, 0xCB,
        0xCD, 0xCE, 0xCF,
    }
    i = 2
    while i + 3 < size:
        while i < size and data[i] != 0xFF:
            i += 1
        while i < size and data[i] == 0xFF:
            i += 1
        if i >= size:
            break
        marker = int(data[i])
        i += 1
        if marker in (0xD8, 0xD9):
            continue
        if marker == 0xDA:  # Start of scan: SOF must already have appeared.
            break
        if i + 1 >= size:
            break
        segment_len = (int(data[i]) << 8) | int(data[i + 1])
        if segment_len < 2 or i + segment_len > size:
            break
        if marker in sof_markers and segment_len >= 7:
            height = (int(data[i + 3]) << 8) | int(data[i + 4])
            width = (int(data[i + 5]) << 8) | int(data[i + 6])
            if width > 0 and height > 0:
                return width, height
        i += segment_len
    return None


def _jpeg_reduced_decode_flag(
    raw: np.ndarray,
    max_size: Optional[int],
) -> int:
    max_size = int(max_size or 0)
    if max_size <= 0:
        return cv2.IMREAD_COLOR
    dimensions = _jpeg_dimensions(raw)
    if not dimensions:
        return cv2.IMREAD_COLOR
    longest = max(dimensions)

    # Decode at the largest native JPEG reduction that still leaves enough
    # pixels for the requested analysis size, then do one exact INTER_AREA
    # resize. This avoids decoding a 40–60 MP temporary JPEG at full size.
    flags = (
        (8, getattr(cv2, "IMREAD_REDUCED_COLOR_8", cv2.IMREAD_COLOR)),
        (4, getattr(cv2, "IMREAD_REDUCED_COLOR_4", cv2.IMREAD_COLOR)),
        (2, getattr(cv2, "IMREAD_REDUCED_COLOR_2", cv2.IMREAD_COLOR)),
    )
    for divisor, flag in flags:
        if longest / float(divisor) >= max_size * 1.02:
            return int(flag)
    return cv2.IMREAD_COLOR


def imread_analysis_unicode(
    path: str,
    max_size: Optional[int],
) -> np.ndarray:
    p, raw = _read_image_bytes(path)
    flag = (
        _jpeg_reduced_decode_flag(raw, max_size)
        if p.suffix.lower() in {".jpg", ".jpeg"}
        else cv2.IMREAD_COLOR
    )
    try:
        image = cv2.imdecode(raw, flag)
    except Exception as exc:
        raise ApiError(
            f"Could not decode image: {path}\n{exc}",
            "IMAGE_READ_ERROR",
        )
    if image is None or image.size == 0:
        raise ApiError(
            f"Could not decode image: {path}",
            "IMAGE_READ_ERROR",
        )
    return prepare_analysis_image(image, max_size)


def prepare_analysis_image(image: np.ndarray, max_size: Optional[int]) -> np.ndarray:
    max_size = int(max_size or 0)
    if max_size <= 0:
        return image
    h, w = image.shape[:2]
    longest = max(h, w)
    if longest <= max_size:
        return image
    scale = float(max_size) / float(longest)
    new_w = max(1, int(round(w * scale)))
    new_h = max(1, int(round(h * scale)))
    return cv2.resize(image, (new_w, new_h), interpolation=cv2.INTER_AREA)


_YUNET_DETECTOR: Any = None
_YUNET_DETECTOR_FAILED = False
_HAAR_CASCADE: Any = None


def _get_yunet_detector() -> Any:
    global _YUNET_DETECTOR, _YUNET_DETECTOR_FAILED
    if _YUNET_DETECTOR is not None:
        return _YUNET_DETECTOR
    if _YUNET_DETECTOR_FAILED:
        return None
    if (
        not YUNET_MODEL.is_file()
        or YUNET_MODEL.stat().st_size <= 100000
        or not hasattr(cv2, "FaceDetectorYN_create")
    ):
        _YUNET_DETECTOR_FAILED = True
        return None
    try:
        _YUNET_DETECTOR = cv2.FaceDetectorYN_create(
            str(YUNET_MODEL),
            "",
            (320, 320),
            0.72,
            0.3,
            5000,
        )
    except Exception:
        _YUNET_DETECTOR_FAILED = True
        log_exception("Could not initialize YuNet detector")
        return None
    return _YUNET_DETECTOR


def _get_haar_cascade() -> Any:
    global _HAAR_CASCADE
    if _HAAR_CASCADE is not None:
        return _HAAR_CASCADE
    cascade_path = (
        Path(cv2.data.haarcascades)
        / "haarcascade_frontalface_default.xml"
    )
    cascade = cv2.CascadeClassifier(str(cascade_path))
    if cascade.empty():
        return None
    _HAAR_CASCADE = cascade
    return _HAAR_CASCADE


def _detector_status() -> Tuple[str, bool]:
    yunet_ready = _get_yunet_detector() is not None
    if yunet_ready:
        return "yunet", True
    return "haar-fallback", False


def _detect_yunet(image: np.ndarray) -> List[Dict[str, Any]]:
    detector = _get_yunet_detector()
    if detector is None:
        return []
    h, w = image.shape[:2]
    detect_size = (320, 320)
    scale = min(detect_size[0] / float(max(w, 1)), detect_size[1] / float(max(h, 1)))
    nw, nh = max(1, int(round(w * scale))), max(1, int(round(h * scale)))
    resized = cv2.resize(image, (nw, nh), interpolation=cv2.INTER_AREA if scale < 1.0 else cv2.INTER_LINEAR)
    small = np.zeros((detect_size[1], detect_size[0], 3), dtype=np.uint8)
    pad_x = (detect_size[0] - nw) // 2
    pad_y = (detect_size[1] - nh) // 2
    small[pad_y:pad_y + nh, pad_x:pad_x + nw] = resized
    try:
        detector.setInputSize(detect_size)
        _retval, faces = detector.detect(small)
    except Exception:
        log_exception("YuNet detection failed")
        return []
    if faces is None:
        return []
    results: List[Dict[str, Any]] = []
    for row in faces:
        x, y, fw, fh = [float(v) for v in row[:4]]
        x = (x - pad_x) / scale
        y = (y - pad_y) / scale
        fw = fw / scale
        fh = fh / scale
        landmarks = []
        for i in range(5):
            landmarks.append([(float(row[4 + i * 2]) - pad_x) / scale, (float(row[5 + i * 2]) - pad_y) / scale])
        results.append({
            "bbox": [x, y, fw, fh],
            "landmarks": landmarks,
            "score": float(row[14]),
            "detector": "yunet",
        })
    return results


def _detect_haar(image: np.ndarray) -> List[Dict[str, Any]]:
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    cascade = _get_haar_cascade()
    if cascade is None:
        return []
    faces = cascade.detectMultiScale(gray, scaleFactor=1.08, minNeighbors=5, minSize=(48, 48))
    results: List[Dict[str, Any]] = []
    for x, y, w, h in faces:
        results.append({
            "bbox": [float(x), float(y), float(w), float(h)],
            "landmarks": [],
            "score": 0.5,
            "detector": "haar-fallback",
        })
    return results


def detect_faces(image: np.ndarray) -> List[Dict[str, Any]]:
    faces = _detect_yunet(image)
    if not faces:
        faces = _detect_haar(image)
    h, w = image.shape[:2]
    cx, cy = w * 0.5, h * 0.5
    for face in faces:
        x, y, fw, fh = face["bbox"]
        area = max(1.0, fw * fh)
        fx, fy = x + fw * 0.5, y + fh * 0.5
        dist = math.hypot((fx - cx) / max(w, 1), (fy - cy) / max(h, 1))
        face["rank"] = area * max(0.2, 1.0 - 0.45 * dist)
    faces.sort(key=lambda item: float(item.get("rank", 0.0)), reverse=True)
    return faces



FACE_SELECTION_MAIN = "main"
FACE_SELECTION_CENTRAL_AVERAGE = "central_average"
CENTRAL_AVERAGE_MAX_FACES = 3
CENTRAL_AVERAGE_MAX_DISTANCE = 0.34
CENTRAL_AVERAGE_FALLBACK_DISTANCE = 0.45
CENTRAL_AVERAGE_MIN_RELATIVE_AREA = 0.22


def _normalize_face_selection_mode(value: Any) -> str:
    mode = str(value or FACE_SELECTION_MAIN).strip().lower()
    if mode == FACE_SELECTION_CENTRAL_AVERAGE:
        return FACE_SELECTION_CENTRAL_AVERAGE
    return FACE_SELECTION_MAIN


def _face_center_distance(
    face: Dict[str, Any],
    image_shape: Sequence[int],
) -> float:
    h, w = int(image_shape[0]), int(image_shape[1])
    x, y, fw, fh = [float(v) for v in face["bbox"]]
    fx = x + fw * 0.5
    fy = y + fh * 0.5
    return float(math.hypot(
        (fx - w * 0.5) / max(float(w), 1.0),
        (fy - h * 0.5) / max(float(h), 1.0),
    ))


def _face_area(face: Dict[str, Any]) -> float:
    x, y, fw, fh = [float(v) for v in face["bbox"]]
    return float(max(1.0, fw * fh))


def _union_face_bbox(
    faces: Sequence[Dict[str, Any]],
) -> List[float]:
    if not faces:
        return []
    xs: List[float] = []
    ys: List[float] = []
    x2s: List[float] = []
    y2s: List[float] = []
    for face in faces:
        x, y, w, h = [float(v) for v in face["bbox"]]
        xs.append(x)
        ys.append(y)
        x2s.append(x + w)
        y2s.append(y + h)
    x0 = min(xs)
    y0 = min(ys)
    x1 = max(x2s)
    y1 = max(y2s)
    return [
        round(float(x0), 3),
        round(float(y0), 3),
        round(float(max(0.0, x1 - x0)), 3),
        round(float(max(0.0, y1 - y0)), 3),
    ]


def _select_faces_for_analysis(
    faces: Sequence[Dict[str, Any]],
    image_shape: Sequence[int],
    face_selection_mode: Any = None,
) -> List[Dict[str, Any]]:
    if not faces:
        return []

    mode = _normalize_face_selection_mode(
        face_selection_mode
    )
    ordered = list(faces)
    if mode == FACE_SELECTION_MAIN or len(ordered) <= 1:
        return [ordered[0]]

    measured = [
        (
            _face_center_distance(face, image_shape),
            _face_area(face),
            face,
        )
        for face in ordered
    ]

    def rank_band(
        items: Sequence[Tuple[float, float, Dict[str, Any]]],
        max_distance: float,
        min_relative_area: float,
    ) -> List[Dict[str, Any]]:
        band = [item for item in items if item[0] <= max_distance]
        if not band:
            return []

        # Crucially, a huge face at the frame edge must not make genuinely
        # central faces look "too small". Size is normalized only inside the
        # central band currently being considered.
        band_max_area = max(item[1] for item in band)
        ranked: List[Tuple[float, float, float, Dict[str, Any]]] = []
        for dist, area, face in band:
            area_ratio = area / max(band_max_area, 1.0)
            if area_ratio + 1e-12 < min_relative_area:
                continue
            size_factor = math.sqrt(
                max(0.0, min(1.0, area_ratio))
            )
            centrality = max(
                0.0,
                1.0 - dist / max(max_distance, 1e-6),
            )
            score = centrality * (0.78 + 0.22 * size_factor)
            ranked.append((score, dist, -area, face))

        ranked.sort(
            key=lambda item: (
                -float(item[0]),
                float(item[1]),
                float(item[2]),
            )
        )
        return [
            item[3]
            for item in ranked[
                : max(1, int(CENTRAL_AVERAGE_MAX_FACES))
            ]
        ]

    # If there are useful faces in the strict central band, use only those.
    # "Up to 3" intentionally does not mean filling the remaining slots with
    # more peripheral faces.
    selected = rank_band(
        measured,
        CENTRAL_AVERAGE_MAX_DISTANCE,
        CENTRAL_AVERAGE_MIN_RELATIVE_AREA,
    )
    if not selected:
        selected = rank_band(
            measured,
            CENTRAL_AVERAGE_FALLBACK_DISTANCE,
            0.16,
        )

    if not selected:
        # No face is reasonably central. Use the nearest face only rather than
        # averaging several unrelated peripheral subjects.
        nearest = min(
            measured,
            key=lambda item: (float(item[0]), -float(item[1])),
        )
        selected = [nearest[2]]

    selected.sort(
        key=lambda face: _face_center_distance(
            face,
            image_shape,
        )
    )
    return selected


def canonical_face_patch(image: np.ndarray, face: Dict[str, Any], size: int = 256) -> Tuple[np.ndarray, List[List[float]]]:
    """Normalize scale/roll from YuNet landmarks before sampling skin zones."""
    landmarks = face.get("landmarks") or []
    if len(landmarks) >= 5:
        eyes = sorted([landmarks[0], landmarks[1]], key=lambda p: float(p[0]))
        mouth = sorted([landmarks[3], landmarks[4]], key=lambda p: float(p[0]))
        src = np.asarray([eyes[0], eyes[1], landmarks[2], mouth[0], mouth[1]], dtype=np.float32)
        dst = np.asarray([
            [size * 0.31, size * 0.35],
            [size * 0.69, size * 0.35],
            [size * 0.50, size * 0.54],
            [size * 0.36, size * 0.72],
            [size * 0.64, size * 0.72],
        ], dtype=np.float32)
        matrix, _inliers = cv2.estimateAffinePartial2D(src, dst, method=cv2.LMEDS)
        if matrix is not None:
            patch = cv2.warpAffine(
                image, matrix, (size, size), flags=cv2.INTER_LINEAR,
                borderMode=cv2.BORDER_CONSTANT, borderValue=(0, 0, 0)
            )
            return patch, [[float(v[0]), float(v[1])] for v in dst]

    x, y, w, h = [float(v) for v in face["bbox"]]
    ih, iw = image.shape[:2]
    margin_x = w * 0.08
    margin_y_top = h * 0.10
    margin_y_bottom = h * 0.04
    x0 = max(0, int(round(x - margin_x)))
    y0 = max(0, int(round(y - margin_y_top)))
    x1 = min(iw, int(round(x + w + margin_x)))
    y1 = min(ih, int(round(y + h + margin_y_bottom)))
    crop = image[y0:y1, x0:x1]
    if crop.size == 0:
        raise ApiError("Could not build a normalized face crop.", "FACE_CROP_ERROR")
    patch = cv2.resize(crop, (size, size), interpolation=cv2.INTER_AREA if max(crop.shape[:2]) > size else cv2.INTER_LINEAR)
    return patch, []


ZONE_DEFS: Dict[str, Tuple[float, float, float, float]] = {
    "forehead": (0.28, 0.18, 0.72, 0.36),
    "left_cheek": (0.15, 0.43, 0.43, 0.68),
    "right_cheek": (0.57, 0.43, 0.85, 0.68),
    "nose": (0.41, 0.36, 0.59, 0.66),
    "chin": (0.34, 0.69, 0.66, 0.84),
}
ZONE_WEIGHTS = {
    "forehead": 0.50,
    "left_cheek": 1.00,
    "right_cheek": 1.00,
    "nose": 0.22,
    "chin": 0.30,
}
# Dense tonal sampling for new presets. All legacy quantiles remain present,
# so presets made by earlier versions still retain their original correspondences.
TONE_Q = [0.08, 0.12, 0.22, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.88, 0.94]
TONE_WEIGHTS = [0.08, 0.15, 0.25, 0.38, 0.55, 0.72, 0.88, 1.00, 0.85, 0.62, 0.35]
SKIN_SEED_DEFS: Dict[str, Tuple[float, float, float, float]] = {
    "left_cheek_seed": (0.23, 0.47, 0.37, 0.61),
    "right_cheek_seed": (0.63, 0.47, 0.77, 0.61),
    "forehead_seed": (0.39, 0.23, 0.61, 0.33),
}


def _rect_mask(shape: Tuple[int, int], rect: Sequence[float]) -> np.ndarray:
    h, w = shape
    x0, y0, x1, y1 = rect
    x0i = max(0, min(w, int(round(x0))))
    x1i = max(0, min(w, int(round(x1))))
    y0i = max(0, min(h, int(round(y0))))
    y1i = max(0, min(h, int(round(y1))))
    mask = np.zeros((h, w), dtype=np.uint8)
    if x1i > x0i and y1i > y0i:
        mask[y0i:y1i, x0i:x1i] = 1
    return mask


def _ellipse_exclusion(mask: np.ndarray, center: Tuple[float, float], axes: Tuple[float, float]) -> None:
    cx, cy = int(round(center[0])), int(round(center[1]))
    ax, ay = max(1, int(round(axes[0]))), max(1, int(round(axes[1])))
    cv2.ellipse(mask, (cx, cy), (ax, ay), 0, 0, 360, 0, -1)


def _robust_pixels(rgb: np.ndarray, mask: np.ndarray) -> np.ndarray:
    pixels = rgb[mask.astype(bool)]
    if pixels.shape[0] < 25:
        return pixels
    pixels_f = pixels.astype(np.float32)
    y = 0.2126 * pixels_f[:, 0] + 0.7152 * pixels_f[:, 1] + 0.0722 * pixels_f[:, 2]
    keep = (y > 12.0) & (y < 248.0)
    if keep.sum() >= 25:
        pixels_f = pixels_f[keep]
    if pixels_f.shape[0] < 25:
        return pixels_f.astype(np.uint8)

    lab = cv2.cvtColor((pixels_f.reshape(-1, 1, 3) / 255.0).astype(np.float32), cv2.COLOR_RGB2LAB).reshape(-1, 3)
    chroma = lab[:, 1:3]
    med = np.median(chroma, axis=0)
    distance = np.sqrt(np.sum((chroma - med) ** 2, axis=1))
    threshold = max(8.0, float(np.percentile(distance, 88.0)))
    keep = distance <= threshold
    if keep.sum() >= 25:
        pixels_f = pixels_f[keep]
    return np.clip(pixels_f, 0, 255).astype(np.uint8)




def _feature_safe_mask(shape: Tuple[int, int], rect: Sequence[float], landmarks: Sequence[Sequence[float]]) -> np.ndarray:
    h, w = shape
    mask = _rect_mask(shape, rect)
    if len(landmarks) >= 5:
        eye_axes = (w * 0.105, h * 0.070)
        _ellipse_exclusion(mask, tuple(landmarks[0]), eye_axes)
        _ellipse_exclusion(mask, tuple(landmarks[1]), eye_axes)
        mouth_cx = (landmarks[3][0] + landmarks[4][0]) * 0.5
        mouth_cy = (landmarks[3][1] + landmarks[4][1]) * 0.5
        mouth_w = abs(landmarks[4][0] - landmarks[3][0]) * 0.72 + w * 0.035
        _ellipse_exclusion(mask, (mouth_cx, mouth_cy), (max(w * 0.08, mouth_w), h * 0.07))
    return mask


def _lab_pixels_from_rgb(pixels: np.ndarray) -> np.ndarray:
    if pixels.size == 0:
        return np.empty((0, 3), dtype=np.float32)
    return cv2.cvtColor((pixels.reshape(-1, 1, 3).astype(np.float32) / 255.0), cv2.COLOR_RGB2LAB).reshape(-1, 3)


def _lab_image_from_rgb(rgb: np.ndarray) -> np.ndarray:
    return cv2.cvtColor((rgb.astype(np.float32) / 255.0), cv2.COLOR_RGB2LAB)


def _finalize_skin_pixels(rgb: np.ndarray, mask: np.ndarray, seed_lab: np.ndarray | None = None) -> np.ndarray:
    pixels = rgb[mask.astype(bool)]
    if pixels.shape[0] < 25:
        return pixels
    pixels = _robust_pixels(rgb, mask)
    if pixels.shape[0] < 25 or seed_lab is None or seed_lab.shape[0] < 25:
        return pixels

    lab = _lab_pixels_from_rgb(pixels)
    seed_ab = seed_lab[:, 1:3]
    seed_ab_center = np.median(seed_ab, axis=0)
    seed_ab_dist = np.sqrt(np.sum((seed_ab - seed_ab_center) ** 2, axis=1))
    ab_threshold = float(np.percentile(seed_ab_dist, 92.0)) + 4.0
    ab_threshold = float(np.clip(ab_threshold, 6.0, 18.0))
    l_low = float(np.percentile(seed_lab[:, 0], 5.0) - 16.0)
    l_high = float(np.percentile(seed_lab[:, 0], 97.0) + 12.0)
    chroma = np.sqrt(np.sum((lab[:, 1:3] - seed_ab_center) ** 2, axis=1))
    keep = (lab[:, 0] >= l_low) & (lab[:, 0] <= l_high) & (chroma <= ab_threshold)
    if np.count_nonzero(keep) >= 25:
        pixels = pixels[keep]
    return pixels


def _skin_mask_from_patch(rgb: np.ndarray, landmarks: Sequence[Sequence[float]]) -> Tuple[np.ndarray, Dict[str, np.ndarray], Dict[str, Any]]:
    h, w = rgb.shape[:2]
    zone_masks: Dict[str, np.ndarray] = {}
    union_mask = np.zeros((h, w), dtype=np.uint8)
    for name, rect in ZONE_DEFS.items():
        mask = _feature_safe_mask((h, w), (w * rect[0], h * rect[1], w * rect[2], h * rect[3]), landmarks)
        zone_masks[name] = mask
        union_mask = np.maximum(union_mask, mask)

    seed_pixels_list: List[np.ndarray] = []
    for rect in SKIN_SEED_DEFS.values():
        mask = _feature_safe_mask((h, w), (w * rect[0], h * rect[1], w * rect[2], h * rect[3]), landmarks)
        pixels = _robust_pixels(rgb, mask)
        if pixels.shape[0] >= 18:
            seed_pixels_list.append(pixels)

    if seed_pixels_list:
        seed_pixels = np.concatenate(seed_pixels_list, axis=0)
        seed_lab = _lab_pixels_from_rgb(seed_pixels)
        lab_img = _lab_image_from_rgb(rgb)
        rgb_f = rgb.astype(np.float32)
        lum = 0.2126 * rgb_f[:, :, 0] + 0.7152 * rgb_f[:, :, 1] + 0.0722 * rgb_f[:, :, 2]
        seed_ab_center = np.median(seed_lab[:, 1:3], axis=0)
        seed_ab_dist = np.sqrt(np.sum((seed_lab[:, 1:3] - seed_ab_center) ** 2, axis=1))
        ab_threshold = float(np.percentile(seed_ab_dist, 92.0)) + 4.0
        ab_threshold = float(np.clip(ab_threshold, 6.0, 18.0))
        l_low = float(np.percentile(seed_lab[:, 0], 4.0) - 16.0)
        l_high = float(np.percentile(seed_lab[:, 0], 98.0) + 12.0)
        ab_dist = np.sqrt(np.sum((lab_img[:, :, 1:3] - seed_ab_center.reshape(1, 1, 2)) ** 2, axis=2))
        final_mask = ((union_mask > 0) & (lum > 18.0) & (lum < 245.0) & (lab_img[:, :, 0] >= l_low) & (lab_img[:, :, 0] <= l_high) & (ab_dist <= ab_threshold)).astype(np.uint8)
        kept = int(np.count_nonzero(final_mask))
        # Do not silently replace a weak colour-filtered skin mask with all
        # rectangular face zones. The old fallback could admit eyebrows, hair,
        # make-up and coloured reflections, then let the matcher fit them as
        # skin. Keeping the small reliable mask makes the normal zone-count and
        # pixel-count checks fail safely when the measurement is insufficient.
        insufficient_skin_mask = bool(kept < 80)
        cheek_left = _finalize_skin_pixels(rgb, zone_masks["left_cheek"], seed_lab)
        cheek_right = _finalize_skin_pixels(rgb, zone_masks["right_cheek"], seed_lab)
        cheek_de = None
        if cheek_left.shape[0] >= 25 and cheek_right.shape[0] >= 25:
            cheek_de = float(delta_e_2000(rgb_to_lab(np.median(cheek_left, axis=0)), rgb_to_lab(np.median(cheek_right, axis=0))))
        quality_score = 100.0
        quality_score -= max(0.0, 18.0 - min(18.0, float(kept) / 24.0)) * 2.0
        quality_score -= float(np.clip(ab_threshold - 9.0, 0.0, 8.0)) * 4.5
        if cheek_de is not None:
            quality_score -= max(0.0, cheek_de - 2.5) * 6.0
        quality = {
            "seed_pixels": int(seed_pixels.shape[0]),
            "candidate_pixels": int(np.count_nonzero(union_mask)),
            "skin_pixels": kept,
            "fallback_used": False,
            "insufficient_skin_mask": insufficient_skin_mask,
            "ab_threshold": round(ab_threshold, 2),
            "cheek_delta_e": round(cheek_de, 3) if cheek_de is not None else None,
            "score": round(float(np.clip(quality_score, 0.0, 100.0)), 1),
        }
        return final_mask, zone_masks, quality

    # Without a trustworthy chromatic seed there is no safe way to distinguish
    # skin from other content inside the geometric rectangles.
    return np.zeros_like(union_mask), zone_masks, {
        "seed_pixels": 0,
        "candidate_pixels": int(np.count_nonzero(union_mask)),
        "skin_pixels": 0,
        "fallback_used": False,
        "insufficient_skin_mask": True,
        "ab_threshold": None,
        "cheek_delta_e": None,
        "score": 45.0,
    }

def _anchors_from_pixels(pixels: np.ndarray) -> List[Dict[str, Any]]:
    if pixels.shape[0] < 25:
        return []
    arr = pixels.astype(np.float32)
    lum = 0.2126 * arr[:, 0] + 0.7152 * arr[:, 1] + 0.0722 * arr[:, 2]
    order = np.argsort(lum)
    arr = arr[order]
    lum = lum[order]
    n = len(lum)
    result: List[Dict[str, Any]] = []
    for q_index, q in enumerate(TONE_Q):
        # Adjacent anchors used to share up to half of their pixels. That made
        # cross-validation optimistic because nearly identical measurements
        # appeared in both train and held-out folds. Size each window from the
        # nearest quantile spacing and leave a small gap between windows.
        left_gap = (
            q - TONE_Q[q_index - 1]
            if q_index > 0 else q
        )
        right_gap = (
            TONE_Q[q_index + 1] - q
            if q_index + 1 < len(TONE_Q) else 1.0 - q
        )
        local_gap = max(0.01, min(left_gap, right_gap))
        half_window = max(
            5,
            int(math.floor(n * local_gap * 0.40)),
        )
        center = int(round((n - 1) * q))
        lo = max(0, center - half_window)
        hi = min(n, center + half_window + 1)
        sample = arr[lo:hi]
        sample_l = lum[lo:hi]
        if sample.shape[0] < 8:
            continue
        rgb_med = np.median(sample, axis=0)
        y_med = float(np.median(sample_l))
        spread = float(np.mean(np.std(sample, axis=0)))
        result.append({
            "q": float(q),
            "r": float(rgb_med[0]),
            "g": float(rgb_med[1]),
            "b": float(rgb_med[2]),
            "y": y_med,
            "count": int(sample.shape[0]),
            "spread": spread,
        })
    return result


def _analyze_single_detected_face(
    image: np.ndarray,
    face: Dict[str, Any],
    detected_face_count: int,
) -> Tuple[Dict[str, Any], np.ndarray]:
    ih, iw = image.shape[:2]
    bx, by, bw, bh = [float(v) for v in face["bbox"]]
    bx = max(0.0, bx)
    by = max(0.0, by)
    bw = min(float(iw) - bx, bw)
    bh = min(float(ih) - by, bh)
    if bw < 32 or bh < 32:
        raise ApiError(
            "The detected face is too small for reliable color measurement.",
            "FACE_TOO_SMALL",
        )

    patch_bgr, canonical_landmarks = canonical_face_patch(
        image,
        face,
        256,
    )
    h, w = patch_bgr.shape[:2]
    rgb = cv2.cvtColor(patch_bgr, cv2.COLOR_BGR2RGB)
    skin_mask, zone_masks, quality = _skin_mask_from_patch(
        rgb,
        canonical_landmarks,
    )
    zones: Dict[str, Any] = {}
    all_zone_pixels: List[np.ndarray] = []
    seed_lab = None
    pooled_seed_pixels = rgb[skin_mask.astype(bool)]
    if pooled_seed_pixels.shape[0] >= 25:
        seed_lab = _lab_pixels_from_rgb(pooled_seed_pixels)

    for name in ZONE_DEFS.keys():
        zone_mask = (
            (
                zone_masks.get(
                    name,
                    np.zeros((h, w), dtype=np.uint8),
                ) > 0
            )
            & (skin_mask > 0)
        ).astype(np.uint8)
        pixels = _finalize_skin_pixels(
            rgb,
            zone_mask,
            seed_lab,
        )
        if (
            pixels.shape[0] < 25
            and np.count_nonzero(zone_mask) >= 25
        ):
            pixels = _robust_pixels(rgb, zone_mask)
        anchors = _anchors_from_pixels(pixels)
        if anchors:
            zones[name] = {
                "anchors": anchors,
                "pixels": int(pixels.shape[0]),
            }
            all_zone_pixels.append(pixels)

    if len(zones) < 2:
        raise ApiError(
            "The face was found, but there are not enough reliable skin regions to measure.",
            "INSUFFICIENT_SKIN",
        )

    if all_zone_pixels:
        pooled = np.concatenate(all_zone_pixels, axis=0)
    else:
        pooled = rgb[skin_mask.astype(bool)]
    pooled = (
        pooled
        if pooled.size
        else np.empty((0, 3), dtype=np.uint8)
    )
    pooled_anchors = _anchors_from_pixels(pooled)
    # Global WB is fitted later from target/reference correspondences. Do not
    # spend time guessing scene neutrals while measuring a face.
    white_balance = {
        "enabled": False,
        "confidence": 0.0,
        "strength": 0.0,
        "neutral_pixels": 0,
        "candidate_chroma": 0.0,
        "gains": {"r": 1.0, "g": 1.0, "b": 1.0},
        "mean_rgb": {"r": 0.0, "g": 0.0, "b": 0.0},
        "source": "reference-relative-fit",
    }
    result = {
        "zones": zones,
        "pooled": {
            "anchors": pooled_anchors,
            "pixels": int(pooled.shape[0]),
        },
        "white_balance": white_balance,
        "quality": quality,
        "face": {
            "bbox": [
                round(float(v), 3)
                for v in [bx, by, bw, bh]
            ],
            "score": round(
                float(face.get("score", 0.0)),
                5,
            ),
            "detector": str(
                face.get("detector") or "unknown"
            ),
            "face_count": int(detected_face_count),
            "normalized": bool(canonical_landmarks),
            "center_distance": round(
                _face_center_distance(face, image.shape),
                5,
            ),
        },
    }
    return result, pooled


def analyze_face(
    image: np.ndarray,
    face_selection_mode: Any = None,
) -> Dict[str, Any]:
    faces = detect_faces(image)
    if not faces:
        raise ApiError(
            "No face was found in the image.",
            "NO_FACE",
        )

    mode = _normalize_face_selection_mode(
        face_selection_mode
    )
    selected_faces = _select_faces_for_analysis(
        faces,
        image.shape,
        mode,
    )
    if not selected_faces:
        selected_faces = [faces[0]]

    measured_models: List[Dict[str, Any]] = []
    for face in selected_faces:
        model, _pooled = _analyze_single_detected_face(
            image,
            face,
            len(faces),
        )
        measured_models.append(model)

    if len(measured_models) == 1:
        result = measured_models[0]
        result_face = dict(result.get("face") or {})
        result_face["selection_mode"] = mode
        result_face["selected_face_count"] = 1
        result_face["detected_face_count"] = int(len(faces))
        result["face"] = result_face
        return result

    merged = measured_models[0]
    merged_count = 1
    for model in measured_models[1:]:
        merged = merge_reference_models(
            merged,
            model,
            merged_count,
        )
        merged_count += 1

    merged["white_balance"] = {
        "enabled": False,
        "confidence": 0.0,
        "strength": 0.0,
        "neutral_pixels": 0,
        "candidate_chroma": 0.0,
        "gains": {"r": 1.0, "g": 1.0, "b": 1.0},
        "mean_rgb": {"r": 0.0, "g": 0.0, "b": 0.0},
        "source": "reference-relative-fit",
    }

    normalized_samples = int(sum(
        1
        for model in measured_models
        if bool(
            (model.get("face") or {}).get("normalized")
        )
    ))
    avg_score = float(np.mean([
        float((model.get("face") or {}).get("score", 0.0))
        for model in measured_models
    ]))
    merged["face"] = {
        "bbox": _union_face_bbox(selected_faces),
        "score": round(avg_score, 5),
        "detector": "central-average",
        "face_count": int(len(faces)),
        "normalized": bool(
            normalized_samples * 2
            >= len(measured_models)
        ),
        "normalized_samples": int(normalized_samples),
        "selection_mode": mode,
        "selected_face_count": int(
            len(measured_models)
        ),
        "detected_face_count": int(len(faces)),
    }
    return merged


def evaluate_reference_quality(model: Dict[str, Any]) -> Dict[str, Any]:
    """Summarize whether one measured face is a stable colour reference.

    The preset is still created: this is a warning system, not another hidden
    hard gate. It catches references that make a mathematically precise match
    undesirable (clipping, very uneven cheeks, noisy skin, poor coverage).
    """
    zones = model.get("zones") or {}
    pooled = model.get("pooled") or {}
    quality = model.get("quality") or {}
    face = model.get("face") or {}

    anchors: List[Dict[str, Any]] = []
    for zone in zones.values():
        anchors.extend(zone.get("anchors") or [])

    spreads = np.asarray([
        float(item.get("spread", 0.0))
        for item in anchors
    ], dtype=np.float64)
    median_spread = float(np.median(spreads)) if spreads.size else 0.0

    clipped = 0
    for item in anchors:
        values = [
            float(item.get("r", 0.0)),
            float(item.get("g", 0.0)),
            float(item.get("b", 0.0)),
        ]
        if min(values) <= 6.0 or max(values) >= 249.0:
            clipped += 1
    clipping_fraction = (
        float(clipped) / float(len(anchors))
        if anchors else 0.0
    )

    issues: List[str] = []
    if len(zones) < 3:
        issues.append("few_zones")
    if int(pooled.get("pixels", 0) or 0) < 220:
        issues.append("low_coverage")
    if float(quality.get("score", 100.0) or 0.0) < 55.0:
        issues.append("low_mask_quality")
    if bool(quality.get("insufficient_skin_mask")):
        issues.append("insufficient_skin_mask")
    cheek_de = quality.get("cheek_delta_e")
    if cheek_de is not None and float(cheek_de) > 7.5:
        issues.append("uneven_cheeks")
    if median_spread > 16.0:
        issues.append("high_spread")
    if clipping_fraction > 0.10:
        issues.append("clipping")
    if not bool(face.get("normalized")):
        issues.append("weak_geometry")

    # Do not make a Haar fallback warning by itself look fatal. The status is
    # intended to surface references that actually have measurement concerns.
    substantive = [
        item for item in issues if item != "weak_geometry"
    ]
    status = "warning" if substantive else "good"

    return {
        "status": status,
        "issues": issues,
        "zone_count": int(len(zones)),
        "pooled_pixels": int(pooled.get("pixels", 0) or 0),
        "mask_score": round(float(quality.get("score", 0.0) or 0.0), 1),
        "cheek_delta_e": (
            round(float(cheek_de), 3)
            if cheek_de is not None else None
        ),
        "median_spread": round(median_spread, 3),
        "clipping_fraction": round(clipping_fraction, 4),
    }


def _srgb_to_linear_array(values: np.ndarray) -> np.ndarray:
    x = np.clip(np.asarray(values, dtype=np.float64) / 255.0, 0.0, 1.0)
    return np.where(x <= 0.04045, x / 12.92, ((x + 0.055) / 1.055) ** 2.4)


def _linear_to_srgb_scalar(value: float) -> float:
    x = float(np.clip(value, 0.0, 1.0))
    if x <= 0.0031308:
        return 12.92 * x
    return 1.055 * (x ** (1.0 / 2.4)) - 0.055


def _wb_channel_curve_value(x: float, gain: float) -> float:
    xv = float(np.clip(x, 0.0, 255.0))
    xn = xv / 255.0
    linear = xn / 12.92 if xn <= 0.04045 else ((xn + 0.055) / 1.055) ** 2.4
    corrected_linear = float(np.clip(linear * float(gain), 0.0, 1.0))
    corrected = _linear_to_srgb_scalar(corrected_linear) * 255.0

    # Keep deep shadows stable, move midtones moderately and highlights most.
    weight = (
        0.10 * float(_smoothstep(np.asarray([xv]), 18.0, 52.0)[0])
        + 0.32 * float(_param_basis_mid(np.asarray([xv]))[0])
        + 0.88 * float(_param_basis_high(np.asarray([xv]))[0])
    )
    return float(np.clip(xv + (corrected - xv) * weight, 0.0, 255.0))


def _sample_monotonic_curve(fn) -> List[List[int]]:
    """Safe fixed sampling for a smooth Photoshop Curves mapping.

    Nine control points are sufficient for this low-frequency function and are
    accepted by Photoshop's Curves ActionDescriptor across supported versions.
    A Curves layer remains continuous; reducing control-point count does not
    quantize its output or introduce posterization.
    """
    positions = (0, 32, 64, 96, 128, 160, 192, 224, 255)
    points: List[List[int]] = []
    previous = -1
    for x in positions:
        y = int(round(float(np.clip(fn(float(x)), 0.0, 255.0))))
        if x == 0:
            y = 0
        elif x == 255:
            y = 255
        else:
            y = max(previous + 1, min(254, y))
        points.append([int(x), int(y)])
        previous = y
    return points


def _white_balance_curves(wb: Optional[Dict[str, Any]]) -> Dict[str, List[List[int]]]:
    wb = wb or {}
    gains = wb.get("gains") or {}
    if not wb.get("enabled"):
        gains = {"r": 1.0, "g": 1.0, "b": 1.0}
    return {
        "composite": [[0, 0], [255, 255]],
        "red": _sample_monotonic_curve(
            lambda x: _wb_channel_curve_value(x, float(gains.get("r", 1.0)))
        ),
        "green": _sample_monotonic_curve(
            lambda x: _wb_channel_curve_value(x, float(gains.get("g", 1.0)))
        ),
        "blue": _sample_monotonic_curve(
            lambda x: _wb_channel_curve_value(x, float(gains.get("b", 1.0)))
        ),
    }


def _apply_curve_set_rgb(
    rgb: Sequence[float],
    curves: Dict[str, Sequence[Sequence[float]]],
) -> List[float]:
    values = np.asarray(rgb, dtype=np.float64)
    corrected = np.asarray([
        float(_interp_curve(
            curves.get(name) or [[0, 0], [255, 255]],
            np.asarray([values[index]], dtype=np.float32),
        )[0])
        for index, name in enumerate(("red", "green", "blue"))
    ], dtype=np.float64)
    composite = curves.get("composite") or [[0, 0], [255, 255]]
    corrected = _interp_curve(composite, corrected)
    return [float(value) for value in np.clip(corrected, 0.0, 255.0)]


def _rows_after_curve_set(
    rows: List[Dict[str, Any]],
    curves: Dict[str, Sequence[Sequence[float]]],
) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    for row in rows:
        target = row["target"]
        corrected = _apply_curve_set_rgb(
            [float(target[key]) for key in ("r", "g", "b")],
            curves,
        )
        new_target = dict(target)
        new_target["r"], new_target["g"], new_target["b"] = corrected
        new_target["y"] = (
            0.2126 * corrected[0]
            + 0.7152 * corrected[1]
            + 0.0722 * corrected[2]
        )
        new_row = dict(row)
        new_row["target"] = new_target
        out.append(new_row)
    return out


def _fit_relative_white_balance(
    rows: List[Dict[str, Any]],
    protection_bias: float = 0.0,
) -> Dict[str, Any]:
    """Fit a restrained reference-relative chromatic adaptation.

    The former scene-neutral estimator could remove an intentional warm or cool
    grade because it never compared the target with the selected reference.
    This two-parameter fit uses the actual skin correspondences, preserves the
    geometric mean of the RGB gains and stays close to identity. Tone and the
    skin LUT remain responsible for luminance and local residual colour.
    """
    disabled = {
        "enabled": False,
        "confidence": 0.0,
        "strength": 0.0,
        "neutral_pixels": 0,
        "candidate_chroma": 0.0,
        "gains": {"r": 1.0, "g": 1.0, "b": 1.0},
        "mean_rgb": {"r": 0.0, "g": 0.0, "b": 0.0},
        "source": "reference-relative",
    }
    if len(rows) < 6:
        return disabled

    source = np.asarray([
        [float(row["target"][key]) for key in ("r", "g", "b")]
        for row in rows
    ], dtype=np.float64)
    reference = np.asarray([
        _rgb_array_from_lab(
            _reference_lab_from_anchor(row["reference"]).reshape(1, 3)
        )[0]
        for row in rows
    ], dtype=np.float64)
    weights = np.asarray([
        max(1e-4, float(row.get("weight", 1.0)))
        for row in rows
    ], dtype=np.float64)
    source_linear = _srgb_to_linear_array(source)
    reference_linear = _srgb_to_linear_array(reference)
    log_ratio = np.log(np.clip(
        reference_linear / np.maximum(source_linear, 1e-5),
        1e-4,
        1e4,
    ))
    log_ratio -= np.mean(log_ratio, axis=1, keepdims=True)
    initial = np.asarray([
        weighted_median(log_ratio[:, 0], weights),
        weighted_median(log_ratio[:, 2], weights),
    ], dtype=np.float64)

    accuracy = _accuracy_profile_mix(protection_bias)
    safety = max(0.0, _normalized_percent_bias(protection_bias))
    cap = _lerp(0.145 - 0.025 * safety, 0.235, accuracy)

    def gains_from_params(params: np.ndarray) -> np.ndarray:
        logs = np.asarray([
            float(params[0]),
            -float(params[0]) - float(params[1]),
            float(params[1]),
        ], dtype=np.float64)
        logs = np.clip(logs, -cap, cap)
        logs -= float(np.mean(logs))
        return np.exp(logs)

    def score(params: np.ndarray) -> float:
        gains = gains_from_params(params)
        wb = {
            "enabled": True,
            "gains": dict(zip(("r", "g", "b"), gains.tolist())),
        }
        candidate_curves = _white_balance_curves(wb)
        candidate_rows = _rows_after_curve_set(rows, candidate_curves)
        regularization = (
            2.2 - 1.75 * accuracy + 1.2 * safety
        ) * float(np.sum(np.log(gains) ** 2))
        return float(_rows_delta_e_identity(candidate_rows) + regularization)

    params = np.clip(initial, -cap, cap)
    best = score(params)
    for step in (0.040, 0.020, 0.010, 0.005):
        changed = True
        rounds = 0
        while changed and rounds < 5:
            changed = False
            rounds += 1
            for index in range(2):
                for sign in (-1.0, 1.0):
                    candidate = params.copy()
                    candidate[index] = float(np.clip(
                        candidate[index] + sign * step,
                        -cap,
                        cap,
                    ))
                    value = score(candidate)
                    if value < best - 1e-8:
                        params, best, changed = candidate, value, True

    gains = gains_from_params(params)
    max_deviation = float(np.max(np.abs(gains - 1.0)))
    result = dict(disabled)
    result.update({
        "enabled": bool(max_deviation >= 0.004),
        "confidence": 1.0,
        "strength": 1.0,
        "gains": dict(zip(("r", "g", "b"), gains.tolist())),
    })
    return result


def _reference_lab_from_anchor(
    anchor: Dict[str, Any],
) -> np.ndarray:
    stored = anchor.get("mean_lab")
    if (
        isinstance(stored, (list, tuple))
        and len(stored) == 3
    ):
        try:
            return np.asarray(stored, dtype=np.float64)
        except (TypeError, ValueError):
            pass
    return np.asarray(
        rgb_to_lab([
            float(anchor["r"]),
            float(anchor["g"]),
            float(anchor["b"]),
        ]),
        dtype=np.float64,
    )


def _rows_delta_e_identity(rows: List[Dict[str, Any]]) -> float:
    errors: List[float] = []
    weights: List[float] = []
    for row in rows:
        t, r = row["target"], row["reference"]
        src = [float(t["r"]), float(t["g"]), float(t["b"])]
        errors.append(delta_e_2000(
            rgb_to_lab(src),
            _reference_lab_from_anchor(r),
        ))
        weights.append(max(1e-4, float(row.get("weight", 1.0))))
    ea, wa = np.asarray(errors, dtype=np.float64), np.asarray(weights, dtype=np.float64)
    return float(np.sum(ea * wa) / max(1e-9, float(np.sum(wa))))


def _row_delta_e_arrays(rows: List[Dict[str, Any]]) -> Tuple[np.ndarray, np.ndarray]:
    errors: List[float] = []
    weights: List[float] = []
    for row in rows:
        t, r = row["target"], row["reference"]
        errors.append(delta_e_2000(
            rgb_to_lab([
                float(t["r"]),
                float(t["g"]),
                float(t["b"]),
            ]),
            _reference_lab_from_anchor(r),
        ))
        weights.append(max(1e-4, float(row.get("weight", 1.0))))
    return np.asarray(errors, dtype=np.float64), np.asarray(weights, dtype=np.float64)


def _stage_stats(before_rows: List[Dict[str, Any]], after_rows: List[Dict[str, Any]]) -> Dict[str, float]:
    before, weights = _row_delta_e_arrays(before_rows)
    after, after_weights = _row_delta_e_arrays(after_rows)
    if before.size == 0 or after.size != before.size:
        return {
            "before": 0.0, "after": 0.0, "gain": 0.0,
            "nonworse_fraction": 0.0, "improved_fraction": 0.0,
            "p75_worsening": 0.0,
        }
    if after_weights.size == weights.size:
        weights = np.maximum(weights, after_weights)
    total = max(1e-9, float(np.sum(weights)))
    before_mean = float(np.sum(before * weights) / total)
    after_mean = float(np.sum(after * weights) / total)
    delta = after - before
    nonworse = float(np.sum(weights[delta <= 0.12]) / total)
    improved = float(np.sum(weights[delta <= -0.05]) / total)

    order = np.argsort(delta)
    d_sorted = delta[order]
    w_sorted = weights[order]
    cdf = np.cumsum(w_sorted) / total
    p75_i = int(np.searchsorted(cdf, 0.75, side="left"))
    p75 = float(d_sorted[min(max(p75_i, 0), len(d_sorted) - 1)])

    return {
        "before": before_mean,
        "after": after_mean,
        "gain": before_mean - after_mean,
        "nonworse_fraction": nonworse,
        "improved_fraction": improved,
        "p75_worsening": p75,
    }


def _row_chroma_arrays(
    rows: List[Dict[str, Any]],
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    target_c: List[float] = []
    reference_c: List[float] = []
    weights: List[float] = []

    for row in rows:
        t = row["target"]
        r = row["reference"]
        t_lab = _lab_array_from_rgb(np.asarray(
            [[float(t["r"]), float(t["g"]), float(t["b"])]],
            dtype=np.float64,
        ))[0]
        r_lab = _reference_lab_from_anchor(r)
        target_c.append(float(math.hypot(t_lab[1], t_lab[2])))
        reference_c.append(float(math.hypot(r_lab[1], r_lab[2])))
        weights.append(max(1e-4, float(row.get("weight", 1.0))))

    return (
        np.asarray(target_c, dtype=np.float64),
        np.asarray(reference_c, dtype=np.float64),
        np.asarray(weights, dtype=np.float64),
    )


def _chroma_stage_stats(
    before_rows: List[Dict[str, Any]],
    after_rows: List[Dict[str, Any]],
) -> Dict[str, float]:
    before_c, reference_c, weights = _row_chroma_arrays(before_rows)
    after_c, after_reference_c, after_weights = _row_chroma_arrays(after_rows)

    if (
        before_c.size == 0
        or after_c.size != before_c.size
        or float(np.sum(weights)) <= 0.0
    ):
        return {
            "before": 0.0,
            "after": 0.0,
            "gain": 0.0,
        }

    if after_reference_c.size == reference_c.size:
        reference_c = 0.5 * (
            reference_c + after_reference_c
        )
    if after_weights.size == weights.size:
        weights = 0.5 * (
            weights + after_weights
        )

    total = max(1e-9, float(np.sum(weights)))
    before_error = float(np.sum(
        weights * np.abs(reference_c - before_c)
    ) / total)
    after_error = float(np.sum(
        weights * np.abs(reference_c - after_c)
    ) / total)
    return {
        "before": before_error,
        "after": after_error,
        "gain": before_error - after_error,
    }


def _zone_delta_e(rows: List[Dict[str, Any]], zone_name: str) -> float:
    subset = [row for row in rows if str(row.get("zone") or "") == zone_name]
    return _rows_delta_e_identity(subset) if subset else 0.0


def _wb_stage_is_safe(
    before_rows: List[Dict[str, Any]],
    after_rows: List[Dict[str, Any]],
    minimum_gain: float,
    protection_bias: float = 0.0,
) -> Tuple[bool, Dict[str, float]]:
    stats = _stage_stats(before_rows, after_rows)
    protection = _protection_profile(
        protection_bias,
        minimum_gain,
    )
    if stats["gain"] + 1e-9 < max(0.0, float(minimum_gain)):
        return False, stats
    if stats["nonworse_fraction"] < protection["wb_nonworse"] or stats["p75_worsening"] > protection["wb_p75"]:
        return False, stats

    # Both cheeks are protected independently. A global scene-neutralization
    # is not useful if one side of the face is made visibly less reference-like.
    for zone in ("left_cheek", "right_cheek"):
        before = _zone_delta_e(before_rows, zone)
        after = _zone_delta_e(after_rows, zone)
        if (
            before > 0.0
            and after > before + protection["wb_cheek_worsening"]
        ):
            return False, stats
    return True, stats


# ---------------------------------------------------------------------------
# Smooth tone: fit ONLY the Lab L* mismatch, then express it as one very
# simple Photoshop Composite RGB curve.
#
# Photoshop/document space remains RGB. Lab is used only for the fitting
# objective. Only two parameters are fitted (midtone/highlight); Photoshop
# receives a safe fixed sampling of that one smooth function, not independently
# optimized control points.
# ---------------------------------------------------------------------------
TONE_SHADOW_LIMIT = 4.0
TONE_MID_LIMIT = 7.0
TONE_HIGH_LIMIT = 12.0
TONE_SHADOW_HARD_LIMIT = 5.2
TONE_HIGH_HARD_LIMIT = 15.0


def _tone_curve_points(params: Sequence[float]) -> List[List[int]]:
    """Sample one smooth three-parameter tonal function at fixed RGB positions.

    Shadow / midtone / highlight are smooth basis amplitudes, not independent
    Photoshop control points. This gives Tone enough freedom to correct a real
    global shadow mismatch while preventing the locally broken curves that
    appeared when brightness was corrected inside the skin LUT.
    """
    shadow, mid, high = [float(v) for v in params[:3]]
    shadow = float(np.clip(
        shadow,
        -TONE_SHADOW_HARD_LIMIT,
        TONE_SHADOW_HARD_LIMIT,
    ))
    mid = float(np.clip(mid, -TONE_MID_LIMIT, TONE_MID_LIMIT))
    high = float(np.clip(
        high,
        -TONE_HIGH_HARD_LIMIT,
        TONE_HIGH_HARD_LIMIT,
    ))

    positions = np.asarray(
        [0.0, 32.0, 64.0, 96.0, 128.0, 160.0, 192.0, 224.0, 255.0],
        dtype=np.float64,
    )
    x = positions

    # Shadow basis is a compact smooth lobe from black to RGB 128:
    # zero at black, maximum at 64, back to zero at 128. This lets shadows
    # follow a strong global lightness mismatch without moving the black point.
    shadow_phase = np.clip(x / 128.0, 0.0, 1.0)
    shadow_basis = np.sin(np.pi * shadow_phase) ** 2
    shadow_basis[x >= 128.0] = 0.0

    # Existing mid/high bases are retained. All three bases have zero movement
    # at absolute black/white.
    envelope = np.sin(np.pi * x / 255.0) ** 2
    mid_basis = (
        np.exp(-0.5 * ((x - 128.0) / 58.0) ** 2)
        * envelope
    )
    high_basis = (
        np.exp(-0.5 * ((x - 205.0) / 48.0) ** 2)
        * envelope
    )
    mid_basis /= max(
        1e-9,
        float(mid_basis[int(np.argmin(np.abs(x - 128.0)))]),
    )
    high_basis /= max(
        1e-9,
        float(high_basis[int(np.argmin(np.abs(x - 192.0)))]),
    )

    delta = (
        shadow * shadow_basis
        + mid * mid_basis
        + high * high_basis
    )
    outputs = np.clip(positions + delta, 0.0, 255.0)

    outputs[0] = 0.0
    outputs[-1] = 255.0
    for i in range(1, len(outputs)):
        outputs[i] = max(
            outputs[i],
            outputs[i - 1]
            + (0.0 if i == len(outputs) - 1 else 1.0),
        )
    outputs[-1] = 255.0

    return [
        [int(round(px)), int(round(py))]
        for px, py in zip(positions, outputs)
    ]


def _apply_composite_curve_rgb(
    rgb: Sequence[float],
    curve: Sequence[Sequence[float]],
) -> List[float]:
    values = np.asarray(rgb, dtype=np.float32)
    corrected = _interp_curve(curve, values)
    return [float(v) for v in np.clip(corrected, 0.0, 255.0)]


def _rows_after_tone_curve(
    rows: List[Dict[str, Any]],
    curve: Sequence[Sequence[float]],
) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    for row in rows:
        t = row["target"]
        corrected = _apply_composite_curve_rgb(
            [float(t["r"]), float(t["g"]), float(t["b"])],
            curve,
        )
        new_t = dict(t)
        new_t["r"], new_t["g"], new_t["b"] = corrected
        new_t["y"] = (
            0.2126 * corrected[0]
            + 0.7152 * corrected[1]
            + 0.0722 * corrected[2]
        )
        new_row = dict(row)
        new_row["target"] = new_t
        out.append(new_row)
    return out


def _row_lightness_arrays(
    rows: List[Dict[str, Any]],
    lightness_balance: float = 0.0,
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    target_l: List[float] = []
    reference_l: List[float] = []
    weights: List[float] = []

    for row in rows:
        t, r = row["target"], row["reference"]
        target_l.append(float(rgb_to_lab([
            float(t["r"]), float(t["g"]), float(t["b"])
        ])[0]))
        reference_l.append(float(
            _reference_lab_from_anchor(r)[0]
        ))
        weights.append(max(1e-4, float(row.get("weight", 1.0))) * _tone_weight_scale(float(row.get("q", 0.5)), lightness_balance))

    return (
        np.asarray(target_l, dtype=np.float64),
        np.asarray(reference_l, dtype=np.float64),
        np.asarray(weights, dtype=np.float64),
    )


def _lightness_stage_stats(
    before_rows: List[Dict[str, Any]],
    after_rows: List[Dict[str, Any]],
    lightness_balance: float = 0.0,
) -> Dict[str, float]:
    before_l, reference_l, weights = _row_lightness_arrays(
        before_rows,
        lightness_balance,
    )
    after_l, after_reference_l, after_weights = _row_lightness_arrays(
        after_rows,
        lightness_balance,
    )

    if before_l.size == 0 or after_l.size != before_l.size:
        return {
            "before": 0.0,
            "after": 0.0,
            "gain": 0.0,
            "nonworse_fraction": 0.0,
        }

    if after_reference_l.size == reference_l.size:
        reference_l = 0.5 * (reference_l + after_reference_l)
    if after_weights.size == weights.size:
        weights = np.maximum(weights, after_weights)

    before_error = np.abs(reference_l - before_l)
    after_error = np.abs(reference_l - after_l)
    total = max(1e-9, float(np.sum(weights)))

    before_mean = float(np.sum(before_error * weights) / total)
    after_mean = float(np.sum(after_error * weights) / total)
    nonworse = float(
        np.sum(weights[after_error <= before_error + 0.12]) / total
    )

    return {
        "before": before_mean,
        "after": after_mean,
        "gain": before_mean - after_mean,
        "nonworse_fraction": nonworse,
    }


def _tone_curve_shape_stats(
    curve: Sequence[Sequence[float]],
) -> Dict[str, float]:
    points = np.asarray(curve, dtype=np.float64)
    dx = np.maximum(1.0, np.diff(points[:, 0]))
    dy = np.diff(points[:, 1])
    slopes = dy / dx
    bends = np.abs(np.diff(slopes))

    return {
        "min_slope": float(np.min(slopes)) if slopes.size else 1.0,
        "max_slope": float(np.max(slopes)) if slopes.size else 1.0,
        "max_bend": float(np.max(bends)) if bends.size else 0.0,
        "shadow_offset_32": float(
            np.interp(32.0, points[:, 0], points[:, 1]) - 32.0
        ),
        "shadow_offset_48": float(
            np.interp(48.0, points[:, 0], points[:, 1]) - 48.0
        ),
    }


def _tone_lightness_loss(
    rows: List[Dict[str, Any]],
    params: Sequence[float],
    lightness_balance: float = 0.0,
    cached_before: Optional[Tuple[np.ndarray, np.ndarray, np.ndarray]] = None,
) -> float:
    curve = _tone_curve_points(params)
    after = _rows_after_tone_curve(rows, curve)
    shape = _tone_curve_shape_stats(curve)

    if cached_before is None:
        before_l, reference_l, weights = _row_lightness_arrays(
            rows,
            lightness_balance,
        )
    else:
        before_l, reference_l, weights = cached_before
    after_l, _, _ = _row_lightness_arrays(after, lightness_balance)

    after_error = np.abs(reference_l - after_l)
    total = max(1e-9, float(np.sum(weights)))
    light_after = float(np.sum(after_error * weights) / total)

    shadow_mask = before_l < 50.0
    shadow_error = 0.0
    if np.any(shadow_mask):
        sw = weights[shadow_mask]
        shadow_error = float(
            np.sum(
                np.abs(
                    reference_l[shadow_mask]
                    - after_l[shadow_mask]
                )
                * sw
            )
            / max(1e-9, float(np.sum(sw)))
        )

    shadow, mid, high = [float(v) for v in params[:3]]
    regularization = (
        0.004 * shadow * shadow
        + 0.012 * mid * mid
        + 0.008 * high * high
        + 2.6 * shape["max_bend"]
        + 0.04 * abs(shape["shadow_offset_48"])
        + 0.04 * abs(shape["shadow_offset_32"])
    )

    if shape["min_slope"] < 0.78:
        regularization += (0.78 - shape["min_slope"]) * 8.0
    if shape["max_slope"] > 1.24:
        regularization += (shape["max_slope"] - 1.24) * 8.0

    # Low-q skin samples have intentionally small global weights elsewhere.
    # A small dedicated term prevents Tone from ignoring a genuine uniform
    # shadow mismatch while still keeping highlights/midtones dominant.
    return float(
        light_after
        + 0.35 * shadow_error
        + regularization
    )


def _fit_tone_params(
    rows: List[Dict[str, Any]],
    lightness_balance: float = 0.0,
    initial_params: Optional[Sequence[float]] = None,
) -> np.ndarray:
    target_l, reference_l, weights = _row_lightness_arrays(
        rows,
        lightness_balance,
    )
    delta_l = reference_l - target_l
    total = max(1e-9, float(np.sum(weights)))

    shadow_mask = target_l < 50.0
    mid_mask = (target_l >= 45.0) & (target_l < 72.0)
    high_mask = target_l >= 72.0

    def weighted_delta(mask: np.ndarray, fallback: float) -> float:
        if np.any(mask):
            ww = weights[mask]
            return float(
                np.sum(delta_l[mask] * ww)
                / max(1e-9, float(np.sum(ww)))
            )
        return fallback

    overall = float(np.sum(delta_l * weights) / total)
    shadow_dl = weighted_delta(shadow_mask, overall)
    mid_dl = weighted_delta(mid_mask, overall)
    high_dl = weighted_delta(high_mask, overall)

    seeded = np.asarray([
        np.clip(
            shadow_dl * 1.65,
            -TONE_SHADOW_LIMIT,
            TONE_SHADOW_LIMIT,
        ),
        np.clip(
            mid_dl * 1.8,
            -TONE_MID_LIMIT,
            TONE_MID_LIMIT,
        ),
        np.clip(
            high_dl * 2.0,
            -TONE_HIGH_LIMIT,
            TONE_HIGH_LIMIT,
        ),
    ], dtype=np.float64)
    if initial_params is not None:
        initial = np.asarray(initial_params, dtype=np.float64)
        if initial.shape == seeded.shape:
            params = 0.45 * seeded + 0.55 * initial
        else:
            params = seeded
    else:
        params = seeded

    tone_loss_cache = _row_lightness_arrays(rows, lightness_balance)
    best = _tone_lightness_loss(
        rows, params, lightness_balance, tone_loss_cache
    )
    bounds = [
        (-TONE_SHADOW_LIMIT, TONE_SHADOW_LIMIT),
        (-TONE_MID_LIMIT, TONE_MID_LIMIT),
        (-TONE_HIGH_LIMIT, TONE_HIGH_LIMIT),
    ]

    for steps in (
        (1.0, 2.0, 3.0),
        (0.5, 1.0, 1.5),
        (0.25, 0.5, 0.75),
        (0.12, 0.25, 0.35),
    ):
        changed = True
        rounds = 0
        while changed and rounds < 6:
            changed = False
            rounds += 1
            for index, step in enumerate(steps):
                for sign in (-1.0, 1.0):
                    candidate = params.copy()
                    candidate[index] = float(np.clip(
                        candidate[index] + sign * step,
                        bounds[index][0],
                        bounds[index][1],
                    ))
                    score = _tone_lightness_loss(
                        rows, candidate, lightness_balance, tone_loss_cache
                    )
                    if score < best - 1e-8:
                        params, best, changed = (
                            candidate,
                            score,
                            True,
                        )

    return params.copy()


def _optimize_lightness_tone(
    rows: List[Dict[str, Any]],
    minimum_gain: float,
    lightness_balance: float = 0.0,
) -> Tuple[List[List[int]], Dict[str, Any]]:
    """Fit a weak 3-band Composite Curve from Lab L* error only."""
    if not rows:
        identity = [[0, 0], [255, 255]]
        return identity, {
            "used": False,
            "delta_e_before": 0.0,
            "delta_e_after": 0.0,
            "lightness_before": 0.0,
            "lightness_after": 0.0,
            "lightness_gain": 0.0,
            "strength": 0.0,
            "shadow_offset": 0.0,
            "mid_offset": 0.0,
            "high_offset": 0.0,
            "max_bend": 0.0,
        }

    neutral_params = _fit_tone_params(rows, 0.0)
    baseline_de = float(_rows_delta_e_identity(rows))
    baseline_light = _lightness_stage_stats(rows, rows)

    def tone_candidate(
        fitted_params: np.ndarray,
        strength: float,
        balance_value: float,
        shadow_priority: float,
    ) -> Dict[str, Any]:
        scaled = np.asarray(fitted_params, dtype=np.float64) * float(strength)
        curve = _tone_curve_points(scaled)
        after_rows = _rows_after_tone_curve(rows, curve)
        de_stats = _stage_stats(rows, after_rows)
        l_stats = _lightness_stage_stats(
            rows,
            after_rows,
            balance_value,
        )
        shape = _tone_curve_shape_stats(curve)
        safe = bool(
            de_stats["gain"] + 1e-9
            >= max(0.0, float(minimum_gain))
            and de_stats["nonworse_fraction"] >= 0.68
            and de_stats["p75_worsening"] <= 0.20
            and l_stats["gain"] > 0.0
            and l_stats["nonworse_fraction"] >= 0.72
            and shape["min_slope"] >= 0.76
            and shape["max_slope"] <= 1.26
            and shape["max_bend"] <= 0.24
            and abs(shape["shadow_offset_32"])
                <= 2.50 + 0.55 * shadow_priority
            and abs(shape["shadow_offset_48"])
                <= 3.80 + 0.80 * shadow_priority
        )
        return {
            "strength": float(strength),
            "params": scaled,
            "curve": curve,
            "de": de_stats,
            "light": l_stats,
            "shape": shape,
            "safe": safe,
        }

    strength_grid = (0.25, 0.40, 0.55, 0.70, 0.85, 1.00)

    # Determine overall Tone strength once from the neutral Auto objective.
    # Shadows/Highlights is a balance control, not a second strength control:
    # moving it must redistribute the fitted three-band shape without silently
    # switching the whole Tone layer to a stronger candidate.
    neutral_candidates = [
        tone_candidate(neutral_params, strength, 0.0, 0.0)
        for strength in strength_grid
    ]
    neutral_safe = [item for item in neutral_candidates if item["safe"]]
    if not neutral_safe:
        identity = [[0, 0], [255, 255]]
        return identity, {
            "used": False,
            "delta_e_before": baseline_de,
            "delta_e_after": baseline_de,
            "lightness_before": float(baseline_light["before"]),
            "lightness_after": float(baseline_light["before"]),
            "lightness_gain": 0.0,
            "strength": 0.0,
            "shadow_offset": 0.0,
            "mid_offset": 0.0,
            "high_offset": 0.0,
            "max_bend": 0.0,
        }

    best_neutral_gain = max(
        float(item["light"]["gain"]) for item in neutral_safe
    )
    neutral_eligible = [
        item for item in neutral_safe
        if float(item["light"]["gain"]) + 1e-9
        >= best_neutral_gain * 0.90
    ]
    neutral_chosen = min(
        neutral_eligible or neutral_safe,
        key=lambda item: (
            float(item["strength"]),
            float(item["light"]["after"]),
        ),
    )

    requested_bias = _normalized_percent_bias(lightness_balance)
    neutral_strength = float(neutral_chosen["strength"])

    def candidate_for_balance(bias: float) -> Dict[str, Any]:
        shadow_focus = max(0.0, -float(bias))
        highlight_focus = max(0.0, float(bias))
        fitted = _fit_tone_params(
            rows,
            float(bias) * 100.0,
            neutral_params,
        )
        # Keep the control smooth near zero while allowing the endpoints to
        # visibly reshape the curve.  The optimizer provides a bias-aware
        # target; interpolation prevents a new local minimum from causing a
        # sudden jump close to Auto.
        blend = float(abs(float(bias)) ** 0.80)
        balanced = neutral_params * (1.0 - blend) + fitted * blend
        balanced[0] = float(np.clip(
            balanced[0] * (
                1.0
                + 0.75 * shadow_focus
                - 0.45 * highlight_focus
            ),
            -TONE_SHADOW_HARD_LIMIT,
            TONE_SHADOW_HARD_LIMIT,
        ))
        balanced[1] *= 1.0 - 0.18 * abs(float(bias))
        balanced[2] = float(np.clip(
            balanced[2] * (
                1.0
                + 0.60 * highlight_focus
                - 0.35 * shadow_focus
            ),
            -TONE_HIGH_HARD_LIMIT,
            TONE_HIGH_HARD_LIMIT,
        ))
        return tone_candidate(
            balanced,
            neutral_strength,
            float(bias) * 100.0,
            shadow_focus,
        )

    if abs(requested_bias) < 1e-12:
        chosen = neutral_chosen
    else:
        requested_candidate = candidate_for_balance(requested_bias)
        if requested_candidate["safe"]:
            chosen = requested_candidate
        else:
            # Do not disable Tone or abruptly drop its overall strength when an
            # extreme Shadows/Highlights request reaches a hard safety gate.
            # Instead find the strongest safe fraction of the requested tonal
            # bias.  The control therefore saturates smoothly at the safety
            # boundary rather than jumping to a different correction.
            low = 0.0
            high = 1.0
            chosen = neutral_chosen
            for _ in range(12):
                mid = 0.5 * (low + high)
                candidate = candidate_for_balance(requested_bias * mid)
                if candidate["safe"]:
                    chosen = candidate
                    low = mid
                else:
                    high = mid

    chosen_params = chosen["params"]
    chosen_de = chosen["de"]
    chosen_shape = chosen["shape"]

    chosen_report_rows = _rows_after_tone_curve(
        rows,
        chosen["curve"],
    )
    chosen_light = _lightness_stage_stats(
        rows,
        chosen_report_rows,
        0.0,
    )

    return chosen["curve"], {
        "used": True,
        "delta_e_before": float(chosen_de["before"]),
        "delta_e_after": float(chosen_de["after"]),
        "delta_e_gain": float(chosen_de["gain"]),
        "lightness_before": float(
            chosen_light["before"]
        ),
        "lightness_after": float(
            chosen_light["after"]
        ),
        "lightness_gain": float(
            chosen_light["gain"]
        ),
        "lightness_nonworse_fraction": float(
            chosen_light["nonworse_fraction"]
        ),
        "strength": float(chosen["strength"]),
        "shadow_offset": float(chosen_params[0]),
        "mid_offset": float(chosen_params[1]),
        "high_offset": float(chosen_params[2]),
        "min_slope": float(
            chosen_shape["min_slope"]
        ),
        "max_slope": float(
            chosen_shape["max_slope"]
        ),
        "max_bend": float(
            chosen_shape["max_bend"]
        ),
        "shadow_offset_32": float(
            chosen_shape["shadow_offset_32"]
        ),
        "shadow_offset_48": float(
            chosen_shape["shadow_offset_48"]
        ),
    }


def _smooth_tone_curves(
    composite: Sequence[Sequence[float]],
) -> Dict[str, List[List[int]]]:
    identity = [[0, 0], [255, 255]]
    return {
        "composite": [[int(p[0]), int(p[1])] for p in composite],
        "red": identity,
        "green": identity,
        "blue": identity,
    }


# ---------------------------------------------------------------------------
# Smooth skin match model in Lab.
# Photoshop still receives an ordinary RGB->RGB Color Lookup profile.
# ---------------------------------------------------------------------------
def _smooth_weighted_series(
    values: np.ndarray,
    weights: np.ndarray,
    regularization: float = 1.8,
) -> np.ndarray:
    values = np.asarray(values, dtype=np.float64).reshape(-1)
    weights = np.maximum(1e-4, np.asarray(weights, dtype=np.float64).reshape(-1))
    n = int(values.size)
    if n <= 2:
        return values.copy()

    W = np.diag(weights / max(1e-9, float(np.max(weights))))
    D = np.zeros((n - 2, n), dtype=np.float64)
    for i in range(n - 2):
        D[i, i:i + 3] = [1.0, -2.0, 1.0]
    A = W + float(regularization) * (D.T @ D) + np.eye(n) * 0.035
    b = W @ values
    try:
        return np.linalg.solve(A, b)
    except np.linalg.LinAlgError:
        return np.linalg.lstsq(A, b, rcond=None)[0]



def _limit_smooth_lightness_delta(
    l_nodes: np.ndarray,
    values: np.ndarray,
    max_delta_slope: float = 0.085,
) -> np.ndarray:
    """Limit d(ΔL*)/dL* so local skin contrast stays monotonic and smooth.

    This does not suppress the overall lightness correction. It only prevents
    adjacent tonal bands from receiving sharply different L* offsets.
    """
    x = np.asarray(l_nodes, dtype=np.float64)
    y = np.asarray(values, dtype=np.float64).copy()
    if y.size < 2:
        return y

    for _ in range(3):
        for i in range(1, y.size):
            limit = max(0.08, abs(float(x[i] - x[i - 1])) * float(max_delta_slope))
            y[i] = float(np.clip(y[i], y[i - 1] - limit, y[i - 1] + limit))
        for i in range(y.size - 2, -1, -1):
            limit = max(0.08, abs(float(x[i + 1] - x[i])) * float(max_delta_slope))
            y[i] = float(np.clip(y[i], y[i + 1] - limit, y[i + 1] + limit))
    return y



def _limit_smooth_hue_delta(
    l_nodes: np.ndarray,
    values: np.ndarray,
    max_degrees_per_l: float = 0.62,
) -> np.ndarray:
    """Limit d(Δh)/dL* so skin hue changes smoothly through the tonal range."""
    x = np.asarray(l_nodes, dtype=np.float64)
    y = np.asarray(values, dtype=np.float64).copy()
    if y.size < 2:
        return y

    slope = math.radians(float(max_degrees_per_l))
    min_step = math.radians(0.35)
    for _ in range(3):
        for i in range(1, y.size):
            limit = max(
                min_step,
                abs(float(x[i] - x[i - 1])) * slope,
            )
            y[i] = float(np.clip(
                y[i],
                y[i - 1] - limit,
                y[i - 1] + limit,
            ))
        for i in range(y.size - 2, -1, -1):
            limit = max(
                min_step,
                abs(float(x[i + 1] - x[i])) * slope,
            )
            y[i] = float(np.clip(
                y[i],
                y[i + 1] - limit,
                y[i + 1] + limit,
            ))
    return y


def _shadow_lightening_gate(l_value: float) -> float:
    """Suppress positive local L* residuals in facial shadows.

    Smooth Tone is the global brightness tool. Skin Match may retain a smooth
    residual lightness correction, but dark skin must not be lifted locally
    because that flattens facial contrast and looks like a broken curve.
    """
    return float(
        0.03
        + 0.97
        * float(_smoothstep(
            np.asarray([float(l_value)]),
            46.0,
            64.0,
        )[0])
    )


def _unit_ab_from_lab(lab: Sequence[float], fallback: Sequence[float]) -> np.ndarray:
    """Return a stable unit vector in the Lab a/b plane.

    Chroma scaling should follow the current hue direction. Near neutrals the
    hue is unstable, so a measured fallback direction is used instead.
    """
    labv = np.asarray(lab, dtype=np.float64)
    ab = np.asarray(labv[1:3], dtype=np.float64)
    chroma = float(math.hypot(ab[0], ab[1]))
    if chroma >= 1.0:
        return ab / chroma
    fallback_v = np.asarray(fallback, dtype=np.float64).reshape(2)
    norm = float(np.linalg.norm(fallback_v))
    if norm <= 1e-9:
        return np.asarray([1.0, 0.0], dtype=np.float64)
    return fallback_v / norm


def _unit_ab_from_lab_array(labs: np.ndarray, fallback: Sequence[float]) -> np.ndarray:
    values = np.asarray(labs, dtype=np.float64).reshape(-1, 3)
    ab = values[:, 1:3]
    chroma = np.sqrt(np.sum(ab ** 2, axis=1))
    out = np.empty_like(ab)
    mask = chroma >= 1.0
    if np.any(mask):
        out[mask] = ab[mask] / chroma[mask, None]
    fallback_v = np.asarray(fallback, dtype=np.float64).reshape(2)
    norm = float(np.linalg.norm(fallback_v))
    if norm <= 1e-9:
        fallback_unit = np.asarray([1.0, 0.0], dtype=np.float64)
    else:
        fallback_unit = fallback_v / norm
    if np.any(~mask):
        out[~mask] = fallback_unit.reshape(1, 2)
    return out


def _fit_smooth_skin_model_once(
    rows: List[Dict[str, Any]],
    orthogonalize_lightness: bool = False,
) -> Optional[Dict[str, Any]]:
    """Smooth LCh-like skin base + weak local chroma RBF residual.

    The broad skin-colour transform is deliberately interpretable:
      1) smooth residual ΔL*(L*),
      2) smooth multiplicative chroma gain C*×g(L*) for saturation,
      3) smooth angular Δh(L*) for hue,
      4) a weak local chroma-only RBF for small remaining a/b errors.

    This avoids asking independent smooth Δa/Δb curves to represent both hue
    and saturation at the same time, which could make neighbouring skin tones
    move in subtly inconsistent directions.
    """
    if len(rows) < 6:
        return None

    src_rgb = np.asarray(
        [
            [float(row["target"][k]) for k in ("r", "g", "b")]
            for row in rows
        ],
        dtype=np.float64,
    )
    weights = np.asarray(
        [
            max(0.02, float(row.get("weight", 1.0)))
            for row in rows
        ],
        dtype=np.float64,
    )
    src_lab = _lab_array_from_rgb(src_rgb)
    ref_lab = np.asarray(
        [
            _reference_lab_from_anchor(row["reference"])
            for row in rows
        ],
        dtype=np.float64,
    )

    desired = ref_lab - src_lab
    desired[:, 0] = np.clip(desired[:, 0], -3.5, 3.5)
    desired[:, 1:] = np.clip(desired[:, 1:], -12.0, 12.0)

    src_chroma = np.sqrt(
        np.sum(src_lab[:, 1:3] ** 2, axis=1)
    )
    ref_chroma = np.sqrt(
        np.sum(ref_lab[:, 1:3] ** 2, axis=1)
    )

    # Saturation/chroma is fundamentally closer to a SCALE mismatch than to
    # an additive a/b offset. The old additive ΔC was capped at about ±6 C*,
    # which made strongly over/under-saturated real photographs barely move.
    #
    # Fit a smooth multiplicative gain in log space instead. A small chroma
    # prior prevents unstable ratios close to the neutral axis.
    chroma_prior = 1.0
    desired_log_chroma_gain = np.log(np.clip(
        (ref_chroma + chroma_prior)
        / (src_chroma + chroma_prior),
        0.40,
        2.15,
    ))

    src_hue = np.arctan2(src_lab[:, 2], src_lab[:, 1])
    ref_hue = np.arctan2(ref_lab[:, 2], ref_lab[:, 1])
    desired_hue = np.arctan2(
        np.sin(ref_hue - src_hue),
        np.cos(ref_hue - src_hue),
    )
    desired_hue = np.clip(
        desired_hue,
        -math.radians(18.0),
        math.radians(18.0),
    )

    # Hue becomes unstable close to the neutral axis. Such points may still
    # contribute to L*/C*, but they should have very little influence on Δh.
    hue_confidence = np.minimum(
        _smoothstep(src_chroma, 5.0, 15.0),
        _smoothstep(ref_chroma, 5.0, 15.0),
    )

    grouped = []
    for q in sorted(
        set(round(float(row.get("q", 0.0)), 2) for row in rows)
    ):
        idx = np.asarray(
            [
                i for i, row in enumerate(rows)
                if round(float(row.get("q", 0.0)), 2) == q
            ],
            dtype=np.int32,
        )
        if idx.size == 0:
            continue

        w = weights[idx]
        hue_w = w * np.maximum(0.05, hue_confidence[idx])
        grouped.append((
            q,
            weighted_median(
                src_lab[idx, 0].tolist(),
                w.tolist(),
            ),
            weighted_median(
                desired[idx, 0].tolist(),
                w.tolist(),
            ),
            weighted_median(
                desired_log_chroma_gain[idx].tolist(),
                w.tolist(),
            ),
            weighted_median(
                desired_hue[idx].tolist(),
                hue_w.tolist(),
            ),
            float(np.sum(w)),
        ))

    if len(grouped) < 3:
        return None

    grouped.sort(key=lambda item: item[1])
    l_nodes = np.asarray(
        [row[1] for row in grouped],
        dtype=np.float64,
    )
    dl_raw = np.asarray(
        [row[2] for row in grouped],
        dtype=np.float64,
    )
    dlogc_raw = np.asarray(
        [row[3] for row in grouped],
        dtype=np.float64,
    )
    dh_raw = np.asarray(
        [row[4] for row in grouped],
        dtype=np.float64,
    )
    node_weights = np.asarray(
        [row[5] for row in grouped],
        dtype=np.float64,
    )

    # Global Tone owns broad L* offset/slope. When Tone was accepted, remove
    # most of that low-order trend from Skin Match and keep residual curvature.
    removed_lightness_trend = np.zeros_like(dl_raw)
    if orthogonalize_lightness and len(dl_raw) >= 3:
        l_center = float(
            np.average(l_nodes, weights=node_weights)
        )
        l_scale = max(8.0, float(np.ptp(l_nodes)))
        x = (l_nodes - l_center) / l_scale
        design = np.column_stack([np.ones_like(x), x])
        sw = np.sqrt(np.maximum(node_weights, 1e-6))
        try:
            coeff, *_ = np.linalg.lstsq(
                design * sw[:, None],
                dl_raw * sw,
                rcond=None,
            )
            global_trend = design @ coeff
            removed_lightness_trend = 0.50 * global_trend
            dl_raw = dl_raw - removed_lightness_trend
        except np.linalg.LinAlgError:
            pass

    dl = np.clip(
        _smooth_weighted_series(
            dl_raw,
            node_weights,
            3.4,
        ),
        -2.8 if orthogonalize_lightness else -3.2,
        2.8 if orthogonalize_lightness else 3.2,
    )
    dl = _limit_smooth_lightness_delta(
        l_nodes,
        dl,
        max_delta_slope=0.085,
    )

    # Saturation/chroma stays radial in a/b, but is now multiplicative.
    # The supported range is deliberately broad enough to fix clearly
    # over/under-saturated photographs while remaining bounded.
    dlogc = np.clip(
        _smooth_weighted_series(
            dlogc_raw,
            node_weights,
            1.00,
        ),
        math.log(0.45),
        math.log(2.10),
    )
    dlogc = _limit_smooth_lightness_delta(
        l_nodes,
        dlogc,
        max_delta_slope=0.020,
    )

    # Hue is an explicit smooth angular field, rather than an implicit
    # combination of two unrelated Δa/Δb series.
    dh = np.clip(
        _smooth_weighted_series(
            dh_raw,
            node_weights,
            1.85,
        ),
        -math.radians(15.0),
        math.radians(15.0),
    )
    dh = _limit_smooth_hue_delta(
        l_nodes,
        dh,
        max_degrees_per_l=0.62,
    )

    spacing = np.diff(l_nodes)
    l_sigma = max(
        6.5,
        float(np.median(spacing)) * 1.35
        if spacing.size else 9.0,
    )

    ab = src_lab[:, 1:3]
    ab_center = np.median(ab, axis=0)
    centered = ab - ab_center.reshape(1, 2)
    if len(ab) >= 3:
        cov = np.cov(
            centered.T,
            aweights=np.maximum(weights, 1e-4),
        )
        cov = np.asarray(
            cov,
            dtype=np.float64,
        ).reshape(2, 2)
    else:
        cov = np.eye(2, dtype=np.float64) * 16.0
    cov += np.eye(2, dtype=np.float64) * 8.0
    try:
        inv_cov = np.linalg.inv(cov)
    except np.linalg.LinAlgError:
        inv_cov = np.linalg.pinv(cov)

    ab_unit_fallback = np.median(
        src_lab[:, 1:3],
        axis=0,
    )
    fallback_norm = float(np.linalg.norm(ab_unit_fallback))
    if fallback_norm <= 1e-9:
        ab_unit_fallback = np.asarray(
            [1.0, 0.0],
            dtype=np.float64,
        )
    else:
        ab_unit_fallback = (
            ab_unit_fallback / fallback_norm
        )

    model: Dict[str, Any] = {
        "l_nodes": l_nodes,
        "delta_l": dl,
        "log_chroma_gain": dlogc,
        "delta_h": dh,
        "node_weights": node_weights,
        "l_sigma": float(l_sigma),
        "src_lab": src_lab,
        "weights": weights,
        "ab_center": ab_center,
        "ab_unit_fallback": ab_unit_fallback,
        "inv_cov": inv_cov,
        "l_low": float(
            np.percentile(src_lab[:, 0], 3.0) - 8.0
        ),
        "l_high": float(
            np.percentile(src_lab[:, 0], 97.0) + 8.0
        ),
        "rbf_sigma_l": 9.0,
        "rbf_sigma_ab": 11.5,
        "orthogonalized_lightness": bool(
            orthogonalize_lightness
        ),
        "removed_lightness_trend": (
            removed_lightness_trend
        ),
        "colour_model": "LChGain+Hue+RBF",
    }

    # Fit only the small remaining full-Lab error around the LCh base. The
    # local residual remains chroma-only so it cannot create tonal bumps.
    base_at_samples = np.asarray(
        [
            _smooth_skin_base_delta_lab(lab, model)
            for lab in src_lab
        ],
        dtype=np.float64,
    )
    rbf_residual = desired - base_at_samples
    rbf_residual[:, 0] = 0.0

    # The smooth multiplicative chroma field owns saturation. The local RBF
    # should mainly correct HUE/local direction, otherwise a generic a/b
    # residual can accidentally inject a strong radial C* increase.
    corrected_sample_ab = (
        src_lab[:, 1:3] + base_at_samples[:, 1:3]
    )
    corrected_sample_c = np.sqrt(
        np.sum(corrected_sample_ab ** 2, axis=1)
    )
    radial_unit = np.zeros_like(corrected_sample_ab)
    radial_mask = corrected_sample_c >= 1.0
    if np.any(radial_mask):
        radial_unit[radial_mask] = (
            corrected_sample_ab[radial_mask]
            / corrected_sample_c[radial_mask, None]
        )
    if np.any(~radial_mask):
        radial_unit[~radial_mask] = (
            ab_unit_fallback.reshape(1, 2)
        )

    residual_ab = rbf_residual[:, 1:3]
    radial_amount = np.sum(
        residual_ab * radial_unit,
        axis=1,
    )
    tangential = (
        residual_ab
        - radial_amount[:, None] * radial_unit
    )
    # Keep only a very small radial fine correction; allow more tangential
    # freedom for hue/local colour direction.
    radial_amount = np.clip(
        radial_amount,
        -0.70,
        0.70,
    )
    tangential_norm = np.sqrt(
        np.sum(tangential ** 2, axis=1)
    )
    tangential_scale = np.minimum(
        1.0,
        2.6 / np.maximum(tangential_norm, 1e-9),
    )
    tangential *= tangential_scale[:, None]
    rbf_residual[:, 1:3] = (
        tangential
        + radial_amount[:, None] * radial_unit
    )

    model["rbf_centers"] = src_lab
    model["rbf_residuals"] = rbf_residual
    return model


def _fit_smooth_skin_model(
    rows: List[Dict[str, Any]],
    orthogonalize_lightness: bool = False,
) -> Optional[Dict[str, Any]]:
    """Fit once, then robustly downweight isolated bad correspondences once.

    This is a single IRLS-style refinement, not an iterative optimizer. A
    specular reflection or local colour contamination can no longer pull the
    entire skin model as strongly, while coherent global differences keep
    their full weight.
    """
    model = _fit_smooth_skin_model_once(
        rows,
        orthogonalize_lightness=orthogonalize_lightness,
    )
    if model is None or len(rows) < 10:
        return model

    # Detect outliers against the SMOOTH base, before the local RBF has a
    # chance to explain them. This targets isolated reflections/contamination
    # rather than systematically downweighting legitimate shadow/highlight
    # rows where the safety gate intentionally attenuates the final LUT.
    src_rgb = np.asarray([
        [float(row["target"][k]) for k in ("r", "g", "b")]
        for row in rows
    ], dtype=np.float64)
    src_lab = _lab_array_from_rgb(src_rgb)
    ref_lab = np.asarray(
        [
            _reference_lab_from_anchor(row["reference"])
            for row in rows
        ],
        dtype=np.float64,
    )
    desired = ref_lab - src_lab
    smooth_prediction = np.asarray([
        _smooth_skin_base_delta_lab(lab, model)
        for lab in src_lab
    ], dtype=np.float64)
    residual = np.sqrt(np.sum(
        (desired - smooth_prediction) ** 2,
        axis=1,
    ))
    if residual.size < 6:
        return model

    median = float(np.median(residual))
    mad = float(np.median(np.abs(residual - median)))
    robust_sigma = max(0.35, 1.4826 * mad)
    cutoff = max(3.0, median + 2.50 * robust_sigma)

    factors = np.ones_like(residual, dtype=np.float64)
    high = residual > cutoff
    if np.any(high):
        factors[high] = np.clip(
            cutoff / np.maximum(residual[high], 1e-6),
            0.28,
            1.0,
        )

    if float(np.min(factors)) >= 0.94:
        model["robust_downweighted"] = 0
        return model

    robust_rows: List[Dict[str, Any]] = []
    for row, factor in zip(rows, factors):
        item = dict(row)
        item["weight"] = max(
            0.01,
            float(row.get("weight", 1.0)) * float(factor),
        )
        robust_rows.append(item)

    refined = _fit_smooth_skin_model_once(
        robust_rows,
        orthogonalize_lightness=orthogonalize_lightness,
    )
    if refined is None:
        return model
    refined["robust_downweighted"] = int(np.count_nonzero(factors < 0.94))
    refined["robust_cutoff"] = float(cutoff)
    return refined


def _smooth_skin_base_delta_lab(
    lab: Sequence[float],
    model: Dict[str, Any],
) -> np.ndarray:
    labv = np.asarray(lab, dtype=np.float64)
    l_nodes = np.asarray(
        model["l_nodes"],
        dtype=np.float64,
    )

    delta_l = float(np.interp(
        labv[0],
        l_nodes,
        np.asarray(
            model["delta_l"],
            dtype=np.float64,
        ),
    ))
    log_chroma_gain = float(np.interp(
        labv[0],
        l_nodes,
        np.asarray(
            model.get(
                "log_chroma_gain",
                np.zeros_like(l_nodes),
            ),
            dtype=np.float64,
        ),
    ))
    delta_h = float(np.interp(
        labv[0],
        l_nodes,
        np.asarray(
            model.get(
                "delta_h",
                np.zeros_like(l_nodes),
            ),
            dtype=np.float64,
        ),
    ))

    ab = np.asarray(labv[1:3], dtype=np.float64)
    chroma = float(np.linalg.norm(ab))
    unit_ab = _unit_ab_from_lab(
        labv,
        np.asarray(
            model.get(
                "ab_unit_fallback",
                [1.0, 0.0],
            ),
            dtype=np.float64,
        ),
    )
    hue = math.atan2(
        float(unit_ab[1]),
        float(unit_ab[0]),
    )
    chroma_gain = float(np.clip(
        math.exp(log_chroma_gain),
        0.45,
        2.10,
    ))
    corrected_chroma = max(0.0, chroma * chroma_gain)
    corrected_hue = hue + delta_h
    corrected_ab = np.asarray([
        corrected_chroma * math.cos(corrected_hue),
        corrected_chroma * math.sin(corrected_hue),
    ], dtype=np.float64)

    return np.asarray([
        delta_l,
        corrected_ab[0] - ab[0],
        corrected_ab[1] - ab[1],
    ], dtype=np.float64)




















def _sample_collateral_pixels(
    full_rgb: Optional[np.ndarray],
    face_bbox: Optional[Sequence[float]],
    max_pixels: int = 3600,
) -> np.ndarray:
    """Sample actual image pixels outside an expanded face area."""
    if full_rgb is None:
        return np.empty((0, 3), dtype=np.float64)

    rgb = np.asarray(full_rgb, dtype=np.uint8)
    if rgb.ndim != 3 or rgb.shape[2] != 3:
        return np.empty((0, 3), dtype=np.float64)

    h, w = rgb.shape[:2]
    mask = np.ones((h, w), dtype=bool)

    if face_bbox and len(face_bbox) >= 4:
        x, y, bw, bh = [float(v) for v in face_bbox[:4]]
        pad_x = bw * 0.35
        pad_y = bh * 0.42
        x0 = max(0, int(math.floor(x - pad_x)))
        y0 = max(0, int(math.floor(y - pad_y)))
        x1 = min(w, int(math.ceil(x + bw + pad_x)))
        y1 = min(h, int(math.ceil(y + bh + pad_y)))
        mask[y0:y1, x0:x1] = False

    pixels = rgb[mask]
    if pixels.size == 0:
        return np.empty((0, 3), dtype=np.float64)

    useful = (
        (np.min(pixels, axis=1) >= 4)
        & (np.max(pixels, axis=1) <= 251)
    )
    pixels = pixels[useful]
    if pixels.shape[0] == 0:
        return np.empty((0, 3), dtype=np.float64)

    if pixels.shape[0] > int(max_pixels):
        step = int(math.ceil(
            pixels.shape[0] / float(max_pixels)
        ))
        pixels = pixels[::step][:int(max_pixels)]
    return pixels.astype(np.float64)


def _prepare_collateral_pixels(
    pixels: np.ndarray,
    tone_curve: Optional[Sequence[Sequence[float]]],
    wb_curves: Optional[Dict[str, Sequence[Sequence[float]]]] = None,
) -> np.ndarray:
    arr = np.asarray(pixels, dtype=np.float64).reshape(-1, 3)
    if arr.shape[0] == 0:
        return arr

    out = np.empty_like(arr)
    for i, rgb in enumerate(arr):
        value: Sequence[float] = rgb.tolist()
        if wb_curves:
            value = _apply_curve_set_rgb(value, wb_curves)
        if tone_curve:
            value = _apply_composite_curve_rgb(value, tone_curve)
        out[i] = np.asarray(value, dtype=np.float64)
    return np.clip(out, 0.0, 255.0)


def _apply_curve_set_array(
    pixels: np.ndarray,
    curves: Dict[str, Sequence[Sequence[float]]],
) -> np.ndarray:
    arr = np.asarray(pixels, dtype=np.float64).reshape(-1, 3)
    if arr.shape[0] == 0:
        return arr.copy()
    return np.asarray([
        _apply_curve_set_rgb(rgb, curves) for rgb in arr
    ], dtype=np.float64)


def _global_stage_pixel_safety(
    before: np.ndarray,
    after: np.ndarray,
    protection_bias: float = 0.0,
) -> Dict[str, Any]:
    src = np.asarray(before, dtype=np.float64).reshape(-1, 3)
    dst = np.asarray(after, dtype=np.float64).reshape(-1, 3)
    if src.shape[0] == 0 or dst.shape != src.shape:
        return {
            "safe": True,
            "count": 0,
            "new_clipping_fraction": 0.0,
        }
    interior = np.all((src > 2.0) & (src < 253.0), axis=1)
    newly_clipped = interior & np.any(
        (dst <= 0.5) | (dst >= 254.5),
        axis=1,
    )
    count = max(1, int(np.count_nonzero(interior)))
    fraction = float(np.count_nonzero(newly_clipped) / count)
    accuracy = _accuracy_profile_mix(protection_bias)
    safety = max(0.0, _normalized_percent_bias(protection_bias))
    limit = _lerp(0.008 - 0.003 * safety, 0.025, accuracy)
    return {
        "safe": bool(fraction <= limit),
        "count": int(src.shape[0]),
        "new_clipping_fraction": fraction,
    }


def _strength_grid(
    max_strength: float,
    step: float = 0.05,
) -> Tuple[float, ...]:
    maximum = max(0.0, float(max_strength))
    increment = max(1e-6, float(step))
    count = int(math.floor((maximum + 1e-10) / increment))
    values = [
        round(index * increment, 6)
        for index in range(1, count + 1)
        if index * increment <= maximum + 1e-10
    ]
    if not values or maximum - values[-1] > 1e-6:
        values.append(round(maximum, 6))
    else:
        values[-1] = round(maximum, 6)
    return tuple(
        value
        for index, value in enumerate(values)
        if value > 0.0
        and (index == 0 or value > values[index - 1] + 1e-9)
    )





def _smooth_skin_delta_lab_array(
    labs: np.ndarray,
    model: Dict[str, Any],
    chunk_size: int = 8192,
) -> np.ndarray:
    """Vectorized equivalent of _smooth_skin_delta_lab for LUT compilation."""
    values = np.asarray(labs, dtype=np.float64).reshape(-1, 3)
    result = np.zeros_like(values)

    l_nodes = np.asarray(model["l_nodes"], dtype=np.float64)
    delta_l = np.asarray(model["delta_l"], dtype=np.float64)
    log_chroma_gain = np.asarray(
        model.get(
            "log_chroma_gain",
            np.zeros_like(l_nodes),
        ),
        dtype=np.float64,
    )
    delta_h = np.asarray(
        model.get("delta_h", np.zeros_like(l_nodes)),
        dtype=np.float64,
    )

    centers = np.asarray(model.get("rbf_centers"), dtype=np.float64)
    residuals = np.asarray(model.get("rbf_residuals"), dtype=np.float64)
    src_lab = np.asarray(model["src_lab"], dtype=np.float64)
    source_weights = np.asarray(model.get("weights"), dtype=np.float64)
    source_weights = source_weights / max(1e-9, float(np.max(source_weights)))

    ab_center = np.asarray(model["ab_center"], dtype=np.float64)
    ab_unit_fallback = np.asarray(model.get("ab_unit_fallback", [1.0, 0.0]), dtype=np.float64)
    inv_cov = np.asarray(model["inv_cov"], dtype=np.float64)
    l_low = float(model["l_low"])
    l_high = float(model["l_high"])
    rbf_sigma_l = max(1e-6, float(model.get("rbf_sigma_l", 9.0)))
    rbf_sigma_ab = max(1e-6, float(model.get("rbf_sigma_ab", 11.5)))

    for start in range(0, values.shape[0], int(chunk_size)):
        stop = min(values.shape[0], start + int(chunk_size))
        lab = values[start:stop]

        # Smooth LCh-like base: residual L*, radial chroma, angular hue.
        unit_ab = _unit_ab_from_lab_array(
            lab,
            ab_unit_fallback,
        )
        chroma = np.sqrt(
            np.sum(lab[:, 1:3] ** 2, axis=1)
        )
        dlogc = np.interp(
            lab[:, 0],
            l_nodes,
            log_chroma_gain,
        )
        dh = np.interp(
            lab[:, 0],
            l_nodes,
            delta_h,
        )
        hue = np.arctan2(
            unit_ab[:, 1],
            unit_ab[:, 0],
        )
        chroma_gain = np.clip(
            np.exp(dlogc),
            0.45,
            2.10,
        )
        corrected_chroma = np.maximum(
            0.0,
            chroma * chroma_gain,
        )
        corrected_hue = hue + dh
        corrected_ab = np.column_stack([
            corrected_chroma * np.cos(corrected_hue),
            corrected_chroma * np.sin(corrected_hue),
        ])
        delta_ab = corrected_ab - lab[:, 1:3]
        base = np.column_stack([
            np.interp(lab[:, 0], l_nodes, delta_l),
            delta_ab,
        ])

        # Local RBF residual.
        dl = lab[:, None, 0] - centers[None, :, 0]
        da = lab[:, None, 1] - centers[None, :, 1]
        db = lab[:, None, 2] - centers[None, :, 2]
        distance2 = (
            (dl / rbf_sigma_l) ** 2
            + (da / rbf_sigma_ab) ** 2
            + (db / rbf_sigma_ab) ** 2
        )
        rbf_kernel = (
            np.exp(-0.5 * distance2)
            * source_weights.reshape(1, -1)
        )
        rbf_support = np.sum(rbf_kernel, axis=1) + 0.55
        rbf = (rbf_kernel @ residuals) / rbf_support[:, None]

        combined = base + rbf
        lightness_cap = max(0.0, float(model.get("max_delta_l", 3.2)))
        combined[:, 0] = np.clip(combined[:, 0], -lightness_cap, lightness_cap)
        positive_l = combined[:, 0] > 0.0
        if np.any(positive_l):
            lift_gate = (
                0.03
                + 0.97 * _smoothstep(
                    lab[:, 0],
                    46.0,
                    64.0,
                )
            )
            combined[positive_l, 0] *= lift_gate[positive_l]
        combined[:, 1:] = np.clip(combined[:, 1:], -18.0, 18.0)

        # Same skin-gamut gate as scalar path.
        ab_delta = lab[:, 1:3] - ab_center.reshape(1, 2)
        mahal2 = np.einsum(
            "ni,ij,nj->n",
            ab_delta,
            inv_cov,
            ab_delta,
        )
        gamut_gate = np.exp(-0.5 * mahal2 / (2.70 ** 2))

        nearest2 = np.min(
            (0.70 * dl) ** 2 + da ** 2 + db ** 2,
            axis=1,
        )
        nearest_gate = np.exp(
            -0.5 * nearest2 / (22.0 ** 2)
        )

        chroma = np.sqrt(
            lab[:, 1] ** 2 + lab[:, 2] ** 2
        )
        neutral_gate = _smoothstep(chroma, 4.5, 12.5)
        color_membership = (
            np.sqrt(np.maximum(0.0, gamut_gate * nearest_gate))
            * neutral_gate
        )

        l_range_gate = (
            _smoothstep(lab[:, 0], l_low, l_low + 9.0)
            * (
                1.0
                - _smoothstep(
                    lab[:, 0],
                    l_high - 9.0,
                    l_high,
                )
            )
        )
        shadow_gate = (
            0.12 * _smoothstep(lab[:, 0], 18.0, 30.0)
            + 0.88 * _smoothstep(lab[:, 0], 30.0, 55.0)
        )
        highlight_gate = (
            1.0
            - 0.82 * _smoothstep(lab[:, 0], 93.0, 99.5)
        )
        tonal_membership = np.minimum(
            l_range_gate,
            np.minimum(shadow_gate, highlight_gate),
        )
        chroma_gate = np.clip(
            color_membership * tonal_membership,
            0.0,
            1.0,
        )

        gamut_gate_l = np.exp(
            -0.5 * mahal2 / (3.25 ** 2)
        )
        nearest_ab2 = np.min(
            da ** 2 + db ** 2,
            axis=1,
        )
        nearest_gate_l = np.exp(
            -0.5 * nearest_ab2 / (19.0 ** 2)
        )
        neutral_gate_l = _smoothstep(
            chroma,
            4.5,
            12.0,
        )
        color_membership_l = (
            np.sqrt(np.maximum(
                0.0,
                gamut_gate_l * nearest_gate_l,
            ))
            * neutral_gate_l
        )
        shadow_gate_l = _smoothstep(
            lab[:, 0],
            22.0,
            44.0,
        )
        lightness_gate = np.clip(
            color_membership_l * shadow_gate_l,
            0.0,
            1.0,
        )

        result[start:stop, 0] = (
            combined[:, 0] * lightness_gate
        )
        result[start:stop, 1:] = (
            combined[:, 1:]
            * chroma_gate[:, None]
        )

    return result


def _build_smooth_skin_lut(
    model: Dict[str, Any],
    strength: float,
    size: int = 17,
) -> Dict[str, Any]:
    """Compile the smooth Lab model to a native RGB LUT in vectorized form."""
    levels = np.linspace(
        0.0,
        255.0,
        int(size),
        dtype=np.float64,
    )
    b, g, r = np.meshgrid(
        levels,
        levels,
        levels,
        indexing="ij",
    )
    nodes = np.stack(
        [r, g, b],
        axis=-1,
    ).reshape(-1, 3)

    labs = _lab_array_from_rgb(nodes)
    delta = _smooth_skin_delta_lab_array(labs, model)
    corrected_lab = labs + float(strength) * delta
    outputs = _rgb_array_from_lab(corrected_lab)

    return {
        "size": int(size),
        "nodes": nodes.astype(np.float64),
        "outputs": outputs.astype(np.float64),
    }


def _anchor_map(model: Dict[str, Any]) -> Dict[Tuple[str, float], Dict[str, Any]]:
    out: Dict[Tuple[str, float], Dict[str, Any]] = {}
    zones = model.get("zones") or {}
    for zone_name, zone in zones.items():
        for anchor in zone.get("anchors") or []:
            out[(str(zone_name), round(float(anchor.get("q", 0.0)), 2))] = anchor
    return out


def build_correspondences(target: Dict[str, Any], reference: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Legacy zone-to-zone correspondences retained for fallback/diagnostics."""
    ta = _anchor_map(target)
    ra = _anchor_map(reference)
    rows: List[Dict[str, Any]] = []
    q_weight = {round(q, 2): w for q, w in zip(TONE_Q, TONE_WEIGHTS)}
    for key, t in ta.items():
        r = ra.get(key)
        if not r:
            continue
        zone, q = key
        spread = max(
            1.0,
            float(t.get("spread", 1.0))
            + float(r.get("spread", 1.0))
            + 2.2 * float(r.get("reference_dispersion", 0.0)),
        )
        stability = 1.0 / (1.0 + spread / 28.0)
        weight = float(ZONE_WEIGHTS.get(zone, 1.0)) * float(q_weight.get(q, 0.8)) * stability
        rows.append({"zone": zone, "q": q, "target": t, "reference": r, "weight": weight})
    if len(rows) < 6:
        raise ApiError("Not enough corresponding skin measurements were available for curve fitting.", "INSUFFICIENT_MATCH_DATA")
    return rows


def _pooled_anchor_map(model: Dict[str, Any]) -> Dict[float, Dict[str, Any]]:
    out: Dict[float, Dict[str, Any]] = {}
    pooled = model.get("pooled") or {}
    for anchor in pooled.get("anchors") or []:
        try:
            out[round(float(anchor.get("q", 0.0)), 2)] = anchor
        except (TypeError, ValueError):
            continue
    return out


def _correspondence_stability(
    target_anchor: Dict[str, Any],
    reference_anchor: Dict[str, Any],
) -> float:
    spread = max(
        1.0,
        float(target_anchor.get("spread", 1.0))
        + float(reference_anchor.get("spread", 1.0))
        + 2.2 * float(reference_anchor.get("reference_dispersion", 0.0)),
    )
    return float(1.0 / (1.0 + spread / 28.0))


def _build_pooled_fit_rows(
    target: Dict[str, Any],
    reference: Dict[str, Any],
) -> List[Dict[str, Any]]:
    target_pooled = _pooled_anchor_map(target)
    reference_pooled = _pooled_anchor_map(reference)
    q_weight = {round(q, 2): w for q, w in zip(TONE_Q, TONE_WEIGHTS)}
    rows: List[Dict[str, Any]] = []
    for q in sorted(set(target_pooled).intersection(reference_pooled)):
        t = target_pooled[q]
        r = reference_pooled[q]
        rows.append({
            "zone": "skin_manifold",
            "q": q,
            "target": t,
            "reference": r,
            "weight": float(q_weight.get(q, 0.8))
                * _correspondence_stability(t, r),
        })
    return rows


def _build_manifold_validation_rows(
    target: Dict[str, Any],
    reference: Dict[str, Any],
) -> List[Dict[str, Any]]:
    reference_pooled = _pooled_anchor_map(reference)
    q_weight = {round(q, 2): w for q, w in zip(TONE_Q, TONE_WEIGHTS)}
    rows: List[Dict[str, Any]] = []
    for zone_name, zone in (target.get("zones") or {}).items():
        for target_anchor in zone.get("anchors") or []:
            try:
                q = round(float(target_anchor.get("q", 0.0)), 2)
            except (TypeError, ValueError):
                continue
            reference_anchor = reference_pooled.get(q)
            if reference_anchor is None:
                continue
            rows.append({
                "zone": str(zone_name),
                "q": q,
                "target": target_anchor,
                "reference": reference_anchor,
                "weight": float(ZONE_WEIGHTS.get(str(zone_name), 1.0))
                    * float(q_weight.get(q, 0.8))
                    * _correspondence_stability(target_anchor, reference_anchor),
            })
    return rows


def build_match_datasets(
    target: Dict[str, Any],
    reference: Dict[str, Any],
) -> Dict[str, Any]:
    """Build pooled fit data and spatially independent validation rows.

    Legacy zone-to-zone pairs are diagnostics in pooled mode, not a
    prerequisite.  This matters for older/partial presets whose pooled skin
    anchors are valid even when one or more matching reference zones are
    absent.
    """
    fit_rows = _build_pooled_fit_rows(target, reference)
    validation_rows = _build_manifold_validation_rows(target, reference)
    try:
        legacy_rows = build_correspondences(target, reference)
    except ApiError as exc:
        if getattr(exc, "code", None) != "INSUFFICIENT_MATCH_DATA":
            raise
        legacy_rows = []

    if len(fit_rows) >= 6 and len(validation_rows) >= 6:
        return {
            "fit_rows": fit_rows,
            "validation_rows": validation_rows,
            "legacy_zone_rows": legacy_rows,
            "mode": "pooled-skin-manifold",
        }

    if len(legacy_rows) < 6:
        raise ApiError(
            "Not enough corresponding skin measurements were available for curve fitting.",
            "INSUFFICIENT_MATCH_DATA",
        )

    fallback = [dict(row) for row in legacy_rows]
    return {
        "fit_rows": fallback,
        "validation_rows": [dict(row) for row in fallback],
        "legacy_zone_rows": legacy_rows,
        "mode": "legacy-zone-fallback",
    }


def _interp_curve(curve: Sequence[Sequence[float]], values: np.ndarray) -> np.ndarray:
    xp = np.array([float(p[0]) for p in curve], dtype=np.float32)
    yp = np.array([float(p[1]) for p in curve], dtype=np.float32)
    return np.interp(values.astype(np.float32), xp, yp)


def weighted_median(values: Sequence[float], weights: Sequence[float]) -> float:
    va = np.asarray(values, dtype=np.float64)
    wa = np.asarray(weights, dtype=np.float64)
    finite = np.isfinite(va) & np.isfinite(wa)
    va, wa = va[finite], wa[finite]
    if va.size == 0:
        return 0.0
    if float(np.sum(wa)) <= 0:
        return float(np.median(va))
    order = np.argsort(va)
    va, wa = va[order], wa[order]
    c = np.cumsum(wa)
    idx = int(np.searchsorted(c, c[-1] * 0.5, side="left"))
    return float(va[min(max(idx, 0), len(va) - 1)])


def _normalized_percent_bias(value: float) -> float:
    return float(np.clip(float(value) / 100.0, -1.0, 1.0))


def _tone_weight_scale(q_value: float, lightness_balance: float) -> float:
    bias = _normalized_percent_bias(lightness_balance)
    if abs(bias) < 1e-9:
        return 1.0
    q = float(np.clip(q_value, 0.0, 1.0))
    tonal_position = 1.0 - 2.0 * q  # +1 shadows, -1 highlights
    scale = 1.0 - 1.55 * bias * tonal_position
    return float(np.clip(scale, 0.25, 3.00))


def _accuracy_profile_mix(protection_bias: float) -> float:
    """Smooth 0..1 transition from Auto to the maximum-Accuracy profile."""
    bias = _normalized_percent_bias(protection_bias)
    accuracy = max(0.0, -bias)
    # Smoothstep keeps Auto and the Accuracy endpoint stable while giving the
    # middle of the slider a useful continuous transition.
    return float(accuracy * accuracy * (3.0 - 2.0 * accuracy))


def _lerp(a: float, b: float, t: float) -> float:
    return float(a + (b - a) * np.clip(float(t), 0.0, 1.0))


def _protection_profile(
    protection_bias: float,
    minimum_gain: float,
) -> Dict[str, float]:
    bias = _normalized_percent_bias(protection_bias)
    base_cv_min = max(0.04, float(minimum_gain) * 0.50)

    accuracy = max(0.0, -bias)
    safety = max(0.0, bias)
    accuracy_mix = _accuracy_profile_mix(protection_bias)

    # Auto values are the established neutral profile. The left half of the
    # slider interpolates smoothly from Auto to the maximum-Accuracy profile.
    # The right/Safety half keeps its conservative progression.
    auto = {
        "wb_nonworse": 0.70,
        "wb_p75": 0.18,
        "wb_cheek_worsening": 0.10,

        "skin_nonworse": 0.58,
        "skin_p75": 0.34,
        "skin_cv_min": base_cv_min,
        "score_cv_weight": 0.22,
        "score_collateral_weight": 1.0,
        "max_skin_strength": 1.0,

        "near_best_gain_ratio": 0.98,
        "near_best_score_extra": 0.06,
        "near_best_chroma_ratio": 0.94,

        "fine_nonworse": 0.60,
        "fine_p75": 0.30,
        "fine_min_gain": 0.02,
        "fine_cv_min": 0.01,
        "max_refinement_strength": 1.0,

        "final_nonworse": 0.58,
        "final_p75": 0.34,
    }

    accuracy_endpoint = {
        "wb_nonworse": 0.52,
        "wb_p75": 0.55,
        "wb_cheek_worsening": 0.45,

        "skin_nonworse": 0.38,
        "skin_p75": 0.95,
        "skin_cv_min": -0.35,
        "score_cv_weight": 0.025,
        "score_collateral_weight": 0.035,
        "max_skin_strength": 1.50,

        # At the endpoint every otherwise-valid candidate may compete on
        # actual measured ΔE at the Accuracy endpoint.
        "near_best_gain_ratio": 0.0,
        "near_best_score_extra": 0.0,  # computed dynamically from score span
        "near_best_chroma_ratio": 0.0,

        "fine_nonworse": 0.40,
        "fine_p75": 0.90,
        "fine_min_gain": 0.001,
        "fine_cv_min": -0.03,
        "max_refinement_strength": 1.0,

        "final_nonworse": 0.38,
        "final_p75": 0.95,
    }

    if accuracy > 0.0:
        t = accuracy_mix
        profile = {
            key: _lerp(auto[key], accuracy_endpoint[key], t)
            for key in auto.keys()
        }
        profile.update({
            "bias": bias,
            "accuracy": accuracy,
            "safety": 0.0,
            "accuracy_mix": t,
        })
        return profile

    # Auto and Safety preserve the previous profile exactly.
    return {
        "bias": bias,
        "accuracy": 0.0,
        "safety": safety,
        "accuracy_mix": 0.0,

        "wb_nonworse": 0.70 + 0.08 * safety,
        "wb_p75": 0.18 - 0.08 * safety,
        "wb_cheek_worsening": 0.10 - 0.06 * safety,

        "skin_nonworse": 0.58 + 0.10 * safety,
        "skin_p75": 0.34 - 0.10 * safety,
        "skin_cv_min": max(
            0.015,
            base_cv_min * (1.0 + 0.80 * safety),
        ),
        "score_cv_weight": 0.22 * (
            1.0 + 0.90 * safety
        ),
        "score_collateral_weight": 1.0 + 1.00 * safety,
        "max_skin_strength": 1.0 - 0.40 * safety,

        "near_best_gain_ratio": 0.98 - 0.10 * safety,
        "near_best_score_extra": 0.06 + 0.16 * safety,
        "near_best_chroma_ratio": 0.94,

        "fine_nonworse": 0.60 + 0.10 * safety,
        "fine_p75": 0.30 - 0.10 * safety,
        "fine_min_gain": max(
            0.003,
            0.02 * (1.0 + 2.00 * safety),
        ),
        "fine_cv_min": 0.01 + 0.02 * safety,
        "max_refinement_strength": 1.0 - 0.55 * safety,

        "final_nonworse": 0.58 + 0.10 * safety,
        "final_p75": 0.34 - 0.10 * safety,
    }



def _param_basis_mid(values: np.ndarray) -> np.ndarray:
    x = np.clip(np.asarray(values, dtype=np.float64) / 255.0, 0.0, 1.0)
    return 4.0 * x * (1.0 - x)


def _param_basis_high(values: np.ndarray) -> np.ndarray:
    x = np.clip(np.asarray(values, dtype=np.float64) / 255.0, 0.0, 1.0)
    return 9.48148148148 * (x ** 3) * (1.0 - x)


def _lab_array_from_rgb(values: np.ndarray) -> np.ndarray:
    arr = np.asarray(values, dtype=np.float32).reshape(-1, 1, 3) / 255.0
    return cv2.cvtColor(arr, cv2.COLOR_RGB2LAB).reshape(-1, 3).astype(np.float64)


def _rgb_array_from_lab(values: np.ndarray) -> np.ndarray:
    arr = np.asarray(values, dtype=np.float32).reshape(-1, 1, 3)
    rgb = cv2.cvtColor(arr, cv2.COLOR_LAB2RGB).reshape(-1, 3)
    return np.clip(rgb * 255.0, 0.0, 255.0).astype(np.float64)


def _smoothstep(value: np.ndarray, low: float, high: float) -> np.ndarray:
    t = np.clip((np.asarray(value, dtype=np.float64) - low) / max(1e-9, high - low), 0.0, 1.0)
    return t * t * (3.0 - 2.0 * t)


def _build_residual_refinement_lut(
    rows: List[Dict[str, Any]],
    size: int = 17,
    accuracy_mix: float = 0.0,
) -> Optional[Dict[str, Any]]:
    """Build the final local residual LUT.

    Auto keeps the v0.14.4 chroma-only behaviour. Accuracy gradually permits
    a small residual L* term, while the broad Skin model remains the primary
    owner of tone and the local RBF inside that model stays chroma-only.
    """
    if not rows:
        return None

    accuracy_mix = float(np.clip(float(accuracy_mix), 0.0, 1.0))
    src_rgb = np.asarray(
        [
            [float(row["target"][k]) for k in ("r", "g", "b")]
            for row in rows
        ],
        dtype=np.float64,
    )
    weights = np.asarray(
        [max(0.02, float(row.get("weight", 1.0))) for row in rows],
        dtype=np.float64,
    )
    src_lab = _lab_array_from_rgb(src_rgb)
    ref_lab = np.asarray(
        [
            _reference_lab_from_anchor(row["reference"])
            for row in rows
        ],
        dtype=np.float64,
    )
    residual_lab = ref_lab - src_lab

    max_residual_l = _lerp(0.0, 2.5, accuracy_mix)
    residual_l = np.clip(
        residual_lab[:, 0],
        -max_residual_l,
        max_residual_l,
    )
    positive = residual_l > 0.0
    if np.any(positive):
        residual_l[positive] *= np.asarray([
            _shadow_lightening_gate(value)
            for value in src_lab[positive, 0]
        ], dtype=np.float64)
    residual_lab[:, 0] = residual_l

    # Chroma limits expand only toward Accuracy. At accuracy_mix == 0 these
    # are exactly the v0.14.4 limits.
    radial_limit = _lerp(0.80, 1.80, accuracy_mix)
    tangential_limit = _lerp(3.20, 4.80, accuracy_mix)

    src_ab = src_lab[:, 1:3]
    src_c = np.sqrt(np.sum(src_ab ** 2, axis=1))
    radial_unit = np.zeros_like(src_ab)
    radial_mask = src_c >= 1.0
    if np.any(radial_mask):
        radial_unit[radial_mask] = (
            src_ab[radial_mask]
            / src_c[radial_mask, None]
        )
    if np.any(~radial_mask):
        fallback = np.median(src_ab, axis=0)
        fallback_norm = float(np.linalg.norm(fallback))
        if fallback_norm <= 1e-9:
            fallback = np.asarray([1.0, 0.0], dtype=np.float64)
        else:
            fallback = fallback / fallback_norm
        radial_unit[~radial_mask] = fallback.reshape(1, 2)

    residual_ab = residual_lab[:, 1:3]
    radial_amount = np.sum(
        residual_ab * radial_unit,
        axis=1,
    )
    tangential = residual_ab - radial_amount[:, None] * radial_unit
    radial_amount = np.clip(radial_amount, -radial_limit, radial_limit)
    tangential_norm = np.sqrt(np.sum(tangential ** 2, axis=1))
    tangential_scale = np.minimum(
        1.0,
        tangential_limit / np.maximum(tangential_norm, 1e-9),
    )
    tangential *= tangential_scale[:, None]
    residual_lab[:, 1:3] = (
        tangential + radial_amount[:, None] * radial_unit
    )

    levels = np.linspace(0.0, 255.0, int(size), dtype=np.float64)
    b, g, r = np.meshgrid(levels, levels, levels, indexing="ij")
    nodes = np.stack([r, g, b], axis=-1).reshape(-1, 3)
    node_lab = _lab_array_from_rgb(nodes)

    sigma = 12.5
    prior = 2.8
    skin_ab_center = np.median(src_lab[:, 1:], axis=0)
    centered_ab = src_lab[:, 1:3] - skin_ab_center.reshape(1, 2)
    if src_lab.shape[0] >= 3:
        cov = np.asarray(
            np.cov(centered_ab.T, aweights=np.maximum(weights, 1e-4)),
            dtype=np.float64,
        ).reshape(2, 2)
    else:
        cov = np.eye(2, dtype=np.float64) * 16.0
    cov += np.eye(2, dtype=np.float64) * 8.0
    try:
        inv_cov = np.linalg.inv(cov)
    except np.linalg.LinAlgError:
        inv_cov = np.linalg.pinv(cov)

    skin_ab_radius = max(
        10.0,
        float(np.percentile(
            np.sqrt(np.sum(centered_ab ** 2, axis=1)),
            85,
        )) * 1.85,
    )
    skin_l_low = float(np.percentile(src_lab[:, 0], 5)) - 8.0
    skin_l_high = float(np.percentile(src_lab[:, 0], 95)) + 8.0

    distances = np.sqrt(np.sum(
        (node_lab[:, None, :] - src_lab[None, :, :]) ** 2,
        axis=2,
    ))
    local = (
        np.exp(-0.5 * (distances / sigma) ** 2)
        * weights.reshape(1, -1)
    )
    local_sum = np.sum(local, axis=1)
    delta = (
        local @ residual_lab
        / np.maximum(prior + local_sum, 1e-9)[:, None]
    )

    # Chroma keeps the established narrow local gate.
    nearest = np.min(distances, axis=1)
    distance_gate = np.exp(-0.5 * (nearest / 12.0) ** 2)
    chroma = np.sqrt(np.sum(node_lab[:, 1:3] ** 2, axis=1))
    neutral_gate = _smoothstep(chroma, 5.0, 16.0)
    shadow_gate = _smoothstep(node_lab[:, 0], 18.0, 42.0)
    white_gate = 1.0 - _smoothstep(node_lab[:, 0], 91.0, 99.0)
    ab_dist = np.sqrt(np.sum(
        (node_lab[:, 1:] - skin_ab_center.reshape(1, 2)) ** 2,
        axis=1,
    ))
    skin_gate = np.exp(-0.5 * (ab_dist / skin_ab_radius) ** 2)
    l_gate = (
        _smoothstep(node_lab[:, 0], skin_l_low, skin_l_low + 12.0)
        * (1.0 - _smoothstep(
            node_lab[:, 0],
            skin_l_high - 12.0,
            skin_l_high,
        ))
    )
    chroma_gate = (
        distance_gate * neutral_gate * shadow_gate
        * white_gate * skin_gate * l_gate
    )

    # L* uses a deliberately broader membership gate. Multiplying it by all
    # chroma-locality gates would create a narrow tonal halo around samples.
    ab_delta = node_lab[:, 1:3] - skin_ab_center.reshape(1, 2)
    mahal2 = np.einsum("ni,ij,nj->n", ab_delta, inv_cov, ab_delta)
    gamut_gate_l = np.exp(-0.5 * mahal2 / (3.25 ** 2))
    ab_distances = np.sqrt(np.sum(
        (node_lab[:, None, 1:3] - src_lab[None, :, 1:3]) ** 2,
        axis=2,
    ))
    nearest_ab = np.min(ab_distances, axis=1)
    nearest_gate_l = np.exp(-0.5 * (nearest_ab / 19.0) ** 2)
    neutral_gate_l = _smoothstep(chroma, 4.5, 12.0)
    shadow_gate_l = _smoothstep(node_lab[:, 0], 22.0, 44.0)
    white_gate_l = 1.0 - _smoothstep(node_lab[:, 0], 94.0, 99.5)
    lightness_gate = np.clip(
        np.sqrt(np.maximum(0.0, gamut_gate_l * nearest_gate_l))
        * neutral_gate_l * shadow_gate_l * white_gate_l,
        0.0,
        1.0,
    )

    corrected_lab = node_lab.copy()
    corrected_lab[:, 0] += delta[:, 0] * lightness_gate
    corrected_lab[:, 1:] += delta[:, 1:] * chroma_gate[:, None]
    outputs = _rgb_array_from_lab(corrected_lab)

    return {
        "size": int(size),
        "nodes": nodes.astype(np.float64),
        "outputs": outputs.astype(np.float64),
        "max_residual_l": float(max_residual_l),
        "radial_limit": float(radial_limit),
        "tangential_limit": float(tangential_limit),
    }

def _trilinear_lut(rgb: Sequence[float], lut: Dict[str, Any], strength: float) -> List[float]:
    size = int(lut["size"])
    table = np.asarray(lut["outputs"], dtype=np.float64).reshape(size, size, size, 3)  # b,g,r
    src = np.clip(np.asarray(rgb, dtype=np.float64), 0.0, 255.0)
    pos = src / 255.0 * float(size - 1)
    r0, g0, b0 = [int(math.floor(v)) for v in pos]
    r1, g1, b1 = [min(size - 1, v + 1) for v in (r0, g0, b0)]
    fr, fg, fb = pos[0] - r0, pos[1] - g0, pos[2] - b0
    out = np.zeros(3, dtype=np.float64)
    for bi, wb in ((b0, 1.0 - fb), (b1, fb)):
        for gi, wg in ((g0, 1.0 - fg), (g1, fg)):
            for ri, wr in ((r0, 1.0 - fr), (r1, fr)):
                out += table[bi, gi, ri] * wb * wg * wr
    blended = src + float(strength) * (out - src)
    return [float(v) for v in np.clip(blended, 0.0, 255.0)]




def _apply_lut_array(
    values: np.ndarray,
    lut: Dict[str, Any],
    strength: float = 1.0,
) -> np.ndarray:
    """Vectorized trilinear RGB LUT evaluation."""
    arr = np.clip(
        np.asarray(values, dtype=np.float64).reshape(-1, 3),
        0.0,
        255.0,
    )
    if arr.shape[0] == 0:
        return arr.copy()

    size = int(lut["size"])
    table = np.asarray(
        lut["outputs"],
        dtype=np.float64,
    ).reshape(size, size, size, 3)  # b,g,r

    pos = arr / 255.0 * float(size - 1)
    lo = np.floor(pos).astype(np.int32)
    hi = np.minimum(size - 1, lo + 1)
    frac = pos - lo

    r0, g0, b0 = lo[:, 0], lo[:, 1], lo[:, 2]
    r1, g1, b1 = hi[:, 0], hi[:, 1], hi[:, 2]
    fr, fg, fb = frac[:, 0], frac[:, 1], frac[:, 2]

    out = np.zeros_like(arr)
    for bi, wb in ((b0, 1.0 - fb), (b1, fb)):
        for gi, wg in ((g0, 1.0 - fg), (g1, fg)):
            for ri, wr in ((r0, 1.0 - fr), (r1, fr)):
                out += (
                    table[bi, gi, ri]
                    * (wb * wg * wr)[:, None]
                )

    return np.clip(
        arr + float(strength) * (out - arr),
        0.0,
        255.0,
    )


def _compose_skin_and_refinement_lut(
    skin_lut: Dict[str, Any],
    skin_strength: float,
    refinement_lut: Optional[Dict[str, Any]] = None,
    refinement_strength: float = 0.0,
) -> Dict[str, Any]:
    """Bake Skin Color + internal refinement into ONE Photoshop LUT."""
    nodes = np.asarray(skin_lut["nodes"], dtype=np.float64)
    skin_outputs = np.asarray(skin_lut["outputs"], dtype=np.float64)
    outputs = nodes + float(skin_strength) * (skin_outputs - nodes)

    if refinement_lut is not None and float(refinement_strength) > 0.0:
        refined_full = _apply_lut_array(
            outputs,
            refinement_lut,
            1.0,
        )
        outputs = (
            outputs
            + float(refinement_strength) * (refined_full - outputs)
        )

    return {
        "size": int(skin_lut["size"]),
        "nodes": nodes.copy(),
        "outputs": np.clip(outputs, 0.0, 255.0),
    }



def _rows_after_lut(
    rows: List[Dict[str, Any]],
    lut: Dict[str, Any],
    strength: float,
) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    for row in rows:
        t = row["target"]
        corrected = _trilinear_lut(
            [float(t["r"]), float(t["g"]), float(t["b"])],
            lut,
            float(strength),
        )
        new_t = dict(t)
        new_t["r"], new_t["g"], new_t["b"] = corrected
        new_t["y"] = (
            0.2126 * corrected[0]
            + 0.7152 * corrected[1]
            + 0.0722 * corrected[2]
        )
        new_row = dict(row)
        new_row["target"] = new_t
        out.append(new_row)
    return out




def _lut_collateral_stats(
    pixels: np.ndarray,
    lut: Dict[str, Any],
    strength: float,
    max_pixels: int = 1400,
    before_lab: Optional[np.ndarray] = None,
) -> Dict[str, float]:
    """Measure actual LUT spill on all sampled outside-face pixels."""
    arr = np.asarray(pixels, dtype=np.float64).reshape(-1, 3)
    if arr.shape[0] == 0:
        return {
            "count": 0.0,
            "affected_fraction": 0.0,
            "mean": 0.0,
            "p95": 0.0,
            "p99": 0.0,
            "max": 0.0,
        }

    if arr.shape[0] > int(max_pixels):
        step = int(math.ceil(arr.shape[0] / float(max_pixels)))
        arr = arr[::step][:int(max_pixels)]

    if before_lab is None:
        baseline_lab = _lab_array_from_rgb(arr)
    else:
        baseline_lab = np.asarray(before_lab, dtype=np.float64).reshape(-1, 3)
        if baseline_lab.shape[0] != arr.shape[0]:
            baseline_lab = _lab_array_from_rgb(arr)
    corrected = _apply_lut_array(
        arr,
        lut,
        float(strength),
    )
    after_lab = _lab_array_from_rgb(corrected)
    shifts = np.sqrt(np.sum((after_lab - baseline_lab) ** 2, axis=1))

    return {
        "count": float(shifts.size),
        "affected_fraction": float(np.mean(shifts >= 0.15)) if shifts.size else 0.0,
        "mean": float(np.mean(shifts)) if shifts.size else 0.0,
        "p95": float(np.percentile(shifts, 95.0)) if shifts.size else 0.0,
        "p99": float(np.percentile(shifts, 99.0)) if shifts.size else 0.0,
        "max": float(np.max(shifts)) if shifts.size else 0.0,
    }


def _lut_geometry_stats(
    lut: Dict[str, Any],
    strength: float,
) -> Dict[str, float]:
    """Measure whether a 3-D LUT preserves local colour gradations.

    Sparse colour anchors can all improve while the transform between them
    folds or strongly compresses colour space. Finite-difference Jacobians on
    every active LUT cell detect that failure before Photoshop receives the
    profile. This is deliberately independent of the requested strength: an
    Accuracy candidate above 100% is accepted whenever its actual geometry is
    still safe.
    """
    size = int(lut["size"])
    nodes = np.asarray(
        lut["nodes"], dtype=np.float64
    ).reshape(size, size, size, 3)
    outputs = np.asarray(
        lut["outputs"], dtype=np.float64
    ).reshape(size, size, size, 3)
    blended = nodes + float(strength) * (outputs - nodes)
    step = 255.0 / max(1.0, float(size - 1))

    displacement = np.sqrt(np.sum((blended - nodes) ** 2, axis=3))
    active = np.maximum.reduce([
        displacement[:-1, :-1, :-1],
        displacement[:-1, :-1, 1:],
        displacement[:-1, 1:, :-1],
        displacement[1:, :-1, :-1],
    ]) >= 0.08
    active_count = int(np.count_nonzero(active))
    if active_count == 0:
        return {
            "active_cells": 0.0,
            "folded_cells": 0.0,
            "folded_fraction": 0.0,
            "min_determinant": 1.0,
            "p01_determinant": 1.0,
            "p01_min_singular": 1.0,
            "p99_max_singular": 1.0,
            "p99_curvature": 0.0,
            "new_clipping_fraction": 0.0,
        }

    origin = blended[:-1, :-1, :-1]
    jacobian = np.stack([
        (blended[:-1, :-1, 1:] - origin) / step,
        (blended[:-1, 1:, :-1] - origin) / step,
        (blended[1:, :-1, :-1] - origin) / step,
    ], axis=-1)
    active_j = jacobian[active]
    determinants = np.linalg.det(active_j)
    singular = np.linalg.svd(active_j, compute_uv=False)

    curvature_parts: List[np.ndarray] = []
    for axis in range(3):
        second = np.diff(blended, n=2, axis=axis) / step
        curvature_parts.append(
            np.sqrt(np.sum(second ** 2, axis=3)).reshape(-1)
        )
    curvature = np.concatenate(curvature_parts)
    curvature = curvature[np.isfinite(curvature)]

    node_active = displacement >= 0.08
    input_interior = np.all(
        (nodes > 0.5) & (nodes < 254.5),
        axis=3,
    )
    newly_clipped = (
        node_active
        & input_interior
        & np.any(
            (blended <= 0.01) | (blended >= 254.99),
            axis=3,
        )
    )
    active_nodes = max(1, int(np.count_nonzero(node_active & input_interior)))
    folded = int(np.count_nonzero(determinants <= 0.0))

    return {
        "active_cells": float(active_count),
        "folded_cells": float(folded),
        "folded_fraction": float(folded / max(1, active_count)),
        "min_determinant": float(np.min(determinants)),
        "p01_determinant": float(np.percentile(determinants, 1.0)),
        "p01_min_singular": float(np.percentile(singular[:, -1], 1.0)),
        "p99_max_singular": float(np.percentile(singular[:, 0], 99.0)),
        "p99_curvature": (
            float(np.percentile(curvature, 99.0))
            if curvature.size else 0.0
        ),
        "new_clipping_fraction": float(
            np.count_nonzero(newly_clipped) / active_nodes
        ),
    }


def _refinement_lightness_stats(
    before_rgb: np.ndarray,
    after_rgb: np.ndarray,
    size: int,
) -> Dict[str, float]:
    """Measure only the incremental L* movement added by refinement."""
    before = np.asarray(before_rgb, dtype=np.float64).reshape(-1, 3)
    after = np.asarray(after_rgb, dtype=np.float64).reshape(-1, 3)
    if before.shape != after.shape or before.shape[0] == 0:
        return {
            "p95_abs_delta_l": 0.0,
            "max_abs_delta_l": 0.0,
            "p99_lightness_curvature": 0.0,
        }
    before_l = _lab_array_from_rgb(before)[:, 0]
    after_l = _lab_array_from_rgb(after)[:, 0]
    delta_l = (after_l - before_l).reshape(int(size), int(size), int(size))
    abs_delta = np.abs(delta_l).reshape(-1)
    curvature_parts: List[np.ndarray] = []
    for axis in range(3):
        if int(size) >= 3:
            curvature_parts.append(np.abs(np.diff(delta_l, n=2, axis=axis)).reshape(-1))
    curvature = (
        np.concatenate(curvature_parts)
        if curvature_parts else np.empty(0, dtype=np.float64)
    )
    return {
        "p95_abs_delta_l": float(np.percentile(abs_delta, 95.0)),
        "max_abs_delta_l": float(np.max(abs_delta)),
        "p99_lightness_curvature": (
            float(np.percentile(curvature, 99.0))
            if curvature.size else 0.0
        ),
    }


def _refinement_lightness_is_safe(
    stats: Dict[str, float],
    accuracy_mix: float,
) -> bool:
    t = float(np.clip(float(accuracy_mix), 0.0, 1.0))
    if t <= 1e-12:
        return True
    return bool(
        float(stats.get("p95_abs_delta_l", 99.0)) <= max(0.08, 2.20 * t)
        and float(stats.get("max_abs_delta_l", 99.0)) <= max(0.10, 3.00 * t)
    )


def _lut_geometry_is_safe(
    stats: Dict[str, float],
    protection_bias: float = 0.0,
) -> bool:
    if float(stats.get("active_cells", 0.0)) < 1.0:
        return True
    accuracy = _accuracy_profile_mix(protection_bias)
    safety = max(
        0.0,
        _normalized_percent_bias(protection_bias),
    )
    min_det = _lerp(0.12 + 0.05 * safety, 0.018, accuracy)
    min_singular = _lerp(0.24 + 0.06 * safety, 0.075, accuracy)
    max_singular = _lerp(2.15 - 0.15 * safety, 3.40, accuracy)
    max_curvature = _lerp(0.46 - 0.06 * safety, 0.82, accuracy)
    max_new_clipping = _lerp(0.018 - 0.004 * safety, 0.055, accuracy)
    return bool(
        float(stats.get("folded_cells", 0.0)) <= 0.0
        and float(stats.get("min_determinant", 0.0)) > 0.0
        and float(stats.get("p01_determinant", 0.0)) >= min_det
        and float(stats.get("p01_min_singular", 0.0)) >= min_singular
        and float(stats.get("p99_max_singular", 99.0)) <= max_singular
        and float(stats.get("p99_curvature", 99.0)) <= max_curvature
        and float(stats.get("new_clipping_fraction", 1.0)) <= max_new_clipping
    )


def _lut_geometry_penalty(stats: Dict[str, float]) -> float:
    """Prefer the smoother candidate when measured accuracy is effectively tied."""
    return float(
        0.10 * max(0.0, 0.45 - float(stats.get("p01_min_singular", 1.0)))
        + 0.05 * max(0.0, float(stats.get("p99_max_singular", 1.0)) - 1.80)
        + 0.08 * max(0.0, float(stats.get("p99_curvature", 0.0)) - 0.25)
        + 0.30 * float(stats.get("new_clipping_fraction", 0.0))
    )


def _collateral_is_catastrophic(
    stats: Dict[str, float],
    fine_tune: bool = False,
    protection_bias: float = 0.0,
) -> bool:
    """Hard spill veto, smoothly relaxed toward the Accuracy endpoint."""
    if float(stats.get("count", 0.0)) < 10:
        return False

    affected = float(stats.get("affected_fraction", 0.0))
    p99 = float(stats.get("p99", 0.0))
    maximum = float(stats.get("max", 0.0))
    t = _accuracy_profile_mix(protection_bias)

    if fine_tune:
        max_limit = _lerp(5.0, 11.0, t)
        affected_limit = _lerp(0.10, 0.30, t)
        p99_limit = _lerp(2.6, 6.0, t)
    else:
        max_limit = _lerp(6.5, 15.0, t)
        affected_limit = _lerp(0.12, 0.38, t)
        p99_limit = _lerp(3.2, 8.0, t)

    return bool(
        maximum > max_limit
        or (
            affected > affected_limit
            and p99 > p99_limit
        )
    )



def _collateral_penalty(
    stats: Dict[str, float],
    fine_tune: bool = False,
) -> float:
    if float(stats.get("count", 0.0)) < 10:
        return 0.0

    p95 = float(stats.get("p95", 0.0))
    p99 = float(stats.get("p99", 0.0))
    affected = float(stats.get("affected_fraction", 0.0))
    if fine_tune:
        return float(
            0.16 * max(0.0, p95 - 0.35)
            + 0.08 * max(0.0, p99 - 0.90)
            + 0.22 * max(0.0, affected - 0.08)
        )
    return float(
        0.12 * max(0.0, p95 - 0.45)
        + 0.06 * max(0.0, p99 - 1.10)
        + 0.18 * max(0.0, affected - 0.10)
    )


def _write_cube(lut: Dict[str, Any], strength: float) -> Path:
    size = int(lut["size"])
    nodes = np.asarray(lut["nodes"], dtype=np.float64)
    outputs = np.asarray(lut["outputs"], dtype=np.float64)
    blended = nodes + float(strength) * (outputs - nodes)
    path = TEMP_DIR / ("face-color-match-lut-" + uuid.uuid4().hex + ".cube")
    lines = [
        'TITLE "Face Color Match"',
        f"LUT_3D_SIZE {size}",
        "DOMAIN_MIN 0.0 0.0 0.0",
        "DOMAIN_MAX 1.0 1.0 1.0",
        "",
    ]
    for row in np.clip(blended / 255.0, 0.0, 1.0):
        lines.append("%.7f %.7f %.7f" % (float(row[0]), float(row[1]), float(row[2])))
    path.write_text("\n".join(lines) + "\n", encoding="ascii")
    return path


def _icc_profile_id(profile: bytes) -> bytes:
    """Calculate the ICC v4 profile ID while neutralizing mutable header fields."""
    data = bytearray(profile)
    # ICC.1 profile-ID calculation zeros flags, rendering intent and the ID itself.
    data[44:48] = b"\x00" * 4
    data[64:68] = b"\x00" * 4
    data[84:100] = b"\x00" * 16
    return hashlib.md5(bytes(data)).digest()


def _device_link_clut_bytes(
    lut: Dict[str, Any],
    strength: float,
) -> bytes:
    """Serialize the native RGB LUT directly as a 16-bit ICC CLUT.

    The internal table is [B, G, R]. Photoshop's mAB CLUT expects R outer /
    G middle / B inner (blue varies fastest), so transpose once and serialize
    the complete table in big-endian uint16 form.
    """
    size = int(lut["size"])
    if size < 2 or size > 255:
        raise ValueError(
            "ICC mAB CLUT grid size must be between 2 and 255."
        )

    nodes = np.asarray(
        lut["nodes"],
        dtype=np.float64,
    ).reshape(size, size, size, 3)  # b,g,r
    outputs = np.asarray(
        lut["outputs"],
        dtype=np.float64,
    ).reshape(size, size, size, 3)
    blended = nodes + float(strength) * (outputs - nodes)

    # (b,g,r,channel) -> (r,g,b,channel), then C-order flattening gives
    # exactly the old ri/gi/bi loop with B varying fastest.
    ordered = np.transpose(blended, (2, 1, 0, 3)).reshape(-1, 3)
    encoded = np.rint(
        np.clip(ordered, 0.0, 255.0)
        / 255.0
        * 65535.0
    ).astype(">u2", copy=False)
    data = encoded.tobytes(order="C")

    expected = size ** 3 * 3 * 2
    if len(data) != expected:
        raise RuntimeError("Unexpected device-link CLUT size.")
    return data


def _find_icc_tag_record(prefix: bytes, signature: bytes) -> Tuple[int, int, int]:
    if len(prefix) < 132:
        raise RuntimeError("ICC skeleton is truncated.")
    count = struct.unpack(">I", prefix[128:132])[0]
    for index in range(int(count)):
        record = 132 + index * 12
        if prefix[record:record + 4] == signature:
            offset, size = struct.unpack(">II", prefix[record + 4:record + 12])
            return record, int(offset), int(size)
    raise RuntimeError("Required ICC tag was not found.")


def _write_device_link_profile(lut: Dict[str, Any], strength: float) -> Path:
    """Build a native-grid RGB->RGB device-link ICC for Photoshop Color Lookup."""
    prefix = bytearray(base64.b64decode(ICC_DEVICE_LINK_PREFIX_B64))
    suffix = base64.b64decode(ICC_DEVICE_LINK_SUFFIX_B64)
    size = int(lut["size"])
    clut = _device_link_clut_bytes(lut, strength)

    record, a2b_offset, _old_size = _find_icc_tag_record(bytes(prefix), b"A2B0")
    # In the captured 3D LUT Creator mAB tag, the CLUT starts at relative
    # offset 152. Its 20-byte header ends exactly where our prefix ends.
    clut_rel = struct.unpack(">I", prefix[a2b_offset + 24:a2b_offset + 28])[0]
    if clut_rel != 152 or len(prefix) != a2b_offset + clut_rel + 20:
        raise RuntimeError("Unexpected ICC skeleton layout.")

    # The A-curves follow the CLUT payload. Their relative offset must move when
    # the native CLUT is smaller than the original 40^3 example.
    a_curves_rel = clut_rel + 20 + len(clut)
    a2b_size = a_curves_rel + len(suffix)
    total_size = a2b_offset + a2b_size

    # Header profile size.
    prefix[0:4] = struct.pack(">I", total_size)
    # A2B0 tag size in the ICC tag table.
    prefix[record + 8:record + 12] = struct.pack(">I", a2b_size)
    # mAB A-curves relative offset (fifth offset field).
    prefix[a2b_offset + 28:a2b_offset + 32] = struct.pack(">I", a_curves_rel)

    # CLUT header: one grid-point byte per input channel, then unused bytes.
    clut_header = a2b_offset + clut_rel
    prefix[clut_header:clut_header + 3] = bytes((size, size, size))
    # Precision remains 2 bytes per table entry.
    if prefix[clut_header + 16] != 2:
        raise RuntimeError("Unexpected ICC CLUT precision in skeleton.")

    profile = bytearray(prefix + clut + suffix)
    if len(profile) != total_size:
        raise RuntimeError("Generated ICC profile size does not match its header.")
    if bytes(profile[12:16]) != b"link" or bytes(profile[16:20]) != b"RGB ":
        raise RuntimeError("Generated ICC profile has an unexpected device-link header.")

    profile[84:100] = b"\x00" * 16
    profile[84:100] = _icc_profile_id(bytes(profile))

    path = TEMP_DIR / ("face-color-match-lut-" + uuid.uuid4().hex + ".icc")
    path.write_bytes(bytes(profile))
    return path



def _identity_geometry_stats() -> Dict[str, float]:
    return {
        "active_cells": 0.0,
        "folded_cells": 0.0,
        "folded_fraction": 0.0,
        "min_determinant": 1.0,
        "p01_determinant": 1.0,
        "p01_min_singular": 1.0,
        "p99_max_singular": 1.0,
        "p99_curvature": 0.0,
        "new_clipping_fraction": 0.0,
    }


def _validation_stage_is_safe(
    before_rows: List[Dict[str, Any]],
    after_rows: List[Dict[str, Any]],
    protection_bias: float,
    stage: str = "skin",
) -> Tuple[bool, Dict[str, float]]:
    """Independent zone validation: allow small trade-offs, reject regressions."""
    if not before_rows:
        return True, _stage_stats(before_rows, after_rows)
    stats = _stage_stats(before_rows, after_rows)
    t = _accuracy_profile_mix(protection_bias)
    stage_key = str(stage or "skin").lower()
    if stage_key == "wb":
        mean_worsening = _lerp(0.08, 0.34, t)
        min_nonworse = _lerp(0.62, 0.40, t)
        max_p75 = _lerp(0.28, 0.80, t)
        cheek_worsening = _lerp(0.12, 0.48, t)
    elif stage_key == "tone":
        mean_worsening = _lerp(0.08, 0.30, t)
        min_nonworse = _lerp(0.60, 0.40, t)
        max_p75 = _lerp(0.26, 0.75, t)
        cheek_worsening = _lerp(0.14, 0.48, t)
    elif stage_key == "refinement":
        mean_worsening = _lerp(0.06, 0.28, t)
        min_nonworse = _lerp(0.56, 0.36, t)
        max_p75 = _lerp(0.28, 0.85, t)
        cheek_worsening = _lerp(0.14, 0.50, t)
    else:
        mean_worsening = _lerp(0.10, 0.38, t)
        min_nonworse = _lerp(0.56, 0.36, t)
        max_p75 = _lerp(0.32, 0.90, t)
        cheek_worsening = _lerp(0.16, 0.55, t)

    safe = bool(
        float(stats["after"]) <= float(stats["before"]) + mean_worsening
        and float(stats["nonworse_fraction"]) >= min_nonworse
        and float(stats["p75_worsening"]) <= max_p75
    )
    if safe:
        for zone in ("left_cheek", "right_cheek"):
            before = _zone_delta_e(before_rows, zone)
            after = _zone_delta_e(after_rows, zone)
            if before > 0.0 and after > before + cheek_worsening:
                safe = False
                break
    return safe, stats


def _worst_zone_delta_e(rows: List[Dict[str, Any]]) -> Tuple[str, float]:
    zones = sorted(set(str(row.get("zone") or "") for row in rows))
    values = [
        (zone, _zone_delta_e(rows, zone))
        for zone in zones if zone and zone != "skin_manifold"
    ]
    if not values:
        return "", 0.0
    return max(values, key=lambda item: item[1])




def _rows_after_pipeline(
    rows: List[Dict[str, Any]],
    wb_curves: Optional[Dict[str, Sequence[Sequence[float]]]] = None,
    tone_curve: Optional[Sequence[Sequence[float]]] = None,
    skin_lut: Optional[Dict[str, Any]] = None,
) -> List[Dict[str, Any]]:
    current = [dict(row) for row in rows]
    if wb_curves:
        current = _rows_after_curve_set(current, wb_curves)
    if tone_curve:
        current = _rows_after_tone_curve(current, tone_curve)
    if skin_lut is not None:
        current = _rows_after_lut(current, skin_lut, 1.0)
    return current


def _curve_is_identity(curve: Optional[Sequence[Sequence[float]]]) -> bool:
    if not curve:
        return True
    return all(int(round(float(x))) == int(round(float(y))) for x, y in curve)


def _curve_set_is_identity(
    curves: Optional[Dict[str, Sequence[Sequence[float]]]],
) -> bool:
    if not curves:
        return True
    return all(_curve_is_identity(curves.get(name)) for name in ("composite", "red", "green", "blue"))


@dataclass
class JointMatchParams:
    wb_log_r: float
    wb_log_b: float
    tone_shadow: float
    tone_mid: float
    tone_high: float
    l_knots: np.ndarray
    logc_knots: np.ndarray
    hue_knots: np.ndarray
    residual_strength: float


def _copy_joint_params(params: JointMatchParams) -> JointMatchParams:
    return JointMatchParams(
        wb_log_r=float(params.wb_log_r),
        wb_log_b=float(params.wb_log_b),
        tone_shadow=float(params.tone_shadow),
        tone_mid=float(params.tone_mid),
        tone_high=float(params.tone_high),
        l_knots=np.asarray(params.l_knots, dtype=np.float64).copy(),
        logc_knots=np.asarray(params.logc_knots, dtype=np.float64).copy(),
        hue_knots=np.asarray(params.hue_knots, dtype=np.float64).copy(),
        residual_strength=float(params.residual_strength),
    )


def _blend_joint_params(
    base: JointMatchParams,
    endpoint: JointMatchParams,
    mix: float,
) -> JointMatchParams:
    t = float(np.clip(float(mix), 0.0, 1.0))
    return JointMatchParams(
        wb_log_r=_lerp(base.wb_log_r, endpoint.wb_log_r, t),
        wb_log_b=_lerp(base.wb_log_b, endpoint.wb_log_b, t),
        tone_shadow=_lerp(base.tone_shadow, endpoint.tone_shadow, t),
        tone_mid=_lerp(base.tone_mid, endpoint.tone_mid, t),
        tone_high=_lerp(base.tone_high, endpoint.tone_high, t),
        l_knots=np.asarray(base.l_knots, dtype=np.float64) + t * (
            np.asarray(endpoint.l_knots, dtype=np.float64)
            - np.asarray(base.l_knots, dtype=np.float64)
        ),
        logc_knots=np.asarray(base.logc_knots, dtype=np.float64) + t * (
            np.asarray(endpoint.logc_knots, dtype=np.float64)
            - np.asarray(base.logc_knots, dtype=np.float64)
        ),
        hue_knots=np.asarray(base.hue_knots, dtype=np.float64) + t * (
            np.asarray(endpoint.hue_knots, dtype=np.float64)
            - np.asarray(base.hue_knots, dtype=np.float64)
        ),
        residual_strength=_lerp(
            base.residual_strength, endpoint.residual_strength, t
        ),
    )


def _joint_wb_cap(protection_bias: float) -> float:
    accuracy = _accuracy_profile_mix(protection_bias)
    safety = max(0.0, _normalized_percent_bias(protection_bias))
    return float(_lerp(0.145 - 0.025 * safety, 0.235, accuracy))


def _joint_params_to_wb_curves(
    params: JointMatchParams,
    protection_bias: float = 0.0,
) -> Dict[str, List[List[int]]]:
    cap = _joint_wb_cap(protection_bias)
    lr = float(np.clip(params.wb_log_r, -cap, cap))
    lb = float(np.clip(params.wb_log_b, -cap, cap))
    logs = np.asarray([lr, -lr - lb, lb], dtype=np.float64)
    logs = np.clip(logs, -cap, cap)
    logs -= float(np.mean(logs))
    gains = np.exp(logs)
    return _white_balance_curves({
        "enabled": True,
        "gains": dict(zip(("r", "g", "b"), gains.tolist())),
    })


def _joint_params_to_tone_curve(params: JointMatchParams) -> List[List[int]]:
    return _tone_curve_points([
        float(params.tone_shadow),
        float(params.tone_mid),
        float(params.tone_high),
    ])


def _joint_params_to_skin_model(
    params: JointMatchParams,
    template_model: Dict[str, Any],
    knot_positions: np.ndarray,
) -> Dict[str, Any]:
    model = dict(template_model)
    model["l_nodes"] = np.asarray(knot_positions, dtype=np.float64).copy()
    model["delta_l"] = np.clip(
        np.asarray(params.l_knots, dtype=np.float64), -5.0, 5.0
    )
    model["log_chroma_gain"] = np.clip(
        np.asarray(params.logc_knots, dtype=np.float64),
        math.log(0.50), math.log(2.00),
    )
    model["delta_h"] = np.clip(
        np.asarray(params.hue_knots, dtype=np.float64),
        -math.radians(18.0), math.radians(18.0),
    )
    base_residuals = np.asarray(
        template_model.get("rbf_residuals"), dtype=np.float64
    )
    if base_residuals.size:
        model["rbf_residuals"] = (
            base_residuals
            * float(np.clip(params.residual_strength, 0.0, 1.0))
        )
    model["max_delta_l"] = 5.0
    model["joint_optimized"] = True
    return model


def _strictly_spaced_knots(values: np.ndarray, minimum_gap: float = 4.0) -> np.ndarray:
    x = np.sort(np.asarray(values, dtype=np.float64).reshape(-1))
    if x.size == 0:
        return x
    x = np.clip(x, 4.0, 98.0)
    for i in range(1, x.size):
        x[i] = max(x[i], x[i - 1] + float(minimum_gap))
    if x[-1] > 98.0:
        shift = x[-1] - 98.0
        x -= shift
        for i in range(x.size - 2, -1, -1):
            x[i] = min(x[i], x[i + 1] - float(minimum_gap))
    return np.clip(x, 2.0, 99.0)


def _initial_joint_params(
    fit_rows: List[Dict[str, Any]],
    wb_used: bool,
    wb_raw: Dict[str, Any],
    tone_used: bool,
    tone_diag: Dict[str, Any],
    skin_model: Dict[str, Any],
    skin_strength: float,
) -> Tuple[JointMatchParams, np.ndarray]:
    gains = wb_raw.get("gains") or {"r": 1.0, "g": 1.0, "b": 1.0}
    wb_log_r = math.log(max(1e-6, float(gains.get("r", 1.0)))) if wb_used else 0.0
    wb_log_b = math.log(max(1e-6, float(gains.get("b", 1.0)))) if wb_used else 0.0

    target_rgb = np.asarray([
        [float(row["target"][key]) for key in ("r", "g", "b")]
        for row in fit_rows
    ], dtype=np.float64)
    l_values = _lab_array_from_rgb(target_rgb)[:, 0]
    knot_positions = _strictly_spaced_knots(np.percentile(
        l_values, [5.0, 27.5, 50.0, 72.5, 95.0]
    ))

    old_l = np.asarray(skin_model["l_nodes"], dtype=np.float64)
    strength = float(np.clip(float(skin_strength), 0.0, 1.5))
    l_knots = np.interp(knot_positions, old_l, np.asarray(skin_model["delta_l"], dtype=np.float64)) * strength
    logc_knots = np.interp(knot_positions, old_l, np.asarray(skin_model.get("log_chroma_gain", np.zeros_like(old_l)), dtype=np.float64)) * strength
    hue_knots = np.interp(knot_positions, old_l, np.asarray(skin_model.get("delta_h", np.zeros_like(old_l)), dtype=np.float64)) * strength

    return JointMatchParams(
        wb_log_r=float(wb_log_r),
        wb_log_b=float(wb_log_b),
        tone_shadow=float(tone_diag.get("shadow_offset", 0.0)) if tone_used else 0.0,
        tone_mid=float(tone_diag.get("mid_offset", 0.0)) if tone_used else 0.0,
        tone_high=float(tone_diag.get("high_offset", 0.0)) if tone_used else 0.0,
        l_knots=np.clip(l_knots, -5.0, 5.0),
        logc_knots=np.clip(logc_knots, math.log(0.50), math.log(2.00)),
        hue_knots=np.clip(hue_knots, -math.radians(18.0), math.radians(18.0)),
        residual_strength=float(np.clip(strength, 0.0, 1.0)),
    ), knot_positions


def _joint_rgb_values(
    rows: List[Dict[str, Any]],
    params: JointMatchParams,
    template_model: Dict[str, Any],
    knot_positions: np.ndarray,
    protection_bias: float,
) -> np.ndarray:
    rgb = np.asarray([
        [float(row["target"][key]) for key in ("r", "g", "b")]
        for row in rows
    ], dtype=np.float64)
    wb_curves = _joint_params_to_wb_curves(params, protection_bias)
    rgb = _apply_curve_set_array(rgb, wb_curves)
    tone_curve = _joint_params_to_tone_curve(params)
    rgb = _apply_curve_set_array(rgb, _smooth_tone_curves(tone_curve))
    model = _joint_params_to_skin_model(params, template_model, knot_positions)
    labs = _lab_array_from_rgb(rgb)
    corrected_lab = labs + _smooth_skin_delta_lab_array(labs, model)
    return _rgb_array_from_lab(corrected_lab)


def _joint_error_arrays(
    rows: List[Dict[str, Any]],
    rgb: np.ndarray,
) -> Tuple[np.ndarray, np.ndarray]:
    reference_lab = np.asarray([
        _reference_lab_from_anchor(row["reference"])
        for row in rows
    ], dtype=np.float64)
    weights = np.asarray([
        max(1e-4, float(row.get("weight", 1.0)))
        for row in rows
    ], dtype=np.float64)
    errors = _delta_e_2000_array(_lab_array_from_rgb(rgb), reference_lab)
    return errors, weights


def _joint_zone_means(
    rows: List[Dict[str, Any]],
    errors: np.ndarray,
    weights: np.ndarray,
) -> Dict[str, float]:
    result: Dict[str, float] = {}
    zones = [str(row.get("zone") or "") for row in rows]
    for zone in sorted(set(zones)):
        if not zone:
            continue
        mask = np.asarray([value == zone for value in zones], dtype=bool)
        if not np.any(mask):
            continue
        ww = weights[mask]
        result[zone] = float(np.sum(errors[mask] * ww) / max(1e-9, float(np.sum(ww))))
    return result


def _joint_regularization(
    params: JointMatchParams,
    protection_bias: float,
) -> float:
    dl = np.asarray(params.l_knots, dtype=np.float64)
    dc = np.asarray(params.logc_knots, dtype=np.float64)
    dh = np.asarray(params.hue_knots, dtype=np.float64)
    smooth_l = float(np.sum(np.diff(dl, n=2) ** 2)) if dl.size >= 3 else 0.0
    smooth_c = float(np.sum(np.diff(dc, n=2) ** 2)) if dc.size >= 3 else 0.0
    smooth_h = float(np.sum(np.diff(dh, n=2) ** 2)) if dh.size >= 3 else 0.0

    wb_cap = max(1e-6, _joint_wb_cap(protection_bias))
    normalized = np.concatenate([
        np.asarray([params.wb_log_r / wb_cap, params.wb_log_b / wb_cap], dtype=np.float64),
        np.asarray([
            params.tone_shadow / TONE_SHADOW_HARD_LIMIT,
            params.tone_mid / TONE_MID_LIMIT,
            params.tone_high / TONE_HIGH_HARD_LIMIT,
        ], dtype=np.float64),
        dl / 5.0,
        dc / max(1e-9, math.log(2.0)),
        dh / math.radians(18.0),
        np.asarray([params.residual_strength], dtype=np.float64),
    ])
    parameter_energy = float(np.mean(normalized ** 2))
    return float(
        0.015 * smooth_l
        + 0.30 * smooth_c
        + 0.30 * smooth_h
        + 0.002 * parameter_energy
    )


def _joint_parameter_specs(
    params: JointMatchParams,
    protection_bias: float,
    lightness_balance: float = 0.0,
) -> List[Tuple[str, Optional[int], float, float, float]]:
    """Return Accuracy-scaled coordinate-descent ranges.

    v0.15.0/0.15.1 reduced only the number of optimizer scales for small
    Accuracy values, but every parameter still retained its full hard bounds.
    Repeated coordinate-descent rounds could therefore drive -10 almost as far
    as -100.  Here both the step and the reachable interval grow continuously
    from the current (Auto-derived) state to the full Accuracy bounds.
    """
    t = float(_accuracy_profile_mix(protection_bias))
    wb_cap = _joint_wb_cap(protection_bias)
    specs: List[Tuple[str, Optional[int], float, float, float]] = []

    def add(
        name: str,
        index: Optional[int],
        base_step: float,
        hard_lower: float,
        hard_upper: float,
    ) -> None:
        current = _get_joint_parameter(params, name, index)
        lower = float(current + t * (float(hard_lower) - current))
        upper = float(current + t * (float(hard_upper) - current))
        step = float(base_step) * t
        specs.append((name, index, step, lower, upper))

    add("wb_log_r", None, 0.020, -wb_cap, wb_cap)
    add("wb_log_b", None, 0.020, -wb_cap, wb_cap)

    # Shadows/Highlights is an explicit user preference and must not disappear
    # when Accuracy later revisits Tone.  Near Auto the joint optimizer retains
    # its normal Tone freedom; toward either slider endpoint that freedom is
    # reduced smoothly around the already bias-aware Tone solution.  At +/-100
    # Tone is held fixed while Accuracy may still optimize WB and Skin Match.
    tone_bias = abs(_normalized_percent_bias(lightness_balance))
    tone_lock = tone_bias * tone_bias * (3.0 - 2.0 * tone_bias)
    tone_freedom = 1.0 - tone_lock

    def add_tone(
        name: str,
        base_step: float,
        hard_lower: float,
        hard_upper: float,
    ) -> None:
        current = _get_joint_parameter(params, name, None)
        lower = float(current + t * tone_freedom * (float(hard_lower) - current))
        upper = float(current + t * tone_freedom * (float(hard_upper) - current))
        step = float(base_step) * t * tone_freedom
        specs.append((name, None, step, lower, upper))

    add_tone("tone_shadow", 0.80, -TONE_SHADOW_HARD_LIMIT, TONE_SHADOW_HARD_LIMIT)
    add_tone("tone_mid", 1.20, -TONE_MID_LIMIT, TONE_MID_LIMIT)
    add_tone("tone_high", 2.00, -TONE_HIGH_HARD_LIMIT, TONE_HIGH_HARD_LIMIT)
    for i in range(len(params.l_knots)):
        add("l_knots", i, 0.60, -5.0, 5.0)
    for i in range(len(params.logc_knots)):
        add("logc_knots", i, 0.035, math.log(0.50), math.log(2.00))
    for i in range(len(params.hue_knots)):
        add("hue_knots", i, math.radians(1.2), -math.radians(18.0), math.radians(18.0))
    add("residual_strength", None, 0.10, 0.0, 1.0)
    return specs

def _set_joint_parameter(
    params: JointMatchParams,
    name: str,
    index: Optional[int],
    value: float,
) -> None:
    if index is None:
        setattr(params, name, float(value))
    else:
        array = np.asarray(getattr(params, name), dtype=np.float64).copy()
        array[int(index)] = float(value)
        setattr(params, name, array)


def _get_joint_parameter(
    params: JointMatchParams,
    name: str,
    index: Optional[int],
) -> float:
    value = getattr(params, name)
    if index is None:
        return float(value)
    return float(np.asarray(value, dtype=np.float64)[int(index)])


def _optimize_joint_accuracy(
    fit_rows: List[Dict[str, Any]],
    validation_rows: List[Dict[str, Any]],
    initial_params: JointMatchParams,
    template_model: Dict[str, Any],
    knot_positions: np.ndarray,
    protection_bias: float,
    lightness_balance: float = 0.0,
) -> Tuple[JointMatchParams, Dict[str, Any]]:
    """Deterministic low-dimensional coordinate descent for Accuracy mode."""
    accuracy_mix = _accuracy_profile_mix(protection_bias)
    if accuracy_mix <= 0.0 or not fit_rows or not validation_rows:
        return _copy_joint_params(initial_params), {"used": False, "reason": "inactive"}

    def evaluate(params: JointMatchParams) -> Dict[str, Any]:
        fit_rgb = _joint_rgb_values(
            fit_rows, params, template_model, knot_positions, protection_bias
        )
        validation_rgb = _joint_rgb_values(
            validation_rows, params, template_model, knot_positions, protection_bias
        )
        fit_errors, fit_weights = _joint_error_arrays(fit_rows, fit_rgb)
        val_errors, val_weights = _joint_error_arrays(validation_rows, validation_rgb)
        fit_de = float(np.sum(fit_errors * fit_weights) / max(1e-9, float(np.sum(fit_weights))))
        validation_de = float(np.sum(val_errors * val_weights) / max(1e-9, float(np.sum(val_weights))))
        return {
            "fit_de": fit_de,
            "validation_de": validation_de,
            "fit_errors": fit_errors,
            "fit_weights": fit_weights,
            "validation_errors": val_errors,
            "validation_weights": val_weights,
            "zone_means": _joint_zone_means(validation_rows, val_errors, val_weights),
            "regularization": _joint_regularization(params, protection_bias),
        }

    params = _copy_joint_params(initial_params)
    initial = evaluate(params)
    baseline_val_errors = np.asarray(initial["validation_errors"], dtype=np.float64)
    baseline_val_weights = np.asarray(initial["validation_weights"], dtype=np.float64)
    baseline_zones = dict(initial["zone_means"])
    val_tolerance = _lerp(0.025, 0.24, accuracy_mix)
    cheek_tolerance = _lerp(0.08, 0.45, accuracy_mix)
    min_nonworse = _lerp(0.66, 0.40, accuracy_mix)

    def valid(candidate: Dict[str, Any]) -> bool:
        if float(candidate["validation_de"]) > float(initial["validation_de"]) + val_tolerance:
            return False
        errors = np.asarray(candidate["validation_errors"], dtype=np.float64)
        total = max(1e-9, float(np.sum(baseline_val_weights)))
        nonworse = float(np.sum(
            baseline_val_weights[errors <= baseline_val_errors + 0.12]
        ) / total)
        if nonworse < min_nonworse:
            return False
        zones = candidate["zone_means"]
        for zone in ("left_cheek", "right_cheek"):
            if zone in baseline_zones and zone in zones:
                if float(zones[zone]) > float(baseline_zones[zone]) + cheek_tolerance:
                    return False
        return True

    best = dict(initial)
    best["loss"] = float(best["fit_de"] + best["regularization"])
    specs = _joint_parameter_specs(
        params,
        protection_bias,
        lightness_balance,
    )
    scales_all = (1.0, 0.5, 0.25, 0.125)
    # Keep the optimizer topology identical at every non-zero Accuracy value.
    # v0.15.2 already scaled the reachable parameter interval and coordinate
    # step continuously by accuracy_mix, but changing the number of scales and
    # rounds at fixed thresholds still introduced small algorithmic jumps in
    # the middle of the slider.  Auto does not enter this optimizer at all;
    # once Accuracy is active, early-exit logic below keeps weak settings cheap.
    scale_count = len(scales_all)
    max_rounds = 4
    scales = scales_all
    evaluations = 1
    accepted = 0

    for scale in scales:
        for _round in range(max_rounds):
            round_start_fit = float(best["fit_de"])
            changed = False
            for name, index, base_step, lower, upper in specs:
                current_value = _get_joint_parameter(params, name, index)
                local_best_params = None
                local_best_eval = None
                for sign in (-1.0, 1.0):
                    candidate_params = _copy_joint_params(params)
                    candidate_value = float(np.clip(
                        current_value + sign * base_step * float(scale), lower, upper
                    ))
                    if abs(candidate_value - current_value) <= 1e-12:
                        continue
                    _set_joint_parameter(candidate_params, name, index, candidate_value)
                    candidate = evaluate(candidate_params)
                    evaluations += 1
                    if not valid(candidate):
                        continue
                    candidate_loss = float(candidate["fit_de"] + candidate["regularization"])
                    candidate["loss"] = candidate_loss
                    fit_better = float(candidate["fit_de"]) < float(best["fit_de"]) - 1e-7
                    loss_better = candidate_loss < float(best["loss"]) - 1e-9
                    tie_better = (
                        abs(float(candidate["fit_de"]) - float(best["fit_de"])) <= 1e-7
                        and candidate_loss < float(best["loss"]) - 1e-9
                        and float(candidate["validation_de"]) <= float(best["validation_de"]) + 1e-7
                    )
                    # The design loss is fit ΔE + smoothness/energy regularization.
                    # v0.15.0/0.15.1 accidentally used regularization only as a
                    # tie-breaker, so a tiny ΔE gain could justify a very large
                    # parameter excursion.  Require the actual regularized loss
                    # to improve as intended by the v0.15 design.
                    if not ((fit_better and loss_better) or tie_better):
                        continue
                    if local_best_eval is None or (
                        float(candidate_loss),
                        float(candidate["fit_de"]),
                        float(candidate["validation_de"]),
                    ) < (
                        float(local_best_eval["loss"]),
                        float(local_best_eval["fit_de"]),
                        float(local_best_eval["validation_de"]),
                    ):
                        local_best_params = candidate_params
                        local_best_eval = candidate
                if local_best_params is not None and local_best_eval is not None:
                    params = local_best_params
                    best = local_best_eval
                    accepted += 1
                    changed = True
            if not changed or round_start_fit - float(best["fit_de"]) < 1e-4:
                break

    return params, {
        "used": bool(float(best["fit_de"]) < float(initial["fit_de"]) - 1e-6),
        "fit_before": float(initial["fit_de"]),
        "fit_after": float(best["fit_de"]),
        "validation_before": float(initial["validation_de"]),
        "validation_after": float(best["validation_de"]),
        "evaluations": int(evaluations),
        "accepted_steps": int(accepted),
        "scales": int(scale_count),
        "rounds_per_scale": int(max_rounds),
        "parameter_freedom": float(accuracy_mix),
        "knot_positions": [float(v) for v in knot_positions],
    }


def _compile_joint_candidate(
    fit_rows: List[Dict[str, Any]],
    validation_rows: List[Dict[str, Any]],
    collateral_raw: np.ndarray,
    params: JointMatchParams,
    template_model: Dict[str, Any],
    knot_positions: np.ndarray,
    protection_bias: float,
    minimum_gain: float,
) -> Optional[Dict[str, Any]]:
    """Compile and validate the actual 9-point curves + 33^3 LUT."""
    wb_curves = _joint_params_to_wb_curves(params, protection_bias)
    tone_curve = _joint_params_to_tone_curve(params)
    tone_curves = _smooth_tone_curves(tone_curve)

    wb_pixels = _apply_curve_set_array(collateral_raw, wb_curves)
    if not _global_stage_pixel_safety(collateral_raw, wb_pixels, protection_bias)["safe"]:
        return None
    tone_pixels = _apply_curve_set_array(wb_pixels, tone_curves)
    if not _global_stage_pixel_safety(wb_pixels, tone_pixels, protection_bias)["safe"]:
        return None

    fit_global = _rows_after_tone_curve(_rows_after_curve_set(fit_rows, wb_curves), tone_curve)
    validation_global = _rows_after_tone_curve(_rows_after_curve_set(validation_rows, wb_curves), tone_curve)
    collateral_prepared = _prepare_collateral_pixels(
        collateral_raw,
        tone_curve if not _curve_is_identity(tone_curve) else None,
        wb_curves if not _curve_set_is_identity(wb_curves) else None,
    )
    if collateral_prepared.shape[0] > 1400:
        step = int(math.ceil(collateral_prepared.shape[0] / 1400.0))
        collateral_prepared = collateral_prepared[::step][:1400]
    collateral_before_lab = (
        _lab_array_from_rgb(collateral_prepared)
        if collateral_prepared.shape[0]
        else np.empty((0, 3), dtype=np.float64)
    )

    # Backtrack the skin part rather than clipping individual LUT nodes.
    for factor in [1.0 - 0.05 * i for i in range(20)]:
        candidate_params = _copy_joint_params(params)
        candidate_params.l_knots *= factor
        candidate_params.logc_knots *= factor
        candidate_params.hue_knots *= factor
        candidate_params.residual_strength *= factor
        model = _joint_params_to_skin_model(candidate_params, template_model, knot_positions)
        lut = _build_smooth_skin_lut(model, 1.0, 33)
        geometry = _lut_geometry_stats(lut, 1.0)
        if not _lut_geometry_is_safe(geometry, protection_bias):
            continue
        fit_after = _rows_after_lut(fit_global, lut, 1.0)
        validation_after = _rows_after_lut(validation_global, lut, 1.0)
        fit_stats = _stage_stats(fit_global, fit_after)
        validation_safe, validation_stats = _validation_stage_is_safe(
            validation_global, validation_after, protection_bias, "skin"
        )
        collateral = _lut_collateral_stats(
            collateral_prepared, lut, 1.0, before_lab=collateral_before_lab
        )
        if _collateral_is_catastrophic(collateral, False, protection_bias):
            continue
        if not validation_safe:
            continue
        if float(fit_stats["gain"]) + 1e-9 < max(0.0, float(minimum_gain)):
            continue
        return {
            "params": _copy_joint_params(candidate_params),
            "wb_curves": None if _curve_set_is_identity(wb_curves) else wb_curves,
            "tone_curve": None if _curve_is_identity(tone_curve) else tone_curve,
            "tone_curves": None if _curve_is_identity(tone_curve) else tone_curves,
            "fit_global": fit_global,
            "validation_global": validation_global,
            "fit_rows": fit_after,
            "validation_rows": validation_after,
            "skin_model": model,
            "lut": lut,
            "geometry": geometry,
            "collateral": collateral,
            "collateral_prepared": collateral_prepared,
            "collateral_before_lab": collateral_before_lab,
            "fit_stats": fit_stats,
            "validation_stats": validation_stats,
            "skin_backtrack": float(factor),
        }

    # A joint candidate may improve WB/Tone enough that a Skin LUT is not
    # measurably useful. Keep the global result instead of discarding the whole
    # joint search merely because the skin component correctly backs to zero.
    global_validation_safe, global_validation_stats = _validation_stage_is_safe(
        validation_rows, validation_global, protection_bias, "tone"
    )
    if global_validation_safe:
        zero_params = _copy_joint_params(params)
        zero_params.l_knots *= 0.0
        zero_params.logc_knots *= 0.0
        zero_params.hue_knots *= 0.0
        zero_params.residual_strength = 0.0
        return {
            "params": _copy_joint_params(params),
            "wb_curves": None if _curve_set_is_identity(wb_curves) else wb_curves,
            "tone_curve": None if _curve_is_identity(tone_curve) else tone_curve,
            "tone_curves": None if _curve_is_identity(tone_curve) else tone_curves,
            "fit_global": fit_global,
            "validation_global": validation_global,
            "fit_rows": fit_global,
            "validation_rows": validation_global,
            "skin_model": _joint_params_to_skin_model(
                zero_params, template_model, knot_positions
            ),
            "lut": None,
            "geometry": _identity_geometry_stats(),
            "collateral": {
                "count": 0.0, "affected_fraction": 0.0, "mean": 0.0,
                "p95": 0.0, "p99": 0.0, "max": 0.0,
            },
            "collateral_prepared": collateral_prepared,
            "collateral_before_lab": collateral_before_lab,
            "fit_stats": _stage_stats(fit_global, fit_global),
            "validation_stats": global_validation_stats,
            "skin_backtrack": 0.0,
        }
    return None


def _choose_smooth_skin_strength_validated(
    fit_rows: List[Dict[str, Any]],
    validation_rows: List[Dict[str, Any]],
    lut: Dict[str, Any],
    minimum_gain: float,
    collateral_pixels: np.ndarray,
    collateral_before_lab: np.ndarray,
    protection_bias: float,
) -> Tuple[float, Dict[str, Any]]:
    protection = _protection_profile(protection_bias, minimum_gain)
    baseline = _rows_delta_e_identity(fit_rows)
    validation_baseline = _rows_delta_e_identity(validation_rows)
    max_strength = float(np.clip(protection["max_skin_strength"], 0.60, 1.50))
    candidates: List[Dict[str, Any]] = []
    for strength in _strength_grid(max_strength, 0.05):
        fit_after = _rows_after_lut(fit_rows, lut, strength)
        validation_after = _rows_after_lut(validation_rows, lut, strength)
        stats = _stage_stats(fit_rows, fit_after)
        validation_safe, validation_stats = _validation_stage_is_safe(
            validation_rows, validation_after, protection_bias, "skin"
        )
        collateral = _lut_collateral_stats(
            collateral_pixels, lut, strength, before_lab=collateral_before_lab
        )
        geometry = _lut_geometry_stats(lut, strength)
        valid = bool(
            stats["gain"] + 1e-9 >= max(0.0, float(minimum_gain))
            and stats["nonworse_fraction"] >= protection["skin_nonworse"]
            and stats["p75_worsening"] <= protection["skin_p75"]
            and validation_safe
            and not _collateral_is_catastrophic(collateral, False, protection_bias)
            and _lut_geometry_is_safe(geometry, protection_bias)
        )
        validation_penalty = max(
            0.0, float(validation_stats["after"]) - validation_baseline
        )
        score = float(
            stats["after"]
            + 0.12 * _chroma_stage_stats(fit_rows, fit_after)["after"]
            + 0.10 * validation_penalty
            + protection["score_collateral_weight"] * _collateral_penalty(collateral, False)
            + (1.0 - 0.85 * protection["accuracy_mix"]) * _lut_geometry_penalty(geometry)
        )
        candidates.append({
            "strength": float(strength),
            "fit_rows": fit_after,
            "validation_rows": validation_after,
            "stats": stats,
            "validation_stats": validation_stats,
            "collateral": collateral,
            "geometry": geometry,
            "valid": valid,
            "score": score,
        })

    valid = [item for item in candidates if item["valid"]]
    if not valid:
        return 0.0, {
            "baseline": baseline,
            "validation_baseline": validation_baseline,
            "full_after": baseline,
            "full_gain": 0.0,
            "validation_after": validation_baseline,
            "validation_gain": 0.0,
            "nonworse_fraction": 1.0,
        }

    best = min(valid, key=lambda item: item["score"])
    best_gain = max(float(item["stats"]["gain"]) for item in valid)
    score_span = max(float(item["score"]) for item in valid) - float(best["score"])
    extra = (
        (1.0 - protection["accuracy_mix"]) * protection["near_best_score_extra"]
        + protection["accuracy_mix"] * (score_span + 1e-9)
    )
    near_best = [
        item for item in valid
        if float(item["stats"]["gain"]) >= best_gain * protection["near_best_gain_ratio"]
        and float(item["score"]) <= float(best["score"]) + extra
    ]
    conservative = min(
        near_best or [best],
        key=lambda item: (float(item["strength"]), float(item["score"])),
    )
    if protection["bias"] < -1e-9:
        # Do not switch to the maximum-accuracy selection rule merely because
        # the slider crossed below zero.  Interpolate the desired LUT strength
        # from the conservative Auto-like candidate to the best-DeltaE Accuracy
        # candidate.  This makes -10 genuinely close to Auto and reserves the
        # strongest valid correction for values near -100.
        aggressive = min(
            near_best or valid,
            key=lambda item: (
                float(item["stats"]["after"]),
                float(item["validation_stats"]["after"]),
                -float(item["strength"]),
            ),
        )
        target_strength = _lerp(
            float(conservative["strength"]),
            float(aggressive["strength"]),
            float(protection["accuracy_mix"]),
        )
        chosen = min(
            near_best or valid,
            key=lambda item: (
                abs(float(item["strength"]) - target_strength),
                float(item["score"]),
                float(item["strength"]),
            ),
        )
    else:
        chosen = conservative

    return float(chosen["strength"]), {
        "baseline": baseline,
        "validation_baseline": validation_baseline,
        "full_after": float(chosen["stats"]["after"]),
        "full_gain": float(chosen["stats"]["gain"]),
        "validation_after": float(chosen["validation_stats"]["after"]),
        "validation_gain": validation_baseline - float(chosen["validation_stats"]["after"]),
        "nonworse_fraction": float(chosen["stats"]["nonworse_fraction"]),
        "collateral": chosen["collateral"],
        "geometry": chosen["geometry"],
        "fit_rows": chosen["fit_rows"],
        "validation_rows": chosen["validation_rows"],
    }


def fit_smooth_match(
    fit_rows: List[Dict[str, Any]],
    validation_rows: List[Dict[str, Any]],
    legacy_zone_rows: List[Dict[str, Any]],
    target_model: Dict[str, Any],
    correspondence_mode: str = "pooled-skin-manifold",
    minimum_gain: float = 0.1,
    full_rgb: Optional[np.ndarray] = None,
    lightness_balance: float = 0.0,
    protection_bias: float = 0.0,
) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    """v0.15 pipeline: pooled fit -> spatial validation -> Accuracy joint fit."""
    minimum_gain = float(np.clip(float(minimum_gain), 0.0, 2.0))
    lightness_balance = float(np.clip(float(lightness_balance), -100.0, 100.0))
    protection_bias = float(np.clip(float(protection_bias), -100.0, 100.0))
    protection = _protection_profile(protection_bias, minimum_gain)
    accuracy_mix = float(protection["accuracy_mix"])
    # Accuracy starts from one stable Auto baseline.  Previously WB/Tone/Skin
    # were already refitted with progressively relaxed Accuracy rules before
    # the joint optimizer, so different slider positions did not share the same
    # starting point.  Safety still affects the baseline on the positive side.
    baseline_protection_bias = max(0.0, protection_bias)
    skin_minimum_gain = float(
        minimum_gain
        if accuracy_mix <= 0.0
        else max(
            MINIMUM_MEASURABLE_SKIN_GAIN,
            minimum_gain * (1.0 - accuracy_mix),
        )
    )

    before_original = float(_rows_delta_e_identity(fit_rows))
    validation_before = float(_rows_delta_e_identity(validation_rows))
    legacy_before = float(_rows_delta_e_identity(legacy_zone_rows))
    collateral_raw = _sample_collateral_pixels(
        full_rgb,
        (target_model.get("face") or {}).get("bbox"),
    )

    # --------------------------------------------------------
    # 1) White Balance: fit pooled target, validate spatial zones.
    # --------------------------------------------------------
    wb_raw = _fit_relative_white_balance(fit_rows, baseline_protection_bias)
    wb_candidate_curves = _white_balance_curves(wb_raw)
    wb_candidate_fit = _rows_after_curve_set(fit_rows, wb_candidate_curves)
    wb_candidate_validation = _rows_after_curve_set(validation_rows, wb_candidate_curves)
    wb_fit_safe, wb_fit_stats = _wb_stage_is_safe(
        fit_rows, wb_candidate_fit, minimum_gain, baseline_protection_bias
    )
    wb_validation_safe, wb_validation_stats = _validation_stage_is_safe(
        validation_rows, wb_candidate_validation, baseline_protection_bias, "wb"
    )
    wb_collateral_pixels = _apply_curve_set_array(collateral_raw, wb_candidate_curves)
    wb_pixel_safety = _global_stage_pixel_safety(
        collateral_raw, wb_collateral_pixels, baseline_protection_bias
    )
    wb_used = bool(
        wb_raw.get("enabled")
        and wb_fit_safe
        and wb_validation_safe
        and wb_pixel_safety["safe"]
    )
    if wb_used:
        wb_curves = wb_candidate_curves
        wb_fit_rows = wb_candidate_fit
        wb_validation_rows = wb_candidate_validation
        after_wb = float(wb_fit_stats["after"])
    else:
        wb_curves = None
        wb_fit_rows = [dict(row) for row in fit_rows]
        wb_validation_rows = [dict(row) for row in validation_rows]
        wb_collateral_pixels = collateral_raw.copy()
        after_wb = before_original
        wb_fit_stats = _stage_stats(fit_rows, wb_fit_rows)
        wb_validation_stats = _stage_stats(validation_rows, wb_validation_rows)

    # --------------------------------------------------------
    # 2) Tone: still conservative alone; joint Accuracy can revisit it.
    # --------------------------------------------------------
    tone_curve: Optional[List[List[int]]] = None
    tone_curves: Optional[Dict[str, List[List[int]]]] = None
    tone_fit_rows = [dict(row) for row in wb_fit_rows]
    tone_validation_rows = [dict(row) for row in wb_validation_rows]
    tone_diag: Dict[str, Any] = {
        "used": False,
        "lightness_before": 0.0,
        "lightness_after": 0.0,
        "lightness_gain": 0.0,
        "strength": 0.0,
        "shadow_offset": 0.0,
        "mid_offset": 0.0,
        "high_offset": 0.0,
    }
    candidate_tone_curve, candidate_tone_diag = _optimize_lightness_tone(
        wb_fit_rows, minimum_gain, lightness_balance
    )
    if candidate_tone_diag.get("used"):
        candidate_fit = _rows_after_tone_curve(wb_fit_rows, candidate_tone_curve)
        candidate_validation = _rows_after_tone_curve(
            wb_validation_rows, candidate_tone_curve
        )
        validation_safe, _candidate_validation_stats = _validation_stage_is_safe(
            wb_validation_rows, candidate_validation, baseline_protection_bias, "tone"
        )
        candidate_tone_curves = _smooth_tone_curves(candidate_tone_curve)
        candidate_pixels = _apply_curve_set_array(
            wb_collateral_pixels, candidate_tone_curves
        )
        pixel_safe = _global_stage_pixel_safety(
            wb_collateral_pixels, candidate_pixels, baseline_protection_bias
        )["safe"]
        if validation_safe and pixel_safe:
            tone_curve = candidate_tone_curve
            tone_curves = candidate_tone_curves
            tone_fit_rows = candidate_fit
            tone_validation_rows = candidate_validation
            tone_diag = candidate_tone_diag
    tone_stats = _stage_stats(wb_fit_rows, tone_fit_rows)
    after_tone = float(_rows_delta_e_identity(tone_fit_rows))

    # --------------------------------------------------------
    # 3) Primary smooth Skin model, selected on fit + zone validation.
    # --------------------------------------------------------
    collateral_prepared = _prepare_collateral_pixels(
        collateral_raw,
        tone_curve if tone_curves else None,
        wb_curves if wb_used else None,
    )
    if collateral_prepared.shape[0] > 1400:
        step = int(math.ceil(collateral_prepared.shape[0] / 1400.0))
        collateral_prepared = collateral_prepared[::step][:1400]
    collateral_before_lab = (
        _lab_array_from_rgb(collateral_prepared)
        if collateral_prepared.shape[0]
        else np.empty((0, 3), dtype=np.float64)
    )

    orthogonalize_skin_lightness = bool(tone_curves)
    skin_model = _fit_smooth_skin_model(
        tone_fit_rows,
        orthogonalize_lightness=orthogonalize_skin_lightness,
    )
    primary_skin_strength = 0.0
    primary_lut: Optional[Dict[str, Any]] = None
    primary_fit_rows = [dict(row) for row in tone_fit_rows]
    primary_validation_rows = [dict(row) for row in tone_validation_rows]
    primary_geometry = _identity_geometry_stats()
    primary_collateral = {
        "count": 0.0, "affected_fraction": 0.0, "mean": 0.0,
        "p95": 0.0, "p99": 0.0, "max": 0.0,
    }
    skin_diag: Dict[str, Any] = {
        "baseline": after_tone,
        "validation_baseline": _rows_delta_e_identity(tone_validation_rows),
        "full_after": after_tone,
        "full_gain": 0.0,
        "validation_after": _rows_delta_e_identity(tone_validation_rows),
        "validation_gain": 0.0,
        "nonworse_fraction": 1.0,
    }

    if skin_model is not None:
        base_lut = _build_smooth_skin_lut(skin_model, 1.0, 33)
        primary_skin_strength, skin_diag = _choose_smooth_skin_strength_validated(
            tone_fit_rows,
            tone_validation_rows,
            base_lut,
            minimum_gain,
            collateral_prepared,
            collateral_before_lab,
            baseline_protection_bias,
        )
        if primary_skin_strength > 0.0:
            primary_lut = _compose_skin_and_refinement_lut(
                base_lut, primary_skin_strength
            )
            primary_fit_rows = _rows_after_lut(tone_fit_rows, primary_lut, 1.0)
            primary_validation_rows = _rows_after_lut(
                tone_validation_rows, primary_lut, 1.0
            )
            primary_geometry = _lut_geometry_stats(primary_lut, 1.0)
            primary_collateral = _lut_collateral_stats(
                collateral_prepared,
                primary_lut,
                1.0,
                before_lab=collateral_before_lab,
            )

    # --------------------------------------------------------
    # 4) Accuracy-only joint WB/Tone/Skin optimization.
    # --------------------------------------------------------
    joint_diag: Dict[str, Any] = {"used": False, "reason": "inactive"}
    joint_compiled = False
    joint_backtrack = 1.0
    if (
        protection_bias < -1e-9
        and correspondence_mode == "pooled-skin-manifold"
        and skin_model is not None
    ):
        initial_params, knot_positions = _initial_joint_params(
            tone_fit_rows,
            wb_used,
            wb_raw,
            bool(tone_curves),
            tone_diag,
            skin_model,
            primary_skin_strength,
        )
        endpoint_params, endpoint_diag = _optimize_joint_accuracy(
            fit_rows,
            validation_rows,
            initial_params,
            skin_model,
            knot_positions,
            -100.0,
            lightness_balance,
        )
        joint_diag = dict(endpoint_diag)
        joint_diag["endpoint_accuracy"] = -100.0
        joint_diag["endpoint_fit_after"] = float(endpoint_diag.get("fit_after", 0.0))
        joint_diag["requested_accuracy_mix"] = float(accuracy_mix)
        joint_diag["parameter_freedom"] = float(accuracy_mix)
        optimized_params = _blend_joint_params(
            initial_params, endpoint_params, accuracy_mix
        )
        if endpoint_diag.get("used"):
            compiled = _compile_joint_candidate(
                fit_rows,
                validation_rows,
                collateral_raw,
                optimized_params,
                skin_model,
                knot_positions,
                protection_bias,
                skin_minimum_gain,
            )
            if compiled is not None:
                compiled_fit_de = float(_rows_delta_e_identity(compiled["fit_rows"]))
                primary_fit_de = float(_rows_delta_e_identity(primary_fit_rows))
                overall_validation_safe, _overall_validation_stats = _validation_stage_is_safe(
                    validation_rows,
                    compiled["validation_rows"],
                    protection_bias,
                    "skin",
                )
                if (
                    overall_validation_safe
                    and compiled_fit_de < primary_fit_de - 1e-4
                ):
                    joint_compiled = True
                    wb_curves = compiled["wb_curves"]
                    wb_used = bool(wb_curves)
                    tone_curve = compiled["tone_curve"]
                    tone_curves = compiled["tone_curves"]
                    tone_fit_rows = compiled["fit_global"]
                    tone_validation_rows = compiled["validation_global"]
                    primary_fit_rows = compiled["fit_rows"]
                    primary_validation_rows = compiled["validation_rows"]
                    primary_lut = compiled["lut"]
                    skin_model = compiled["skin_model"]
                    primary_geometry = compiled["geometry"]
                    primary_collateral = compiled["collateral"]
                    collateral_prepared = compiled["collateral_prepared"]
                    collateral_before_lab = compiled["collateral_before_lab"]
                    joint_backtrack = float(compiled["skin_backtrack"])
                    primary_skin_strength = joint_backtrack
                    after_wb = float(_rows_delta_e_identity(
                        _rows_after_curve_set(fit_rows, wb_curves)
                        if wb_curves else fit_rows
                    ))
                    after_tone = float(_rows_delta_e_identity(tone_fit_rows))
                    wb_actual_fit_rows = (
                        _rows_after_curve_set(fit_rows, wb_curves)
                        if wb_curves else [dict(row) for row in fit_rows]
                    )
                    wb_actual_validation_rows = (
                        _rows_after_curve_set(validation_rows, wb_curves)
                        if wb_curves else [dict(row) for row in validation_rows]
                    )
                    wb_validation_stats = _stage_stats(
                        validation_rows,
                        wb_actual_validation_rows,
                    )
                    tone_stats = _stage_stats(
                        wb_actual_fit_rows,
                        tone_fit_rows,
                    )
                    if tone_curves:
                        tone_light = _lightness_stage_stats(
                            wb_actual_fit_rows,
                            tone_fit_rows,
                            lightness_balance,
                        )
                        actual_joint_params = compiled.get("params")
                        tone_diag = {
                            "used": True,
                            "lightness_before": float(tone_light["before"]),
                            "lightness_after": float(tone_light["after"]),
                            "lightness_gain": float(tone_light["gain"]),
                            "strength": 1.0,
                            "shadow_offset": float(actual_joint_params.tone_shadow)
                                if actual_joint_params is not None else 0.0,
                            "mid_offset": float(actual_joint_params.tone_mid)
                                if actual_joint_params is not None else 0.0,
                            "high_offset": float(actual_joint_params.tone_high)
                                if actual_joint_params is not None else 0.0,
                        }
                    else:
                        tone_diag = {
                            "used": False,
                            "lightness_before": 0.0,
                            "lightness_after": 0.0,
                            "lightness_gain": 0.0,
                            "strength": 0.0,
                            "shadow_offset": 0.0,
                            "mid_offset": 0.0,
                            "high_offset": 0.0,
                        }
                    skin_diag.update({
                        "baseline": after_tone,
                        "full_after": compiled_fit_de,
                        "full_gain": after_tone - compiled_fit_de,
                        "validation_after": _rows_delta_e_identity(primary_validation_rows),
                        "validation_gain": (
                            _rows_delta_e_identity(tone_validation_rows)
                            - _rows_delta_e_identity(primary_validation_rows)
                        ),
                        "nonworse_fraction": _stage_stats(
                            tone_fit_rows, primary_fit_rows
                        )["nonworse_fraction"],
                    })
        joint_diag["compiled"] = bool(joint_compiled)
        joint_diag["skin_backtrack"] = float(joint_backtrack)

    # --------------------------------------------------------
    # 5) Controlled residual refinement. L* is Accuracy-only.
    # --------------------------------------------------------
    final_skin_lut = primary_lut
    final_fit_rows = [dict(row) for row in primary_fit_rows]
    final_validation_rows = [dict(row) for row in primary_validation_rows]
    final_geometry = primary_geometry
    final_collateral = primary_collateral
    refinement_used = False
    refinement_strength = 0.0
    refinement_gain = 0.0
    refinement_validation_gain = 0.0
    refinement_l_stats = {
        "p95_abs_delta_l": 0.0,
        "max_abs_delta_l": 0.0,
        "p99_lightness_curvature": 0.0,
    }

    if primary_lut is not None:
        primary_outputs = np.asarray(primary_lut["outputs"], dtype=np.float64)
        baseline_fit_de = float(_rows_delta_e_identity(primary_fit_rows))
        baseline_validation_de = float(_rows_delta_e_identity(primary_validation_rows))
        chosen_score = baseline_fit_de
        max_strength = float(np.clip(
            protection["max_refinement_strength"], 0.40, 1.00
        ))

        # Never lose the proven Auto chroma-only refinement when Accuracy is
        # enabled.  The requested Accuracy refinement (which may include L*)
        # competes against the Auto variant and replaces it only when the
        # actually compiled LUT scores better and passes every safety gate.
        refinement_mixes = [0.0]
        if accuracy_mix > 1e-12:
            refinement_mixes.append(float(accuracy_mix))

        for refinement_mix in refinement_mixes:
            refinement = _build_residual_refinement_lut(
                primary_fit_rows, 17, refinement_mix
            )
            if refinement is None:
                continue
            refined_full = _apply_lut_array(primary_outputs, refinement, 1.0)
            for strength in _strength_grid(max_strength, 0.05):
                outputs = primary_outputs + float(strength) * (
                    refined_full - primary_outputs
                )
                candidate_lut = {
                    "size": int(primary_lut["size"]),
                    "nodes": np.asarray(primary_lut["nodes"], dtype=np.float64),
                    "outputs": np.clip(outputs, 0.0, 255.0),
                }
                candidate_fit = _rows_after_lut(tone_fit_rows, candidate_lut, 1.0)
                candidate_validation = _rows_after_lut(
                    tone_validation_rows, candidate_lut, 1.0
                )
                candidate_de = float(_rows_delta_e_identity(candidate_fit))
                incremental_gain = baseline_fit_de - candidate_de
                validation_safe, _validation_stats = _validation_stage_is_safe(
                    primary_validation_rows,
                    candidate_validation,
                    protection_bias,
                    "refinement",
                )
                geometry = _lut_geometry_stats(candidate_lut, 1.0)
                if not _lut_geometry_is_safe(geometry, protection_bias):
                    continue
                collateral = _lut_collateral_stats(
                    collateral_prepared,
                    candidate_lut,
                    1.0,
                    before_lab=collateral_before_lab,
                )
                if _collateral_is_catastrophic(
                    collateral, True, protection_bias
                ):
                    continue
                fit_stats = _stage_stats(tone_fit_rows, candidate_fit)
                if fit_stats["nonworse_fraction"] < protection["fine_nonworse"]:
                    continue
                if fit_stats["p75_worsening"] > protection["fine_p75"]:
                    continue
                if incremental_gain + 1e-9 < protection["fine_min_gain"]:
                    continue
                if not validation_safe:
                    continue
                l_stats = _refinement_lightness_stats(
                    primary_outputs,
                    np.asarray(candidate_lut["outputs"], dtype=np.float64),
                    int(candidate_lut["size"]),
                )
                if not _refinement_lightness_is_safe(
                    l_stats, refinement_mix
                ):
                    continue
                validation_de = float(_rows_delta_e_identity(candidate_validation))
                score = float(
                    candidate_de
                    + 0.08 * max(0.0, validation_de - baseline_validation_de)
                    + protection["score_collateral_weight"]
                        * _collateral_penalty(collateral, True)
                    + (1.0 - 0.85 * accuracy_mix)
                        * _lut_geometry_penalty(geometry)
                )
                if score < chosen_score - 1e-6:
                    chosen_score = score
                    final_skin_lut = candidate_lut
                    final_fit_rows = candidate_fit
                    final_validation_rows = candidate_validation
                    final_geometry = geometry
                    final_collateral = collateral
                    refinement_used = True
                    refinement_strength = float(strength)
                    refinement_gain = float(incremental_gain)
                    refinement_validation_gain = baseline_validation_de - validation_de
                    refinement_l_stats = l_stats

    # --------------------------------------------------------
    # 6) Final validation on the actually compiled 33^3 LUT, then export.
    # --------------------------------------------------------
    skin_lut_info = None
    if final_skin_lut is not None:
        final_fit_stats = _stage_stats(tone_fit_rows, final_fit_rows)
        final_validation_safe, _final_validation_stats = _validation_stage_is_safe(
            validation_rows, final_validation_rows, protection_bias, "skin"
        )
        final_safe = bool(
            final_fit_stats["gain"] + 1e-9 >= skin_minimum_gain
            and final_fit_stats["nonworse_fraction"] >= protection["final_nonworse"]
            and final_fit_stats["p75_worsening"] <= protection["final_p75"]
            and final_validation_safe
            and not _collateral_is_catastrophic(
                final_collateral, False, protection_bias
            )
            and _lut_geometry_is_safe(final_geometry, protection_bias)
        )
        if final_safe:
            skin_path = _write_cube(final_skin_lut, 1.0)
            skin_profile = _write_device_link_profile(final_skin_lut, 1.0)
            skin_lut_info = {
                "path": str(skin_path),
                "profile_path": str(skin_profile),
                "profile_grid": int(final_skin_lut["size"]),
                "strength": 1.0,
                "delta_e_before": round(float(after_tone), 3),
                "delta_e_after": round(float(_rows_delta_e_identity(final_fit_rows)), 3),
            }
        else:
            final_skin_lut = None
            final_fit_rows = [dict(row) for row in tone_fit_rows]
            final_validation_rows = [dict(row) for row in tone_validation_rows]
            final_geometry = _identity_geometry_stats()
            final_collateral = {
                "count": 0.0, "affected_fraction": 0.0, "mean": 0.0,
                "p95": 0.0, "p99": 0.0, "max": 0.0,
            }
            refinement_used = False
            refinement_strength = 0.0
            refinement_gain = 0.0
            refinement_validation_gain = 0.0
            refinement_l_stats = {
                "p95_abs_delta_l": 0.0,
                "max_abs_delta_l": 0.0,
                "p99_lightness_curvature": 0.0,
            }

    final_de = float(_rows_delta_e_identity(final_fit_rows))
    validation_after = float(_rows_delta_e_identity(final_validation_rows))
